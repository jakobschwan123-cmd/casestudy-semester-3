@startuml
title sqd : UC10 Lieferantenbestellung auslösen (ausgelöst durch UC12 Nachbestellvorschlag oder Fehlteile)
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
participant ": Lagerbestand" as LB
actor Disponent
participant ": Ersatzteil" as ET
participant ": Lieferantenbestellung" as LBEST
participant ": Bestellposition" as BPOS
participant ": Reparaturauftrag" as RA
actor Werkstattleiter
actor Lieferant

ref over LB, Disponent : UC12 Nachbestellvorschlag erzeugen\n(bucheAbgang, istMeldebestandUnterschritten)
alt Bestellbedarf (Nachbestellvorschlag oder Fehlteil)
    LB -> LBEST : <<create>> (status = VORSCHLAG)
    LB -> Disponent : Bestellbedarf (Ersatzteil, Menge)
    activate Disponent
    Disponent -> ET : getVorzugslieferant()
    activate ET
    ET --> Disponent : lieferant
    deactivate ET
    alt offene Bestellung beim Lieferanten vorhanden
        note over LBEST : Vorschlag wird in die offene\nBestellung übernommen
        Disponent -> LBEST : addPosition(teil, menge)
        activate LBEST
        LBEST -> BPOS : <<create>>
        LBEST --> Disponent : Position ergänzt
        deactivate LBEST
    else keine offene Bestellung
        Disponent -> Disponent : loeseBestellungAus(lieferant)
        activate LBEST
        Disponent -> LBEST : addPosition(teil, menge)
        LBEST -> BPOS : <<create>>
        LBEST -> LBEST : berechneBestellwert()
        LBEST --> Disponent : bestellwert
        opt Bestellwert über Freigabegrenze
            Disponent -> Werkstattleiter : Freigabe anfordern
            Werkstattleiter -> LBEST : freigeben()
        end
        Disponent -> LBEST : uebermittle()
        LBEST -> Lieferant : Bestellung senden
        Lieferant --> LBEST : Auftragsbestätigung (Liefertermin)
        LBEST --> Disponent : Status BESTAETIGT, liefertermin
        deactivate LBEST
        opt Fehlteil eines Reparaturauftrags
            Disponent -> RA : wechsleStatus(TEILE_BESTELLT)
            note right of RA : Status: Teile bestellt
        end
    end
    deactivate Disponent
else kein Bestellbedarf
    note over LB : keine Aktion
end
@enduml
