@startuml
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam usecaseFontSize 11
skinparam actorStyle awesome
skinparam nodesep 12
skinparam ranksep 60
title ud : RepairFlow – Use-Case-Diagramm

actor "Kunde" as Kunde
actor "Techniker" as Techniker
actor "Servicemitarbeiter" as Servicemitarbeiter
actor "Disponent" as Disponent
actor "Werkstattleiter" as Werkstattleiter
actor "Werkstattinhaber" as Werkstattinhaber

rectangle "RepairFlow" {
  rectangle "Kundenportal (App)" {
    usecase "Sofortdiagnose anfordern" as UC01
    usecase "Voranmeldung bestätigen" as UC02
    usecase "KVA freigeben / ablehnen" as UC07
  }
  rectangle "Auftrag und Werkstatt" {
    usecase "Reparaturauftrag anlegen" as UC03
    usecase "Werkstatttermin planen und Techniker zuweisen" as UC17
    usecase "Diagnosevorschlag prüfen" as UC04
    usecase "Diagnosebefund erfassen" as UC05
    usecase "KVA erstellen" as UC06
    usecase "Reparaturschritt und Arbeitszeit erfassen" as UC13
    usecase "Auftrag fertigmelden und Kunde benachrichtigen" as UC14
    usecase "Rechnung erstellen und Zahlung erfassen" as UC15
    usecase "Reklamation bearbeiten" as UC16
  }
  rectangle "Ersatzteil-Disposition" {
    usecase "Ersatzteil-Verfügbarkeit prüfen" as UC08
    usecase "Ersatzteil reservieren" as UC09
    usecase "Lieferantenbestellung auslösen" as UC10
    usecase "Wareneingang buchen" as UC11
    usecase "Nachbestellvorschlag erzeugen" as UC12
    usecase "Retoure abwickeln" as UC19
  }
  rectangle "Administration" {
    usecase "Werkstattbetrieb und Filialen verwalten" as UC18
  }
}

actor "Lieferant" as Lieferant <<extern>>
actor "KI-Diagnosedienst" as KIDienst <<extern>>

Kunde -- UC01
Kunde -- UC02
Kunde -- UC03
Kunde -- UC07
Kunde -- UC14
Kunde -- UC15
Kunde -- UC16
Techniker -- UC04
Techniker -- UC05
Techniker -- UC06
Techniker -- UC13
Techniker -- UC14
Techniker -- UC16
Servicemitarbeiter -- UC03
Servicemitarbeiter -- UC07
Servicemitarbeiter -- UC15
Servicemitarbeiter -- UC16
Disponent -- UC08
Disponent -- UC09
Disponent -- UC10
Disponent -- UC11
Disponent -- UC12
Disponent -- UC19
Werkstattleiter -- UC10
Werkstattleiter -- UC16
Werkstattleiter -- UC17
Werkstattinhaber -- UC18
UC10 -- Lieferant
UC11 -- Lieferant
UC19 -- Lieferant
UC01 -- KIDienst

UC01 ..> UC08 : <<include>>
UC09 ..> UC08 : <<include>>
UC16 ..> UC03 : <<include>>
UC02 ..> UC01 : <<extend>>
UC04 ..> UC05 : <<extend>>
UC10 ..> UC09 : <<extend>>
UC12 ..> UC09 : <<extend>>
UC19 ..> UC11 : <<extend>>
@enduml
