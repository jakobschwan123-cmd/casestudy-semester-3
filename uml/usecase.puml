@startuml
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam usecaseFontSize 11
skinparam actorStyle awesome
skinparam nodesep 12
skinparam ranksep 60
title ud : RepairFlow – Use-Case-Diagramm

actor "Kunde" as Kunde
actor "Techniker" as Techniker
actor "Servicemitarbeiter" as Servicemitarbeiter
actor "Disponent" as Disponent
actor "Werkstattleiter" as Werkstattleiter
actor "Werkstattinhaber" as Werkstattinhaber

rectangle "RepairFlow" {
  rectangle "Kundenportal (App)" {
    usecase "UC01\nSofortdiagnose anfordern" as UC01
    usecase "UC02\nVoranmeldung bestätigen" as UC02
    usecase "UC07\nKVA freigeben / ablehnen" as UC07
  }
  rectangle "Auftrag und Werkstatt" {
    usecase "UC03\nReparaturauftrag anlegen" as UC03
    usecase "UC17\nWerkstatttermin planen und Techniker zuweisen" as UC17
    usecase "UC04\nDiagnosevorschlag prüfen" as UC04
    usecase "UC05\nDiagnosebefund erfassen" as UC05
    usecase "UC06\nKVA erstellen" as UC06
    usecase "UC13\nReparaturschritt und Arbeitszeit erfassen" as UC13
    usecase "UC14\nAuftrag fertigmelden" as UC14
    usecase "UC15\nAbholung und Abrechnung abwickeln" as UC15
    usecase "UC16\nReklamation bearbeiten" as UC16
  }
  rectangle "Ersatzteil-Disposition" {
    usecase "UC08\nErsatzteil-Verfügbarkeit prüfen" as UC08
    usecase "UC09\nErsatzteile disponieren und reservieren" as UC09
    usecase "UC10\nLieferantenbestellung auslösen" as UC10
    usecase "UC11\nWareneingang buchen" as UC11
    usecase "UC12\nNachbestellvorschlag erzeugen" as UC12
    usecase "UC19\nRetoure abwickeln" as UC19
  }
  rectangle "Administration" {
    usecase "UC18\nWerkstattbetrieb und Filialen verwalten" as UC18
  }
}

actor "Lieferant" as Lieferant <<extern>>
actor "KI-Diagnosedienst" as KIDienst <<extern>>

Kunde -right- UC01
Kunde -right- UC02
Kunde -right- UC03
Kunde -right- UC07
Kunde -right- UC09
Kunde -right- UC10
Kunde -right- UC15
Kunde -right- UC16
Techniker -right- UC03
Techniker -right- UC04
Techniker -right- UC05
Techniker -right- UC06
Techniker -right- UC13
Techniker -right- UC14
Techniker -right- UC16
Techniker -right- UC19
Servicemitarbeiter -right- UC03
Servicemitarbeiter -right- UC06
Servicemitarbeiter -right- UC07
Servicemitarbeiter -right- UC09
Servicemitarbeiter -right- UC10
Servicemitarbeiter -right- UC15
Servicemitarbeiter -right- UC16
Disponent -right- UC08
Disponent -right- UC09
Disponent -right- UC10
Disponent -right- UC11
Disponent -right- UC12
Disponent -right- UC19
Werkstattleiter -right- UC10
Werkstattleiter -right- UC16
Werkstattleiter -right- UC17
Werkstattleiter -right- UC19
Werkstattinhaber -right- UC18
UC10 -right- Lieferant
UC11 -right- Lieferant
UC19 -right- Lieferant
UC01 -right- KIDienst
Kunde -[hidden]down- Servicemitarbeiter
Servicemitarbeiter -[hidden]down- Techniker
Techniker -[hidden]down- Disponent
Disponent -[hidden]down- Werkstattleiter
Werkstattleiter -[hidden]down- Werkstattinhaber
KIDienst -[hidden]down- Lieferant

UC01 ..> UC08 : <<include>>
UC09 ..> UC08 : <<include>>
UC02 ..> UC01 : <<extend>>\n[Kunde bestätigt Voranmeldung]
UC10 ..> UC09 : <<extend>>\n[Fehlteile vorhanden]
UC12 ..> UC09 : <<extend>>\n[Meldebestand unterschritten]
UC03 ..> UC16 : <<extend>>\n[Nacharbeit freigegeben oder Angebot angenommen]
UC19 ..> UC11 : <<extend>>\n[Lieferung mangelhaft]
UC19 ..> UC16 : <<extend>>\n[Lieferantenteil defekt]
@enduml
