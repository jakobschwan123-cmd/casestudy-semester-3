@startuml
title sqd : UC07 KVA freigeben / ablehnen (mit Erinnerungsschleife, max. drei Erinnerungen)
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
actor Techniker
actor Servicemitarbeiter as SM
participant ": Reparaturauftrag" as RA
participant ": Kostenvoranschlag" as KVA
participant ": KvaPosition" as POS
actor Kunde

Techniker -> KVA : <<create>>
activate KVA
loop je Arbeits- oder Ersatzteilposition
    Techniker -> KVA : addPosition(p)
    KVA -> POS : <<create>>
    KVA -> POS : zwischensumme()
    POS --> KVA : betrag
end
KVA -> KVA : berechneSumme()
KVA --> Techniker : summe
deactivate KVA

Techniker -> SM : KVA zur Prüfung
SM -> RA : wechsleStatus(KVA_OFFEN)
note right of RA : Status: KVA offen
SM -> KVA : versendeAnKunde()
activate KVA
KVA -> Kunde : Kostenvoranschlag
loop solange keine Reaktion, höchstens dreimal (Erinnerung alle 3 Tage)
    KVA -> Kunde : Erinnerung
end
alt Kunde gibt frei
    Kunde -> KVA : freigeben()
    KVA -> KVA : setzeStatus(FREIGEGEBEN)
    KVA -> RA : wechsleStatus(FREIGEGEBEN)
    note right of RA : Status: freigegeben\n-> Ersatzteil-Disposition (UC08/UC09)
    KVA --> Kunde : Freigabe bestätigt
else Kunde lehnt ab oder reagiert nicht
    Kunde -> KVA : ablehnen(grund)
    KVA -> KVA : setzeStatus(ABGELEHNT)
    KVA -> RA : wechsleStatus(ABGELEHNT)
    note right of RA : Status: abgelehnt\n-> Abholung mit Diagnosepauschale (UC15)
end
deactivate KVA
@enduml
