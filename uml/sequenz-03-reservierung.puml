@startuml
title sqd : UC09 Ersatzteil reservieren (filialübergreifend)
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
actor Disponent
participant ": Reparaturauftrag" as RA
participant ": Kostenvoranschlag" as KVA
participant "eigen : Lagerbestand" as LB
participant "andere : Lagerbestand" as AL
participant ": ErsatzteilReservierung" as RES

Disponent -> KVA : getPositionen()
activate KVA
KVA --> Disponent : List<KvaPosition>
deactivate KVA

loop je benötigtes Ersatzteil
    Disponent -> LB : pruefeVerfuegbarkeit(anzahl)
    activate LB
    LB --> Disponent : verfuegbar
    deactivate LB
    alt eigener Bestand ausreichend
        create RES
        Disponent -> RES : <<create>> reserviere()
        activate RES
        RES -> LB : reserviere(anzahl)
        RES --> Disponent : Status RESERVIERT
        deactivate RES
    else eigener Bestand nicht ausreichend
        loop je andere Filiale, bis Bedarf gedeckt
            Disponent -> AL : pruefeVerfuegbarkeit(anzahl)
            activate AL
            AL --> Disponent : verfuegbar
            deactivate AL
        end
        alt in anderer Filiale verfügbar
            Disponent -> RES : <<create>> reserviere()
            activate RES
            RES -> AL : reserviere(anzahl)
            RES --> Disponent : Status RESERVIERT (Umlagerung angefordert)
            deactivate RES
        else nirgends verfügbar
            ref over Disponent, RA : UC10 Lieferantenbestellung auslösen
        end
    end
    Disponent -> LB : istMeldebestandUnterschritten()
    activate LB
    LB --> Disponent : true / false
    deactivate LB
    opt Meldebestand unterschritten
        ref over Disponent, LB : UC12 Nachbestellvorschlag bei Meldebestand
    end
end
note right of RA : Status bleibt freigegeben; bei Fehlteilen\nsetzt UC10 den Status Teile bestellt
@enduml
