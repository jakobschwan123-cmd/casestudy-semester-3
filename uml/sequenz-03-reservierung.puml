@startuml
' BPMN: p05-ersatzteilreservierung.bpmn
' BPMN-Nodes: T05_Teileliste Sub_05 S05_Eigen GW05_Eigen S05_Reservieren S05_Andere GW05_Andere S05_Umlagerung S05_Fehlteil T05_Bestaetigen T05_Meldebestand GW05_Meldebestand T05_Nachbestellung T05_Beginn T05_Info GW05_Bedarf T05_Bestellen
title sqd : UC09 Ersatzteile disponieren und reservieren (BPMN 05)
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 160
hide footbox

actor Disponent
participant ": Reparaturauftrag" as RA
participant ": Kostenvoranschlag" as KVA
participant "eigen : Lagerbestand" as LB
participant "andere : Lagerbestand" as AL
participant ": ErsatzteilReservierung" as RES
actor Techniker
actor Kunde

Disponent -> KVA : getPositionen()
KVA --> Disponent : List<KvaPosition>
par je benötigtem Ersatzteil (parallele Mehrfachinstanz Sub_05)
    Disponent -> LB : pruefeVerfuegbarkeit(anzahl)
    LB --> Disponent : verfuegbar
    alt eigener Bestand ausreichend
        Disponent -> RES : <<create>> reserviere()
        RES -> LB : reserviere(anzahl)
    else eigener Bestand nicht ausreichend
        loop je anderer Filiale bis Bestand gefunden
            Disponent -> AL : pruefeVerfuegbarkeit(anzahl)
            AL --> Disponent : verfuegbar
        end
        alt in anderer Filiale verfügbar
            note over Disponent, AL : Umlagerung anfordern (S05_Umlagerung)
            Disponent -> RES : <<create>> reserviere()
            RES -> AL : reserviere(anzahl)
        else nirgends verfügbar
            Disponent -> RA : markiereFehlteil(teil, menge)
            note right of RA : Noch keine Bestellung innerhalb der Teileprüfung
        end
    end
end
Disponent -> RA : bestaetigeReservierungen()
loop je betroffenem Lagerbestand nach Abschluss der Teileprüfung
    Disponent -> LB : istMeldebestandUnterschritten()
    LB --> Disponent : true / false
    opt Meldebestand unterschritten (UC12)
        Disponent -> LB : erzeugeNachbestellvorschlag()
        LB --> Disponent : Lieferantenbestellung [Vorschlag]
    end
end
Techniker -> RA : ermittleReparaturbeginn()
RA --> Techniker : voraussichtlicher Reparaturbeginn
Techniker -> RA : benachrichtigeKunde("voraussichtlicher Reparaturbeginn")
RA -> Kunde : voraussichtlicher Reparaturbeginn
opt Fehlteile vorhanden oder Nachbestellvorschlag erzeugt
    ref over Disponent, RA : BPMN 06 / UC10 Lieferantenbestellung auslösen\nErst nach der Kundeninformation (T05_Info -> GW05_Bedarf)
end
note over Disponent, RA : Reservierung verändert nur den reservierten Bestand.\nStatus TEILE_BESTELLT erst nach bestätigter Bestellung in BPMN 06.
@enduml
