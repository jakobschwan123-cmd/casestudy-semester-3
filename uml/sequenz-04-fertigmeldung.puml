@startuml
title sqd : UC14 Auftrag fertigmelden und Kunde benachrichtigen
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
actor Techniker
participant ": Reparaturschritt" as RS
participant ": Arbeitszeitbuchung" as AZB
participant ": Reparaturauftrag" as RA
actor Kunde

Techniker -> RS : schliesseAb()
activate RS
RS -> AZB : <<create>> (dauerMinuten, stundensatz)
activate AZB
AZB -> AZB : berechneKosten()
AZB --> RS : kosten
deactivate AZB
RS --> Techniker : Schritt abgeschlossen
deactivate RS

Techniker -> RA : fertigmelden()
activate RA
RA -> RA : alleSchritteAbgeschlossen()
alt alle Schritte abgeschlossen und Endkontrolle bestanden
    RA -> RA : wechsleStatus(FERTIG)
    note right of RA : Status: in Reparatur -> fertig\nRechnung entsteht in UC15
    RA -> RA : benachrichtigeKunde("Gerät abholbereit")
    RA -> Kunde : Nachricht "Gerät abholbereit"\n(über den hinterlegten Kanal: E-Mail / SMS / App)
    RA --> Techniker : fertiggemeldet
else noch offene Schritte oder Nacharbeit nach Endkontrolle
    RA --> Techniker : offene Schritte (Anzahl)
    note right of RA : Status bleibt: in Reparatur
end
deactivate RA
@enduml
