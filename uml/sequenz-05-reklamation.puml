@startuml
title sqd : UC16 Reklamation bearbeiten (Gewährleistungsentscheidung)
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
actor Kunde
actor Techniker
participant ": Reklamation" as REK
participant "ursprung : Reparaturauftrag" as RA
participant ": Rechnung" as RE
participant "nacharbeit : Reparaturauftrag" as NA
participant "neuauftrag : Reparaturauftrag" as NEU

Kunde -> Techniker : Mangel melden (Auftrag, Beschreibung)
create REK
Techniker -> REK : <<create>>
activate REK
REK -> RA : getRechnung()
activate RA
RA --> REK : rechnung
deactivate RA
REK -> RE : getRechnungsdatum()
activate RE
RE --> REK : rechnungsdatum
deactivate RE
REK -> REK : pruefeGewaehrleistung()

alt innerhalb Gewährleistung
    create NA
    REK -> NA : <<create>> (kostenfrei)
    activate NA
    NA -> NA : wechsleStatus(ANGENOMMEN)
    note right of NA : neuer Zyklus, kostenfrei
    NA -> NA : benachrichtigeKunde("kostenfreie Nacharbeit")
    NA -> Kunde : Nachricht "kostenfreie Nacharbeit"
    NA --> REK : Nacharbeit angelegt
    deactivate NA
else außerhalb Gewährleistung
    REK -> Kunde : Angebot kostenpflichtige Nacharbeit
    Kunde --> REK : Entscheidung
    alt Kunde nimmt Angebot an
        create NEU
        REK -> NEU : <<create>> (kostenpflichtig)
        activate NEU
        NEU -> NEU : wechsleStatus(ANGENOMMEN)
        note right of NEU : Nacharbeit zum angenommenen Angebot
        NEU --> REK : Nacharbeit angelegt
        deactivate NEU
    else Kunde lehnt ab
        REK -> REK : schliesseAb()
    end
end
REK --> Techniker : Reklamation bearbeitet
deactivate REK
@enduml
