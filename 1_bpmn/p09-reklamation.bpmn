<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_09" targetNamespace="http://repairflow.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_09">
    <bpmn:documentation>Meldet der Kunde nach der Abholung einen Mangel, wird die Reklamation dem Ursprungsauftrag zugeordnet, der Mangel geprüft und der Gewährleistungsfall bewertet. Je nach Ergebnis folgt kostenfreie Nacharbeit (Freigabe durch die Werkstattleitung) oder ein kostenpflichtiges Angebot. Die Nacharbeit wird als neuer Reparaturauftrag angelegt und über Prozess 07 durchgeführt; die Rückgabe des Geräts läuft in jedem Fall über Prozess 08.</bpmn:documentation>
    <bpmn:participant id="Part_09_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_09" />
    <bpmn:participant id="Part_09_Kunde" name="Kunde" processRef="Proc_09_Kunde" />
    <bpmn:messageFlow id="MsgFlow_09_1" name="Mangelmeldung" sourceRef="K09_Melden" targetRef="Start_09" />
    <bpmn:messageFlow id="MsgFlow_09_2" name="Gerät" sourceRef="K09_Abgeben" targetRef="T09_Annehmen" />
    <bpmn:messageFlow id="MsgFlow_09_3" name="Angebot" sourceRef="T09_Angebot" targetRef="K09_Angebot" />
    <bpmn:messageFlow id="MsgFlow_09_4" name="Annahme / Ablehnung" sourceRef="K09_Entscheiden" targetRef="E09_Entscheidung" />
    <bpmn:messageFlow id="MsgFlow_09_6" name="Absage" sourceRef="T09_Absage" targetRef="K09_Absage" />
    <bpmn:messageFlow id="MsgFlow_09_5" name="Info: Nacharbeit (kostenfrei / zum Angebot)" sourceRef="T09_Info" targetRef="K09_Info" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_09" name="09 Reklamation und Gewährleistung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_09">
      <bpmn:lane id="Lane_09_1" name="Techniker">
        <bpmn:flowNodeRef>T09_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Bewerten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Gewaehr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_09a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Auftrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Reparatur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Teil</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_09_2" name="Service / Annahme">
        <bpmn:flowNodeRef>T09_Absage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_09b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Abholung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_09c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Teile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Teile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Zuordnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Angebot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Warten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E09_Entscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E09_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Angebot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Abgelehnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Abschluss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Annehmen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_09_4" name="Ersatzteil-Disposition">
        <bpmn:flowNodeRef>T09_Retoure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_09_3" name="Werkstattleitung">
        <bpmn:flowNodeRef>T09_Freigeben</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_09" name="Mangel gemeldet">
      <bpmn:outgoing>Flow_09_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_09_def" messageRef="Msg_09_1" />
    </bpmn:startEvent>
    <bpmn:userTask id="T09_Erfassen" name="Reklamation erfassen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t09_erfassen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_14</bpmn:incoming>
      <bpmn:outgoing>Flow_09_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T09_Erfassen_out_DataObjRef_09_1">
        <bpmn:targetRef>DataObjRef_09_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="T09_Zuordnen" name="Ursprungsauftrag und Rechnung zuordnen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t09_zuordnen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_15</bpmn:incoming>
      <bpmn:outgoing>Flow_09_16</bpmn:outgoing>
      <bpmn:property id="T09_Zuordnen_prop_DataObjRef_09_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T09_Zuordnen_in_DataObjRef_09_2">
        <bpmn:sourceRef>DataObjRef_09_2</bpmn:sourceRef>
        <bpmn:targetRef>T09_Zuordnen_prop_DataObjRef_09_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="T09_Pruefen" name="Mangel prüfen">
      <bpmn:incoming>Flow_09_17</bpmn:incoming>
      <bpmn:outgoing>Flow_09_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:businessRuleTask id="T09_Bewerten" name="Gewährleistungsfall bewerten">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.gewaehrleistung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_18</bpmn:incoming>
      <bpmn:outgoing>Flow_09_19</bpmn:outgoing>
      <bpmn:property id="T09_Bewerten_prop_DataObjRef_09_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T09_Bewerten_in_DataObjRef_09_3">
        <bpmn:sourceRef>DataObjRef_09_3</bpmn:sourceRef>
        <bpmn:targetRef>T09_Bewerten_prop_DataObjRef_09_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW09_Gewaehr" name="Gewährleistung?">
      <bpmn:incoming>Flow_09_19</bpmn:incoming>
      <bpmn:outgoing>Flow_09_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T09_Freigeben" name="Kostenfreie Nacharbeit freigeben">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t09_freigeben" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_20</bpmn:incoming>
      <bpmn:outgoing>Flow_09_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T09_Angebot" name="Kostenpflichtiges Angebot senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t09_angebot" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_21</bpmn:incoming>
      <bpmn:outgoing>Flow_09_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="GW09_Warten" name="">
      <bpmn:incoming>Flow_09_22</bpmn:incoming>
      <bpmn:outgoing>Flow_09_43</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_44</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E09_Entscheidung" name="Kundenentscheidung erhalten">
      <bpmn:incoming>Flow_09_43</bpmn:incoming>
      <bpmn:outgoing>Flow_09_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E09_Entscheidung_def" messageRef="Msg_09_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E09_Timer" name="3 Tage verstrichen">
      <bpmn:incoming>Flow_09_44</bpmn:incoming>
      <bpmn:outgoing>Flow_09_40</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E09_Timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW09_Angebot" name="Angebot angenommen?">
      <bpmn:incoming>Flow_09_23</bpmn:incoming>
      <bpmn:outgoing>Flow_09_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T09_Abgelehnt" name="Reklamation als abgelehnt markieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t09_abgelehnt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_42</bpmn:incoming>
      <bpmn:outgoing>Flow_09_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T09_Absage" name="Kunde über Ablehnung informieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t09_absage" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_34</bpmn:incoming>
      <bpmn:outgoing>Flow_09_46</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Merge_09c" name="">
      <bpmn:incoming>Flow_09_25</bpmn:incoming>
      <bpmn:incoming>Flow_09_40</bpmn:incoming>
      <bpmn:incoming>Flow_09_41</bpmn:incoming>
      <bpmn:outgoing>Flow_09_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_09a" name="">
      <bpmn:incoming>Flow_09_24</bpmn:incoming>
      <bpmn:incoming>Flow_09_26</bpmn:incoming>
      <bpmn:outgoing>Flow_09_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T09_Auftrag" name="Nacharbeitsauftrag anlegen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t09_auftrag" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_27</bpmn:incoming>
      <bpmn:outgoing>Flow_09_28</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T09_Auftrag_out_DataObjRef_09_4">
        <bpmn:targetRef>DataObjRef_09_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T09_Info" name="Kunde über Nacharbeit informieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t09_info" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_39</bpmn:incoming>
      <bpmn:outgoing>Flow_09_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:callActivity id="T09_Teile" name="05 Ersatzteile disponieren">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_05" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:output source="=teileVollstaendig != false" target="teileVollstaendig" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_28</bpmn:incoming>
      <bpmn:outgoing>Flow_09_38</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GW09_Teile" name="Alle Teile beschaffbar?">
      <bpmn:incoming>Flow_09_38</bpmn:incoming>
      <bpmn:outgoing>Flow_09_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="T09_Reparatur" name="07 Reparatur durchführen">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_07" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:output source="=lieferantenteilDefekt = true" target="lieferantenteilDefekt" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_29</bpmn:incoming>
      <bpmn:outgoing>Flow_09_30</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GW09_Teil" name="Lieferantenteil defekt?">
      <bpmn:incoming>Flow_09_30</bpmn:incoming>
      <bpmn:outgoing>Flow_09_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="T09_Retoure" name="10 Retoure abwickeln">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_10" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_31</bpmn:incoming>
      <bpmn:outgoing>Flow_09_33</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Join_09b" name="">
      <bpmn:incoming>Flow_09_46</bpmn:incoming>
      <bpmn:incoming>Flow_09_32</bpmn:incoming>
      <bpmn:incoming>Flow_09_33</bpmn:incoming>
      <bpmn:outgoing>Flow_09_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="T09_Abholung" name="08 Abholung abwickeln">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_08" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_35</bpmn:incoming>
      <bpmn:outgoing>Flow_09_36</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="T09_Abschluss" name="Reklamation abschließen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t09_abschluss" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_36</bpmn:incoming>
      <bpmn:outgoing>Flow_09_37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T09_Abschluss_out_DataStore_09_1">
        <bpmn:targetRef>DataStore_09_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_09" name="Reklamation abgeschlossen">
      <bpmn:incoming>Flow_09_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_09_14" sourceRef="Start_09" targetRef="T09_Erfassen" />
    <bpmn:sequenceFlow id="Flow_09_15" sourceRef="T09_Erfassen" targetRef="T09_Zuordnen" />
    <bpmn:sequenceFlow id="Flow_09_16" sourceRef="T09_Zuordnen" targetRef="T09_Annehmen" />
    <bpmn:sequenceFlow id="Flow_09_17" sourceRef="T09_Annehmen" targetRef="T09_Pruefen" />
    <bpmn:sequenceFlow id="Flow_09_18" sourceRef="T09_Pruefen" targetRef="T09_Bewerten" />
    <bpmn:sequenceFlow id="Flow_09_19" sourceRef="T09_Bewerten" targetRef="GW09_Gewaehr" />
    <bpmn:sequenceFlow id="Flow_09_20" name="ja" sourceRef="GW09_Gewaehr" targetRef="T09_Freigeben">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=gewaehrleistung</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_21" name="nein" sourceRef="GW09_Gewaehr" targetRef="T09_Angebot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(gewaehrleistung)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_22" sourceRef="T09_Angebot" targetRef="GW09_Warten" />
    <bpmn:sequenceFlow id="Flow_09_23" sourceRef="E09_Entscheidung" targetRef="GW09_Angebot" />
    <bpmn:sequenceFlow id="Flow_09_24" name="ja" sourceRef="GW09_Angebot" targetRef="Join_09a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=angebotAngenommen</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_25" name="nein" sourceRef="GW09_Angebot" targetRef="Merge_09c">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(angebotAngenommen)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_26" sourceRef="T09_Freigeben" targetRef="Join_09a" />
    <bpmn:sequenceFlow id="Flow_09_27" sourceRef="Join_09a" targetRef="T09_Auftrag" />
    <bpmn:sequenceFlow id="Flow_09_28" sourceRef="T09_Auftrag" targetRef="T09_Teile" />
    <bpmn:sequenceFlow id="Flow_09_29" sourceRef="T09_Info" targetRef="T09_Reparatur" />
    <bpmn:sequenceFlow id="Flow_09_30" sourceRef="T09_Reparatur" targetRef="GW09_Teil" />
    <bpmn:sequenceFlow id="Flow_09_31" name="ja" sourceRef="GW09_Teil" targetRef="T09_Retoure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lieferantenteilDefekt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_32" name="nein" sourceRef="GW09_Teil" targetRef="Join_09b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(lieferantenteilDefekt)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_33" sourceRef="T09_Retoure" targetRef="Join_09b" />
    <bpmn:sequenceFlow id="Flow_09_34" sourceRef="T09_Abgelehnt" targetRef="T09_Absage" />
    <bpmn:sequenceFlow id="Flow_09_35" sourceRef="Join_09b" targetRef="T09_Abholung" />
    <bpmn:sequenceFlow id="Flow_09_36" sourceRef="T09_Abholung" targetRef="T09_Abschluss" />
    <bpmn:sequenceFlow id="Flow_09_37" sourceRef="T09_Abschluss" targetRef="End_09" />
    <bpmn:sequenceFlow id="Flow_09_46" sourceRef="T09_Absage" targetRef="Join_09b" />
    <bpmn:sequenceFlow id="Flow_09_38" sourceRef="T09_Teile" targetRef="GW09_Teile" />
    <bpmn:sequenceFlow id="Flow_09_39" name="ja" sourceRef="GW09_Teile" targetRef="T09_Info">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=teileVollstaendig</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_40" sourceRef="E09_Timer" targetRef="Merge_09c" />
    <bpmn:sequenceFlow id="Flow_09_41" name="nein" sourceRef="GW09_Teile" targetRef="Merge_09c">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(teileVollstaendig)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_42" sourceRef="Merge_09c" targetRef="T09_Abgelehnt" />
    <bpmn:sequenceFlow id="Flow_09_43" sourceRef="GW09_Warten" targetRef="E09_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_09_44" sourceRef="GW09_Warten" targetRef="E09_Timer" />
    <bpmn:dataObjectReference id="DataObjRef_09_1" name="Reklamation" dataObjectRef="DataObj_09_1" />
    <bpmn:dataObject id="DataObj_09_1" />
    <bpmn:dataObjectReference id="DataObjRef_09_2" name="Reparatur-auftrag [abgeholt]" dataObjectRef="DataObj_09_2" />
    <bpmn:dataObject id="DataObj_09_2" />
    <bpmn:dataObjectReference id="DataObjRef_09_3" name="Fehlerbefund" dataObjectRef="DataObj_09_3" />
    <bpmn:dataObject id="DataObj_09_3" />
    <bpmn:dataObjectReference id="DataObjRef_09_4" name="Reparatur-auftrag [angenommen]" dataObjectRef="DataObj_09_4" />
    <bpmn:dataObject id="DataObj_09_4" />
    <bpmn:dataStoreReference id="DataStore_09_1" name="RepairFlow-Datenbank" dataStoreRef="Store_09_1" />
    <bpmn:userTask id="T09_Annehmen" name="Gerät annehmen und Mangel dokumentieren">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t09_annehmen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09_16</bpmn:incoming>
      <bpmn:outgoing>Flow_09_17</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="Proc_09_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K09_Start" name="Mangel festgestellt">
      <bpmn:outgoing>Flow_09_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="K09_Melden" name="Mangel in der App melden">
      <bpmn:incoming>Flow_09_1</bpmn:incoming>
      <bpmn:outgoing>Flow_09_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="K09_Bringen" name="Gerät in die Filiale bringen">
      <bpmn:incoming>Flow_09_2</bpmn:incoming>
      <bpmn:outgoing>Flow_09_3</bpmn:outgoing>
