      <bpmn:outgoing>Flow_02_27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_02" name="Auftrag angenommen">
      <bpmn:incoming>Flow_02_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_02_5" sourceRef="Start_02" targetRef="T02_Suchen" />
    <bpmn:sequenceFlow id="Flow_02_24" sourceRef="T02_Suchen" targetRef="GW02_Voranmeldung" />
    <bpmn:sequenceFlow id="Flow_02_6" name="ja" sourceRef="GW02_Voranmeldung" targetRef="T02_Uebernehmen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=voranmeldungVorhanden</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_7" name="nein" sourceRef="GW02_Voranmeldung" targetRef="T02_Kundendaten">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(voranmeldungVorhanden)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_8" sourceRef="T02_Uebernehmen" targetRef="Join_02a" />
    <bpmn:sequenceFlow id="Flow_02_9" sourceRef="T02_Kundendaten" targetRef="Join_02a" />
    <bpmn:sequenceFlow id="Flow_02_10" sourceRef="Join_02a" targetRef="T02_Geraet" />
    <bpmn:sequenceFlow id="Flow_02_11" sourceRef="T02_Geraet" targetRef="T02_Sicht" />
    <bpmn:sequenceFlow id="Flow_02_12" sourceRef="T02_Sicht" targetRef="T02_Symptome" />
    <bpmn:sequenceFlow id="Flow_02_13" sourceRef="T02_Symptome" targetRef="T02_Auftrag" />
    <bpmn:sequenceFlow id="Flow_02_14" sourceRef="T02_Auftrag" targetRef="T02_Beleg" />
    <bpmn:sequenceFlow id="Flow_02_22" sourceRef="T02_Beleg" targetRef="T02_Einlagern" />
    <bpmn:sequenceFlow id="Flow_02_23" sourceRef="T02_Einlagern" targetRef="T02_Auslastung" />
    <bpmn:sequenceFlow id="Flow_02_15" sourceRef="T02_Auslastung" targetRef="GW02_Kapazitaet" />
    <bpmn:sequenceFlow id="Flow_02_16" name="ja" sourceRef="GW02_Kapazitaet" targetRef="Join_02b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kapazitaetFrei</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_17" name="nein" sourceRef="GW02_Kapazitaet" targetRef="T02_Zielfiliale">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(kapazitaetFrei)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_25" sourceRef="T02_Zielfiliale" targetRef="T02_Umleiten" />
    <bpmn:sequenceFlow id="Flow_02_18" sourceRef="T02_Umleiten" targetRef="T02_Transport" />
    <bpmn:sequenceFlow id="Flow_02_26" sourceRef="T02_Transport" targetRef="Join_02b" />
    <bpmn:sequenceFlow id="Flow_02_19" sourceRef="Join_02b" targetRef="T02_Techniker" />
    <bpmn:sequenceFlow id="Flow_02_20" sourceRef="T02_Techniker" targetRef="T02_Termin" />
    <bpmn:sequenceFlow id="Flow_02_21" sourceRef="T02_Termin" targetRef="T02_TerminSenden" />
    <bpmn:sequenceFlow id="Flow_02_27" sourceRef="T02_TerminSenden" targetRef="End_02" />
    <bpmn:dataStoreReference id="DataStore_02_4" name="RepairFlow-Datenbank" dataStoreRef="Store_02_1" />
    <bpmn:dataObjectReference id="DataObjRef_02_1" name="Voranmeldung" dataObjectRef="DataObj_02_1" />
    <bpmn:dataObject id="DataObj_02_1" />
    <bpmn:dataObjectReference id="DataObjRef_02_4" name="Kunde" dataObjectRef="DataObj_02_4" />
    <bpmn:dataObject id="DataObj_02_4" />
    <bpmn:dataObjectReference id="DataObjRef_02_2" name="Gerät" dataObjectRef="DataObj_02_2" />
    <bpmn:dataObject id="DataObj_02_2" />
    <bpmn:dataObjectReference id="DataObjRef_02_3" name="Reparatur-auftrag [angenommen]" dataObjectRef="DataObj_02_3" />
    <bpmn:dataObject id="DataObj_02_3" />
    <bpmn:dataStoreReference id="DataStore_02_1" name="RepairFlow-Datenbank" dataStoreRef="Store_02_1" />
    <bpmn:dataStoreReference id="DataStore_02_2" name="Technikerplan" dataStoreRef="Store_02_2" />
    <bpmn:dataStoreReference id="DataStore_02_3" name="Technikerplan" dataStoreRef="Store_02_2" />
  </bpmn:process>
  <bpmn:process id="Proc_02_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K02_Start" name="Reparatur gewünscht">
      <bpmn:outgoing>Flow_02_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="K02_Bringen" name="Gerät in die Filiale bringen">
      <bpmn:incoming>Flow_02_1</bpmn:incoming>
      <bpmn:outgoing>Flow_02_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:receiveTask id="K02_Beleg" name="Annahmebeleg empfangen" messageRef="Msg_02_2">
      <bpmn:incoming>Flow_02_3</bpmn:incoming>
      <bpmn:outgoing>Flow_02_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="K02_Termin" name="Termin empfangen" messageRef="Msg_02_3">
      <bpmn:incoming>Flow_02_4</bpmn:incoming>
      <bpmn:outgoing>Flow_02_28</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="K02_End" name="Auftrag erteilt">
      <bpmn:incoming>Flow_02_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_02_1" sourceRef="K02_Start" targetRef="K02_Bringen" />
    <bpmn:sequenceFlow id="Flow_02_2" sourceRef="K02_Bringen" targetRef="K02_Abgeben" />
    <bpmn:sequenceFlow id="Flow_02_3" sourceRef="K02_Abgeben" targetRef="K02_Beleg" />
    <bpmn:sequenceFlow id="Flow_02_4" sourceRef="K02_Beleg" targetRef="K02_Termin" />
    <bpmn:sequenceFlow id="Flow_02_28" sourceRef="K02_Termin" targetRef="K02_End" />
    <bpmn:manualTask id="K02_Abgeben" name="Gerät abgeben">
      <bpmn:incoming>Flow_02_2</bpmn:incoming>
      <bpmn:outgoing>Flow_02_3</bpmn:outgoing>
    </bpmn:manualTask>
  </bpmn:process>
  <bpmn:dataStore id="Store_02_1" name="RepairFlow-Datenbank" />
  <bpmn:dataStore id="Store_02_2" name="Technikerplan" />
  <bpmn:message id="Msg_02_1" name="Gerät abgegeben">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_02_2" name="Annahmebeleg">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_02_3" name="Termin und Filiale">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_02">
    <bpmndi:BPMNPlane id="Plane_02" bpmnElement="Collab_02">
      <bpmndi:BPMNShape id="Part_02_Werkstatt_di" bpmnElement="Part_02_Werkstatt" isHorizontal="true">
        <dc:Bounds x="120" y="360" width="3950" height="785" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_02_2_di" bpmnElement="Lane_02_2" isHorizontal="true">
        <dc:Bounds x="150" y="780" width="3920" height="365" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_02_1_di" bpmnElement="Lane_02_1" isHorizontal="true">
        <dc:Bounds x="150" y="360" width="3920" height="420" />
