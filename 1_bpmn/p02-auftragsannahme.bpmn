    </bpmn:manualTask>
    <bpmn:userTask id="T02_Symptome" name="Symptome, Zubehör und Vorschäden dokumentieren">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_symptome" />
        <zeebe:assignmentDefinition candidateGroups="service-annahme" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_12</bpmn:incoming>
      <bpmn:outgoing>Flow_02_13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T02_Symptome_out_DataObjRef_02_2">
        <bpmn:targetRef>DataObjRef_02_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="T02_Auftrag" name="Reparaturauftrag anlegen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_auftrag" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_13</bpmn:incoming>
      <bpmn:outgoing>Flow_02_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T02_Auftrag_out_DataObjRef_02_3">
        <bpmn:targetRef>DataObjRef_02_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T02_Auftrag_out_DataStore_02_1">
        <bpmn:targetRef>DataStore_02_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T02_Beleg" name="Annahmebeleg an Kunde senden">
