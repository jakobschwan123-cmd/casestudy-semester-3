<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_02" targetNamespace="http://repairflow.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_02">
    <bpmn:documentation>Der Kunde gibt sein Gerät in der Filiale ab. RepairFlow sucht eine bestätigte, noch gültige Voranmeldung; ist eine vorhanden, werden ihre Daten übernommen, sonst erfasst die Annahme die Kundendaten. Danach wird das Gerät registriert, einer Sichtprüfung unterzogen und mit Symptomen, Zubehör und Vorschäden dokumentiert. RepairFlow legt den Reparaturauftrag an und sendet dem Kunden sofort den Annahmebeleg; das Gerät wird gekennzeichnet und eingelagert. Danach plant die Werkstattleitung: RepairFlow prüft die Auslastung der Filiale. Ist keine Kapazität frei, ermittelt RepairFlow eine Zielfiliale mit freier Kapazität, die Werkstattleitung leitet den Auftrag um und veranlasst den Transport des Geräts. Anschließend werden Techniker und Werkstatttermin festgelegt, und der Kunde erhält Termin und Filiale.</bpmn:documentation>
    <bpmn:participant id="Part_02_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_02" />
    <bpmn:participant id="Part_02_Kunde" name="Kunde" processRef="Proc_02_Kunde" />
    <bpmn:messageFlow id="MsgFlow_02_1" name="Gerät und Auftragswunsch" sourceRef="K02_Abgeben" targetRef="Start_02" />
    <bpmn:messageFlow id="MsgFlow_02_2" name="Annahmebeleg" sourceRef="T02_Beleg" targetRef="K02_Beleg" />
    <bpmn:messageFlow id="MsgFlow_02_3" name="Termin und Filiale" sourceRef="T02_TerminSenden" targetRef="K02_Termin" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_02" name="02 Auftragsannahme, Geräteregistrierung und Terminplanung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_02">
      <bpmn:lane id="Lane_02_1" name="Service / Annahme">
        <bpmn:flowNodeRef>Start_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Suchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW02_Voranmeldung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Uebernehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Kundendaten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_02a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Geraet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Sicht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Symptome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Auftrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Beleg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Einlagern</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_02_2" name="Werkstattleitung">
        <bpmn:flowNodeRef>T02_Auslastung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW02_Kapazitaet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Zielfiliale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Umleiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Transport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_02b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Techniker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_TerminSenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_02</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_02" name="Gerät abgegeben">
      <bpmn:outgoing>Flow_02_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_02_def" messageRef="Msg_02_1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T02_Suchen" name="Voranmeldung suchen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_suchen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_5</bpmn:incoming>
      <bpmn:outgoing>Flow_02_24</bpmn:outgoing>
      <bpmn:property id="T02_Suchen_prop_DataStore_02_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T02_Suchen_in_DataStore_02_4">
        <bpmn:sourceRef>DataStore_02_4</bpmn:sourceRef>
        <bpmn:targetRef>T02_Suchen_prop_DataStore_02_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW02_Voranmeldung" name="Bestätigte Voranmeldung vorhanden?">
