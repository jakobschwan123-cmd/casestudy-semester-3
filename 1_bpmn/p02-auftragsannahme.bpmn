    </bpmn:userTask>
    <bpmn:userTask id="T02_Termin" name="Werkstatttermin festlegen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_termin" />
        <zeebe:assignmentDefinition candidateGroups="werkstattleitung" />
