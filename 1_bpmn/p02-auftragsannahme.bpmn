      <bpmn:dataOutputAssociation id="T02_Geraet_out_DataObjRef_02_2">
        <bpmn:targetRef>DataObjRef_02_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
