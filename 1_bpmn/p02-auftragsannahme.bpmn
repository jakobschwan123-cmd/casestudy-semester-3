      <bpmn:incoming>Flow_02_20</bpmn:incoming>
      <bpmn:outgoing>Flow_02_21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T02_Termin_out_DataStore_02_3">
        <bpmn:targetRef>DataStore_02_3</bpmn:targetRef>
