      <bpmn:property id="T02_Techniker_prop_DataStore_02_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T02_Techniker_in_DataStore_02_3">
        <bpmn:sourceRef>DataStore_02_3</bpmn:sourceRef>
        <bpmn:targetRef>T02_Techniker_prop_DataStore_02_3</bpmn:targetRef>
