        <zeebe:formDefinition formId="form-t02_kundendaten" />
        <zeebe:assignmentDefinition candidateGroups="service-annahme" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_7</bpmn:incoming>
      <bpmn:outgoing>Flow_02_9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T02_Kundendaten_out_DataObjRef_02_4">
        <bpmn:targetRef>DataObjRef_02_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join_02a" name="">
      <bpmn:incoming>Flow_02_8</bpmn:incoming>
      <bpmn:incoming>Flow_02_9</bpmn:incoming>
      <bpmn:outgoing>Flow_02_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T02_Geraet" name="Gerät registrieren">
