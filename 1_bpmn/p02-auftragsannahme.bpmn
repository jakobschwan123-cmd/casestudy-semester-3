      <bpmn:outgoing>Flow_02_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T02_Uebernehmen" name="Voranmeldungsdaten übernehmen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_uebernehmen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_6</bpmn:incoming>
      <bpmn:outgoing>Flow_02_8</bpmn:outgoing>
      <bpmn:property id="T02_Uebernehmen_prop_DataObjRef_02_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T02_Uebernehmen_in_DataObjRef_02_1">
        <bpmn:sourceRef>DataObjRef_02_1</bpmn:sourceRef>
        <bpmn:targetRef>T02_Uebernehmen_prop_DataObjRef_02_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="T02_Kundendaten" name="Kundendaten erfassen">
