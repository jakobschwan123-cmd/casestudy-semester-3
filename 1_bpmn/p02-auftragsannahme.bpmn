    </bpmn:userTask>
    <bpmn:sendTask id="T02_TerminSenden" name="Termin und Filiale an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_termin" />
      </bpmn:extensionElements>
