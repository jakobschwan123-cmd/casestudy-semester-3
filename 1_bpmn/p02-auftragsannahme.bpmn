      <bpmn:outgoing>Flow_02_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="T02_Einlagern" name="Gerät kennzeichnen und einlagern">
      <bpmn:incoming>Flow_02_22</bpmn:incoming>
