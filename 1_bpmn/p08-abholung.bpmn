    <bpmn:sequenceFlow id="Flow_08_48" sourceRef="GW08_Offen" targetRef="Merge_08z" name="auf Rechnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden = true and zahlungsart = "rechnung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_49" sourceRef="GW08_Offen" targetRef="Merge_08v" name="bar / Karte kassiert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden = true and zahlungsart in ["bar", "karte"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_50" sourceRef="GW08_Offen" targetRef="Merge_08w" name="keine Rechnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_51" sourceRef="Merge_08z" targetRef="GW08_WartenZ" />
    <bpmn:sequenceFlow id="Flow_08_52" sourceRef="GW08_WartenZ" targetRef="E08_Zahlung" />
    <bpmn:sequenceFlow id="Flow_08_53" sourceRef="GW08_WartenZ" targetRef="E08_TimerZ" />
    <bpmn:sequenceFlow id="Flow_08_54" sourceRef="E08_TimerZ" targetRef="GW08_Mahnstufe" />
    <bpmn:sequenceFlow id="Flow_08_55" sourceRef="GW08_Mahnstufe" targetRef="T08_Mahnung" name="nein">
