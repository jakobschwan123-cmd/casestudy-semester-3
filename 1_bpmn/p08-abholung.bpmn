    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_38" sourceRef="GW08_Faellig" targetRef="Join_08a" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_39" sourceRef="T08_Zahlungsart" targetRef="GW08_Zahlungsart" />
    <bpmn:sequenceFlow id="Flow_08_40" sourceRef="GW08_Zahlungsart" targetRef="T08_Kassieren" name="bar / Karte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart in ["bar", "karte"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_41" sourceRef="GW08_Zahlungsart" targetRef="T08_Versand" name="auf Rechnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart = "rechnung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_42" sourceRef="T08_Kassieren" targetRef="Join_08a" />
