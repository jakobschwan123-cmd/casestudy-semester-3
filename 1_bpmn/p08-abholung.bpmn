<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_08" targetNamespace="http://repairflow.example/bpmn" exporter="RepairFlow BPMN Generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_08">
    <bpmn:documentation>Sobald ein Geraet abholbereit ist (repariert, abgelehnt oder nach Nacharbeit), erstellt RepairFlow die Rechnung aus KVA und Arbeitszeiten bzw. ueber die Diagnosepauschale (kostenfreie Nacharbeit ohne Rechnung) und benachrichtigt den Kunden; nach der dritten Erinnerung wird eine Lagergebuehr berechnet, bleibt auch die vierte ohne Abholung, wird die Verwertung des Geraets eingeleitet. Bei der Abholung wird die Zahlung erfasst (bar/Karte sofort, auf Rechnung mit Zahlungsziel, bis zu drei Mahnungen, danach Inkasso), das Geraet uebergeben und der Auftrag geschlossen.</bpmn:documentation>
    <bpmn:participant id="Part_08_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_08" />
    <bpmn:participant id="Part_08_Kunde" name="Kunde" processRef="Proc_08_Kunde" />
    <bpmn:messageFlow id="MsgFlow_08_1" name="Abhol-Benachrichtigung (ggf. Erinnerung)" sourceRef="T08_Benachrichtigung" targetRef="K08_Start" />
    <bpmn:messageFlow id="MsgFlow_08_2" name="Abholung" sourceRef="K08_Abholen" targetRef="E08_Kunde" />
    <bpmn:messageFlow id="MsgFlow_08_3" name="Zahlungsart" sourceRef="K08_Art" targetRef="T08_Zahlungsart" />
    <bpmn:messageFlow id="MsgFlow_08_4" name="Barzahlung / Kartenzahlung" sourceRef="K08_Bar" targetRef="T08_Kassieren" />
    <bpmn:messageFlow id="MsgFlow_08_5" name="Rechnung" sourceRef="T08_Versand" targetRef="K08_Rechnung" />
    <bpmn:messageFlow id="MsgFlow_08_6" name="Gerät + Erläuterung" sourceRef="T08_Uebergabe" targetRef="K08_Geraet" />
    <bpmn:messageFlow id="MsgFlow_08_7" name="Zahlung" sourceRef="K08_Ueberweisen" targetRef="E08_Zahlung" />
    <bpmn:messageFlow id="MsgFlow_08_8" name="Mahnung" sourceRef="T08_Mahnung" targetRef="K08_Mahnung" />
    <bpmn:messageFlow id="MsgFlow_08_9" name="Bitte um Bewertung" sourceRef="T08_Bewertung" targetRef="K08_Bewertung" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_08" name="08 Abholung, Rechnung und Zahlung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_08">
      <bpmn:lane id="Lane_08_1" name="Service / Annahme">
        <bpmn:flowNodeRef>Start_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Abr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Rechnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Pauschale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Benachrichtigung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Warten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Dritte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Lager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Verwertung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Kunde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Zahlungsart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Zahlungsart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Kassieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Versand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Abgeholt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Bestaende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Offen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08z</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_WartenZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Zahlung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_TimerZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Mahnstufe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Mahnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Inkasso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Verbuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Bewertung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_08_2" name="Techniker">
        <bpmn:flowNodeRef>T08_Holen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Faellig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_08a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Uebergabe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_08" name="Gerät abholbereit">
      <bpmn:outgoing>Flow_08_18</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW08_Abr" name="Abrechnung?">
      <bpmn:incoming>Flow_08_18</bpmn:incoming>
      <bpmn:outgoing>Flow_08_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
