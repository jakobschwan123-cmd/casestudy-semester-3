      <bpmn:outgoing>Flow_08_35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E08_Kunde_def" messageRef="Msg_08_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="T08_Holen" name="Gerät aus dem Lager holen">
      <bpmn:incoming>Flow_08_35</bpmn:incoming>
      <bpmn:outgoing>Flow_08_36</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW08_Faellig" name="Zahlung fällig?">
      <bpmn:incoming>Flow_08_36</bpmn:incoming>
      <bpmn:outgoing>Flow_08_37</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T08_Zahlungsart" name="Zahlungsart erfassen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t08_zahlungsart" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_37</bpmn:incoming>
      <bpmn:outgoing>Flow_08_39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW08_Zahlungsart" name="Zahlungsart?">
      <bpmn:incoming>Flow_08_39</bpmn:incoming>
      <bpmn:outgoing>Flow_08_40</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T08_Kassieren" name="Zahlung kassieren">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t08_kassieren" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_40</bpmn:incoming>
      <bpmn:outgoing>Flow_08_42</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T08_Versand" name="Rechnung mit Zahlungsziel versenden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_versand" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_41</bpmn:incoming>
      <bpmn:outgoing>Flow_08_43</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Join_08a" name="">
      <bpmn:incoming>Flow_08_38</bpmn:incoming>
      <bpmn:incoming>Flow_08_42</bpmn:incoming>
      <bpmn:incoming>Flow_08_43</bpmn:incoming>
      <bpmn:outgoing>Flow_08_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T08_Uebergabe" name="Reparatur erläutern und Gerät übergeben">
      <bpmn:incoming>Flow_08_44</bpmn:incoming>
      <bpmn:outgoing>Flow_08_45</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T08_Abgeholt" name="Auftrag auf 'abgeholt' setzen und schließen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_abgeholt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_45</bpmn:incoming>
      <bpmn:outgoing>Flow_08_46</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Abgeholt_out_DataObjRef_08_3">
        <bpmn:targetRef>DataObjRef_08_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T08_Abgeholt_out_DataStore_08_2">
        <bpmn:targetRef>DataStore_08_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T08_Bestaende" name="Reservierungen und Bestände abschließen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_bestaende" />
        <zeebe:ioMapping>
          <zeebe:output source="=0" target="mahnungen" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_46</bpmn:incoming>
      <bpmn:outgoing>Flow_08_47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW08_Offen" name="Zahlung?">
      <bpmn:incoming>Flow_08_47</bpmn:incoming>
      <bpmn:outgoing>Flow_08_48</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_49</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Merge_08z" name="">
      <bpmn:incoming>Flow_08_48</bpmn:incoming>
      <bpmn:incoming>Flow_08_57</bpmn:incoming>
      <bpmn:outgoing>Flow_08_51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="GW08_WartenZ" name="">
      <bpmn:incoming>Flow_08_51</bpmn:incoming>
      <bpmn:outgoing>Flow_08_52</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_53</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E08_Zahlung" name="Zahlung eingegangen">
      <bpmn:incoming>Flow_08_52</bpmn:incoming>
      <bpmn:outgoing>Flow_08_59</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E08_Zahlung_def" messageRef="Msg_08_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E08_TimerZ" name="14 Tage verstrichen">
      <bpmn:incoming>Flow_08_53</bpmn:incoming>
      <bpmn:outgoing>Flow_08_54</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E08_TimerZ_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW08_Mahnstufe" name="Dritte Mahnung erfolglos?">
      <bpmn:incoming>Flow_08_54</bpmn:incoming>
      <bpmn:outgoing>Flow_08_55</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_56</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T08_Mahnung" name="Mahnung senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_mahnung" />
        <zeebe:ioMapping>
          <zeebe:output source="=mahnungen + 1" target="mahnungen" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_55</bpmn:incoming>
      <bpmn:outgoing>Flow_08_57</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Mahnung_out_DataObjRef_08_4">
        <bpmn:targetRef>DataObjRef_08_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:userTask id="T08_Inkasso" name="Forderung an Inkasso übergeben">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t08_inkasso" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_56</bpmn:incoming>
      <bpmn:outgoing>Flow_08_58</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge_08v" name="">
      <bpmn:incoming>Flow_08_49</bpmn:incoming>
      <bpmn:incoming>Flow_08_59</bpmn:incoming>
      <bpmn:outgoing>Flow_08_60</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T08_Verbuchen" name="Zahlung verbuchen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_verbuchen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_60</bpmn:incoming>
      <bpmn:outgoing>Flow_08_61</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Verbuchen_out_DataObjRef_08_5">
        <bpmn:targetRef>DataObjRef_08_5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T08_Verbuchen_out_DataStore_08_1">
        <bpmn:targetRef>DataStore_08_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_08w" name="">
      <bpmn:incoming>Flow_08_50</bpmn:incoming>
      <bpmn:incoming>Flow_08_61</bpmn:incoming>
      <bpmn:outgoing>Flow_08_62</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T08_Bewertung" name="Bewertungsanfrage an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_bewertung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_62</bpmn:incoming>
      <bpmn:outgoing>Flow_08_63</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Merge_08f" name="">
      <bpmn:incoming>Flow_08_63</bpmn:incoming>
      <bpmn:incoming>Flow_08_34</bpmn:incoming>
      <bpmn:incoming>Flow_08_58</bpmn:incoming>
      <bpmn:outgoing>Flow_08_65</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_08" name="Auftrag abgeschlossen">
      <bpmn:incoming>Flow_08_65</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_08_18" sourceRef="Start_08" targetRef="GW08_Abr" />
    <bpmn:sequenceFlow id="Flow_08_19" sourceRef="GW08_Abr" targetRef="T08_Rechnung" name="Reparatur">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abrechnung = "reparatur"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_20" sourceRef="GW08_Abr" targetRef="T08_Pauschale" name="Diagnosepauschale">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abrechnung = "pauschale"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_21" sourceRef="GW08_Abr" targetRef="Merge_08" name="kostenfrei">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abrechnung = "kostenfrei"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_22" sourceRef="T08_Rechnung" targetRef="Merge_08" />
    <bpmn:sequenceFlow id="Flow_08_23" sourceRef="T08_Pauschale" targetRef="Merge_08" />
    <bpmn:sequenceFlow id="Flow_08_24" sourceRef="Merge_08" targetRef="T08_Benachrichtigung" />
    <bpmn:sequenceFlow id="Flow_08_25" sourceRef="T08_Benachrichtigung" targetRef="GW08_Warten" />
    <bpmn:sequenceFlow id="Flow_08_26" sourceRef="GW08_Warten" targetRef="E08_Kunde" />
    <bpmn:sequenceFlow id="Flow_08_27" sourceRef="GW08_Warten" targetRef="E08_Timer" />
    <bpmn:sequenceFlow id="Flow_08_28" sourceRef="E08_Timer" targetRef="GW08_Dritte" />
    <bpmn:sequenceFlow id="Flow_08_30" sourceRef="GW08_Dritte" targetRef="Merge_08" name="&lt; 3 oder = 4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abholErinnerungen &lt; 3 or abholErinnerungen = 4</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_31" sourceRef="GW08_Dritte" targetRef="T08_Lager" name="= 3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abholErinnerungen = 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_32" sourceRef="GW08_Dritte" targetRef="T08_Verwertung" name="&gt; 4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abholErinnerungen &gt; 4</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_33" sourceRef="T08_Lager" targetRef="Merge_08" />
    <bpmn:sequenceFlow id="Flow_08_34" sourceRef="T08_Verwertung" targetRef="Merge_08f" />
    <bpmn:sequenceFlow id="Flow_08_35" sourceRef="E08_Kunde" targetRef="T08_Holen" />
