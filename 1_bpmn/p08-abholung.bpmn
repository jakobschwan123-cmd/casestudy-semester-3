<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_08" targetNamespace="http://repairflow.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_08">
    <bpmn:documentation>Sobald ein Gerät abholbereit ist (repariert, abgelehnt oder nach Nacharbeit), erstellt RepairFlow die Rechnung aus KVA und Arbeitszeiten bzw. über die Diagnosepauschale (kostenfreie Nacharbeit ohne Rechnung) und benachrichtigt den Kunden; ab der dritten Frist wird mit der Erinnerung eine Lagergebühr berechnet, bleibt auch die vierte Erinnerung ohne Abholung, wird die Verwertung des Geräts eingeleitet. Bei der Abholung wird die Zahlung erfasst (bar/Karte sofort, auf Rechnung mit Zahlungsziel, bis zu drei Mahnungen, danach Inkasso), das Gerät übergeben und der Auftrag geschlossen.</bpmn:documentation>
    <bpmn:participant id="Part_08_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_08" />
    <bpmn:participant id="Part_08_Kunde" name="Kunde" processRef="Proc_08_Kunde" />
    <bpmn:messageFlow id="MsgFlow_08_10" name="Abhol-Erinnerung" sourceRef="T08_Erinnern" targetRef="K08_Erinnerung" />
    <bpmn:messageFlow id="MsgFlow_08_1" name="Abhol-Benachrichtigung" sourceRef="T08_Benachrichtigung" targetRef="K08_Start" />
    <bpmn:messageFlow id="MsgFlow_08_2" name="Abholung" sourceRef="K08_Abholen" targetRef="E08_Kunde" />
    <bpmn:messageFlow id="MsgFlow_08_3" name="Zahlungsart" sourceRef="K08_Art" targetRef="T08_Zahlungsart" />
    <bpmn:messageFlow id="MsgFlow_08_4" name="Barzahlung / Kartenzahlung" sourceRef="K08_Bar" targetRef="T08_Kassieren" />
    <bpmn:messageFlow id="MsgFlow_08_5" name="Rechnung" sourceRef="T08_Versand" targetRef="K08_Rechnung" />
    <bpmn:messageFlow id="MsgFlow_08_6" name="Gerät + Erläuterung" sourceRef="T08_Uebergabe" targetRef="K08_Geraet" />
    <bpmn:messageFlow id="MsgFlow_08_7" name="Zahlung" sourceRef="K08_Ueberweisen" targetRef="E08_Zahlung" />
    <bpmn:messageFlow id="MsgFlow_08_8" name="Mahnung" sourceRef="T08_Mahnung" targetRef="K08_Mahnung" />
    <bpmn:messageFlow id="MsgFlow_08_9" name="Bitte um Bewertung" sourceRef="T08_Bewertung" targetRef="K08_Bewertung" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_08" name="08 Abholung, Rechnung und Zahlung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_08">
      <bpmn:lane id="Lane_08_1" name="Service / Annahme">
        <bpmn:flowNodeRef>Start_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Abr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Rechnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Pauschale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Benachrichtigung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08y</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Erinnern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Warten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Dritte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Lager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Verwertung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Kunde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Holen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Faellig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Zahlungsart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Zahlungsart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Kassieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Versand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_08a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Uebergabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Abgeholt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Bestaende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Offen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08z</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_WartenZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Zahlung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_TimerZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Mahnstufe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Mahnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Inkasso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Verbuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Bewertung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_08</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_08_65" sourceRef="Merge_08f" targetRef="End_08" />
    <bpmn:sequenceFlow id="Flow_08_63" sourceRef="T08_Bewertung" targetRef="Merge_08f" />
    <bpmn:sequenceFlow id="Flow_08_62" sourceRef="Merge_08w" targetRef="T08_Bewertung" />
    <bpmn:sequenceFlow id="Flow_08_61" sourceRef="T08_Verbuchen" targetRef="Merge_08w" />
    <bpmn:sequenceFlow id="Flow_08_60" sourceRef="Merge_08v" targetRef="T08_Verbuchen" />
    <bpmn:sequenceFlow id="Flow_08_58" sourceRef="T08_Inkasso" targetRef="Merge_08f" />
    <bpmn:sequenceFlow id="Flow_08_56" name="ja" sourceRef="GW08_Mahnstufe" targetRef="T08_Inkasso">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=mahnungen &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_55" name="nein" sourceRef="GW08_Mahnstufe" targetRef="T08_Mahnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=mahnungen &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_54" sourceRef="E08_TimerZ" targetRef="GW08_Mahnstufe" />
    <bpmn:sequenceFlow id="Flow_08_59" sourceRef="E08_Zahlung" targetRef="Merge_08v" />
    <bpmn:sequenceFlow id="Flow_08_53" sourceRef="GW08_WartenZ" targetRef="E08_TimerZ" />
    <bpmn:sequenceFlow id="Flow_08_52" sourceRef="GW08_WartenZ" targetRef="E08_Zahlung" />
    <bpmn:sequenceFlow id="Flow_08_51" sourceRef="Merge_08z" targetRef="GW08_WartenZ" />
    <bpmn:sequenceFlow id="Flow_08_57" sourceRef="T08_Mahnung" targetRef="Merge_08z" />
    <bpmn:sequenceFlow id="Flow_08_50" name="keine Rechnung" sourceRef="GW08_Offen" targetRef="Merge_08w">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_49" name="bar / Karte kassiert" sourceRef="GW08_Offen" targetRef="Merge_08v">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden = true and zahlungsart in ["bar", "karte"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_48" name="auf Rechnung" sourceRef="GW08_Offen" targetRef="Merge_08z">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden = true and zahlungsart = "rechnung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_47" sourceRef="T08_Bestaende" targetRef="GW08_Offen" />
    <bpmn:sequenceFlow id="Flow_08_46" sourceRef="T08_Abgeholt" targetRef="T08_Bestaende" />
    <bpmn:sequenceFlow id="Flow_08_45" sourceRef="T08_Uebergabe" targetRef="T08_Abgeholt" />
    <bpmn:sequenceFlow id="Flow_08_44" sourceRef="Join_08a" targetRef="T08_Uebergabe" />
    <bpmn:sequenceFlow id="Flow_08_43" sourceRef="T08_Versand" targetRef="Join_08a" />
    <bpmn:sequenceFlow id="Flow_08_42" sourceRef="T08_Kassieren" targetRef="Join_08a" />
    <bpmn:sequenceFlow id="Flow_08_41" name="auf Rechnung" sourceRef="GW08_Zahlungsart" targetRef="T08_Versand">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart = "rechnung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_40" name="bar / Karte" sourceRef="GW08_Zahlungsart" targetRef="T08_Kassieren">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart in ["bar", "karte"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_39" sourceRef="T08_Zahlungsart" targetRef="GW08_Zahlungsart" />
    <bpmn:sequenceFlow id="Flow_08_38" name="nein" sourceRef="GW08_Faellig" targetRef="Join_08a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_37" name="ja" sourceRef="GW08_Faellig" targetRef="T08_Zahlungsart">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungVorhanden = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_36" sourceRef="T08_Holen" targetRef="GW08_Faellig" />
    <bpmn:sequenceFlow id="Flow_08_35" sourceRef="E08_Kunde" targetRef="T08_Holen" />
    <bpmn:sequenceFlow id="Flow_08_34" sourceRef="T08_Verwertung" targetRef="Merge_08f" />
    <bpmn:sequenceFlow id="Flow_08_32" name="5. Frist" sourceRef="GW08_Dritte" targetRef="T08_Verwertung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abholErinnerungen &gt; 4</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_31" name="3. Frist" sourceRef="GW08_Dritte" targetRef="T08_Lager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abholErinnerungen = 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_28" sourceRef="E08_Timer" targetRef="GW08_Dritte" />
    <bpmn:sequenceFlow id="Flow_08_27" sourceRef="GW08_Warten" targetRef="E08_Timer" />
    <bpmn:sequenceFlow id="Flow_08_26" sourceRef="GW08_Warten" targetRef="E08_Kunde" />
    <bpmn:sequenceFlow id="Flow_08_75" sourceRef="Merge_08y" targetRef="T08_Erinnern" />
    <bpmn:sequenceFlow id="Flow_08_33" sourceRef="T08_Lager" targetRef="Merge_08y" />
    <bpmn:sequenceFlow id="Flow_08_30" name="1., 2. oder 4. Frist" sourceRef="GW08_Dritte" targetRef="Merge_08y">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abholErinnerungen &lt; 3 or abholErinnerungen = 4</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_74" sourceRef="Merge_08x" targetRef="GW08_Warten" />
    <bpmn:sequenceFlow id="Flow_08_76" sourceRef="T08_Erinnern" targetRef="Merge_08x" />
    <bpmn:sequenceFlow id="Flow_08_25" sourceRef="T08_Benachrichtigung" targetRef="Merge_08x" />
    <bpmn:sequenceFlow id="Flow_08_24" sourceRef="Merge_08" targetRef="T08_Benachrichtigung" />
    <bpmn:sequenceFlow id="Flow_08_23" sourceRef="T08_Pauschale" targetRef="Merge_08" />
    <bpmn:sequenceFlow id="Flow_08_22" sourceRef="T08_Rechnung" targetRef="Merge_08" />
    <bpmn:sequenceFlow id="Flow_08_21" name="kostenfrei" sourceRef="GW08_Abr" targetRef="Merge_08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abrechnung = "kostenfrei"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_20" name="Diagnosepauschale" sourceRef="GW08_Abr" targetRef="T08_Pauschale">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abrechnung = "pauschale"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_19" name="Reparatur" sourceRef="GW08_Abr" targetRef="T08_Rechnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=abrechnung = "reparatur"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_18" sourceRef="Start_08" targetRef="GW08_Abr" />
    <bpmn:dataStoreReference id="DataStore_08_2" name="RepairFlow-Datenbank" dataStoreRef="Store_08_2" />
    <bpmn:dataStoreReference id="DataStore_08_1" name="Buchhaltung (DATEV-Export)" dataStoreRef="Store_08_1" />
    <bpmn:dataObjectReference id="DataObjRef_08_5" name="Rechnung [bezahlt]" dataObjectRef="DataObj_08_5" />
    <bpmn:dataObject id="DataObj_08_5" />
    <bpmn:dataObjectReference id="DataObjRef_08_4" name="Rechnung [Mahnung]" dataObjectRef="DataObj_08_4" />
    <bpmn:dataObject id="DataObj_08_4" />
    <bpmn:dataObjectReference id="DataObjRef_08_3" name="Reparatur-auftrag [abgeholt]" dataObjectRef="DataObj_08_3" />
    <bpmn:dataObject id="DataObj_08_3" />
    <bpmn:dataObjectReference id="DataObjRef_08_2" name="Rechnung [offen]" dataObjectRef="DataObj_08_2" />
    <bpmn:dataObject id="DataObj_08_2" />
    <bpmn:dataObjectReference id="DataObjRef_08_1" name="Rechnung [offen]" dataObjectRef="DataObj_08_1" />
    <bpmn:dataObject id="DataObj_08_1" />
    <bpmn:endEvent id="End_08" name="Auftrag abgeschlossen">
      <bpmn:incoming>Flow_08_65</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_08f" name="">
      <bpmn:incoming>Flow_08_63</bpmn:incoming>
      <bpmn:incoming>Flow_08_34</bpmn:incoming>
      <bpmn:incoming>Flow_08_58</bpmn:incoming>
      <bpmn:outgoing>Flow_08_65</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T08_Bewertung" name="Bewertungsanfrage an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_bewertung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_62</bpmn:incoming>
      <bpmn:outgoing>Flow_08_63</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Merge_08w" name="">
      <bpmn:incoming>Flow_08_50</bpmn:incoming>
      <bpmn:incoming>Flow_08_61</bpmn:incoming>
      <bpmn:outgoing>Flow_08_62</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T08_Verbuchen" name="Zahlung verbuchen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_verbuchen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_60</bpmn:incoming>
      <bpmn:outgoing>Flow_08_61</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Verbuchen_out_DataObjRef_08_5">
        <bpmn:targetRef>DataObjRef_08_5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T08_Verbuchen_out_DataStore_08_1">
        <bpmn:targetRef>DataStore_08_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_08v" name="">
      <bpmn:incoming>Flow_08_49</bpmn:incoming>
      <bpmn:incoming>Flow_08_59</bpmn:incoming>
      <bpmn:outgoing>Flow_08_60</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T08_Inkasso" name="Forderung an Inkasso übergeben">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t08_inkasso" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_56</bpmn:incoming>
      <bpmn:outgoing>Flow_08_58</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T08_Mahnung" name="Mahnung senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_mahnung" />
        <zeebe:ioMapping>
          <zeebe:output source="=mahnungen + 1" target="mahnungen" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_55</bpmn:incoming>
      <bpmn:outgoing>Flow_08_57</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Mahnung_out_DataObjRef_08_4">
        <bpmn:targetRef>DataObjRef_08_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW08_Mahnstufe" name="Dritte Mahnung erfolglos?">
      <bpmn:incoming>Flow_08_54</bpmn:incoming>
      <bpmn:outgoing>Flow_08_55</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_56</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="E08_TimerZ" name="14 Tage verstrichen">
      <bpmn:incoming>Flow_08_53</bpmn:incoming>
      <bpmn:outgoing>Flow_08_54</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E08_TimerZ_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E08_Zahlung" name="Zahlung eingegangen">
      <bpmn:incoming>Flow_08_52</bpmn:incoming>
      <bpmn:outgoing>Flow_08_59</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E08_Zahlung_def" messageRef="Msg_08_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="GW08_WartenZ" name="">
      <bpmn:incoming>Flow_08_51</bpmn:incoming>
      <bpmn:outgoing>Flow_08_52</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_53</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:exclusiveGateway id="Merge_08z" name="">
      <bpmn:incoming>Flow_08_48</bpmn:incoming>
      <bpmn:incoming>Flow_08_57</bpmn:incoming>
      <bpmn:outgoing>Flow_08_51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW08_Offen" name="Wie wurde gezahlt?">
      <bpmn:incoming>Flow_08_47</bpmn:incoming>
      <bpmn:outgoing>Flow_08_48</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_49</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T08_Bestaende" name="Reservierungen und Bestände abschließen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_bestaende" />
        <zeebe:ioMapping>
          <zeebe:output source="=0" target="mahnungen" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_46</bpmn:incoming>
      <bpmn:outgoing>Flow_08_47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T08_Abgeholt" name="Auftrag auf &#39;abgeholt&#39; setzen und schließen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_abgeholt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_45</bpmn:incoming>
      <bpmn:outgoing>Flow_08_46</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Abgeholt_out_DataObjRef_08_3">
        <bpmn:targetRef>DataObjRef_08_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T08_Abgeholt_out_DataStore_08_2">
        <bpmn:targetRef>DataStore_08_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="T08_Uebergabe" name="Reparatur erläutern und Gerät übergeben">
      <bpmn:incoming>Flow_08_44</bpmn:incoming>
      <bpmn:outgoing>Flow_08_45</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Join_08a" name="">
      <bpmn:incoming>Flow_08_38</bpmn:incoming>
      <bpmn:incoming>Flow_08_42</bpmn:incoming>
      <bpmn:incoming>Flow_08_43</bpmn:incoming>
      <bpmn:outgoing>Flow_08_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T08_Versand" name="Rechnung mit Zahlungsziel versenden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_versand" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_41</bpmn:incoming>
      <bpmn:outgoing>Flow_08_43</bpmn:outgoing>
