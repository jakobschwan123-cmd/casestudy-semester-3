<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_04" targetNamespace="http://repairflow.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_04">
    <bpmn:documentation>RepairFlow startet den Kostenvoranschlag, sobald die Fehlerdiagnose (Prozess 03) ihn angestoßen hat. Der Techniker erfasst die KVA-Positionen aus dem Fehlerbefund, RepairFlow übernimmt die Ersatzteilpreise und berechnet den Kostenvoranschlag, die Annahme prüft ihn. RepairFlow setzt den Auftragsstatus auf „KVA offen“ und sendet den Kostenvoranschlag an den Kunden. Antwortet der Kunde drei Tage lang nicht, erhält er eine Erinnerung; nach dem dritten Fristablauf ohne Antwort gilt der Kostenvoranschlag als abgelehnt. Gibt der Kunde ihn frei, setzt RepairFlow den Status auf „freigegeben“ und disponiert die Ersatzteile über Prozess 05. Ist die Frist abgelaufen oder sind nicht alle Teile beschaffbar, erhält der Kunde eine Reparaturabsage. In diesen Fällen und nach einer Ablehnung durch den Kunden setzt RepairFlow den Status auf „abgelehnt“, und das Gerät geht über Prozess 08 mit Diagnosepauschale zur Abholung.</bpmn:documentation>
    <bpmn:participant id="Part_04_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_04" />
    <bpmn:participant id="Part_04_Kunde" name="Kunde" processRef="Proc_04_Kunde" />
    <bpmn:messageFlow id="MsgFlow_04_1" name="Kosten&#173;voranschlag" sourceRef="T04_Senden" targetRef="K04_Start" />
    <bpmn:messageFlow id="MsgFlow_04_2" name="Freigabe" sourceRef="K04_Freigabe" targetRef="E04_Freigabe" />
    <bpmn:messageFlow id="MsgFlow_04_3" name="Ablehnung" sourceRef="K04_Ablehnung" targetRef="E04_Ablehnung" />
    <bpmn:messageFlow id="MsgFlow_04_4" name="Erinnerung" sourceRef="T04_Erinnerung" targetRef="Part_04_Kunde" />
    <bpmn:messageFlow id="MsgFlow_04_5" name="Reparaturabsage" sourceRef="T04_Absage" targetRef="Part_04_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_04" name="04 Kostenvoranschlag und Kundenfreigabe" isExecutable="true">
    <bpmn:laneSet id="LaneSet_04">
      <bpmn:lane id="Lane_04_1" name="Service / Annahme">
        <bpmn:flowNodeRef>T04_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Senden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_04w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW04_Warten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E04_Freigabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E04_Ablehnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E04_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW04_Dritte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Erinnerung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Freigegeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Dispo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW04_Teile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_04b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Absage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_04a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Abgelehnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Abholung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_04_2" name="Techniker">
        <bpmn:flowNodeRef>Start_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Positionen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Preise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04_Berechnen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_04" name="KVA angestoßen">
      <bpmn:outgoing>Flow_04_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_04_def" messageRef="Msg_04_0" />
    </bpmn:startEvent>
    <bpmn:userTask id="T04_Positionen" name="KVA-Positionen erfassen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t04_positionen" />
        <zeebe:assignmentDefinition candidateGroups="techniker" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_8</bpmn:incoming>
      <bpmn:outgoing>Flow_04_9</bpmn:outgoing>
      <bpmn:property id="T04_Positionen_prop_DataObjRef_04_9" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T04_Positionen_in_DataObjRef_04_9">
        <bpmn:sourceRef>DataObjRef_04_9</bpmn:sourceRef>
        <bpmn:targetRef>T04_Positionen_prop_DataObjRef_04_9</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="T04_Positionen_out_DataObjRef_04_1">
        <bpmn:targetRef>DataObjRef_04_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="T04_Preise" name="Ersatzteilpreise übernehmen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_preise" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_9</bpmn:incoming>
      <bpmn:outgoing>Flow_04_10</bpmn:outgoing>
      <bpmn:property id="T04_Preise_prop_DataStore_04_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T04_Preise_in_DataStore_04_1">
        <bpmn:sourceRef>DataStore_04_1</bpmn:sourceRef>
        <bpmn:targetRef>T04_Preise_prop_DataStore_04_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T04_Berechnen" name="Kostenvoranschlag berechnen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_berechnen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_10</bpmn:incoming>
      <bpmn:outgoing>Flow_04_11</bpmn:outgoing>
      <bpmn:property id="T04_Berechnen_prop_DataObjRef_04_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T04_Berechnen_in_DataObjRef_04_1">
        <bpmn:sourceRef>DataObjRef_04_1</bpmn:sourceRef>
        <bpmn:targetRef>T04_Berechnen_prop_DataObjRef_04_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="T04_Berechnen_out_DataObjRef_04_2">
        <bpmn:targetRef>DataObjRef_04_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="T04_Pruefen" name="Kostenvoranschlag prüfen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t04_pruefen" />
        <zeebe:assignmentDefinition candidateGroups="service-annahme" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_11</bpmn:incoming>
      <bpmn:outgoing>Flow_04_12</bpmn:outgoing>
      <bpmn:property id="T04_Pruefen_prop_DataObjRef_04_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T04_Pruefen_in_DataObjRef_04_2">
        <bpmn:sourceRef>DataObjRef_04_2</bpmn:sourceRef>
        <bpmn:targetRef>T04_Pruefen_prop_DataObjRef_04_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="T04_Status" name="Auftragsstatus auf „KVA offen“ setzen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_status" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_12</bpmn:incoming>
      <bpmn:outgoing>Flow_04_13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T04_Status_out_DataObjRef_04_3">
        <bpmn:targetRef>DataObjRef_04_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T04_Senden" name="Kostenvoranschlag an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_senden" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_13</bpmn:incoming>
      <bpmn:outgoing>Flow_04_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T04_Senden_out_DataObjRef_04_4">
        <bpmn:targetRef>DataObjRef_04_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Merge_04w" name="">
      <bpmn:incoming>Flow_04_15</bpmn:incoming>
      <bpmn:incoming>Flow_04_20</bpmn:incoming>
      <bpmn:outgoing>Flow_04_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="GW04_Warten" name="">
      <bpmn:incoming>Flow_04_14</bpmn:incoming>
      <bpmn:outgoing>Flow_04_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_18</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E04_Freigabe" name="Freigabe erhalten">
      <bpmn:incoming>Flow_04_16</bpmn:incoming>
      <bpmn:outgoing>Flow_04_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E04_Freigabe_def" messageRef="Msg_04_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E04_Ablehnung" name="Ablehnung erhalten">
      <bpmn:incoming>Flow_04_17</bpmn:incoming>
      <bpmn:outgoing>Flow_04_26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E04_Ablehnung_def" messageRef="Msg_04_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E04_Timer" name="3 Tage verstrichen">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if erinnerungen = null then 1 else erinnerungen + 1" target="erinnerungen" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_18</bpmn:incoming>
      <bpmn:outgoing>Flow_04_19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E04_Timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW04_Dritte" name="Dritte Frist verstrichen?">
      <bpmn:incoming>Flow_04_19</bpmn:incoming>
      <bpmn:outgoing>Flow_04_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T04_Erinnerung" name="Erinnerung an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_erinnerung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_21</bpmn:incoming>
      <bpmn:outgoing>Flow_04_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T04_Freigegeben" name="Auftragsstatus auf „freigegeben“ setzen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_freigegeben" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_23</bpmn:incoming>
      <bpmn:outgoing>Flow_04_24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T04_Freigegeben_out_DataObjRef_04_7">
        <bpmn:targetRef>DataObjRef_04_7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T04_Freigegeben_out_DataObjRef_04_5">
        <bpmn:targetRef>DataObjRef_04_5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="T04_Dispo" name="05 Ersatzteile disponieren">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_05" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:output source="=teileVollstaendig != false" target="teileVollstaendig" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_24</bpmn:incoming>
      <bpmn:outgoing>Flow_04_25</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GW04_Teile" name="Alle Teile beschaffbar?">
      <bpmn:incoming>Flow_04_25</bpmn:incoming>
      <bpmn:outgoing>Flow_04_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Merge_04b" name="">
      <bpmn:incoming>Flow_04_22</bpmn:incoming>
      <bpmn:incoming>Flow_04_32</bpmn:incoming>
      <bpmn:outgoing>Flow_04_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T04_Absage" name="Kunde über Reparaturabsage informieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_absage" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_33</bpmn:incoming>
      <bpmn:outgoing>Flow_04_34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Merge_04a" name="">
      <bpmn:incoming>Flow_04_34</bpmn:incoming>
      <bpmn:incoming>Flow_04_26</bpmn:incoming>
      <bpmn:outgoing>Flow_04_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T04_Abgelehnt" name="Auftragsstatus auf „abgelehnt“ setzen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t04_abgelehnt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_27</bpmn:incoming>
      <bpmn:outgoing>Flow_04_28</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T04_Abgelehnt_out_DataObjRef_04_6">
        <bpmn:targetRef>DataObjRef_04_6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T04_Abgelehnt_out_DataObjRef_04_8">
        <bpmn:targetRef>DataObjRef_04_8</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="T04_Abholung" name="08 Abholung abwickeln">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_08" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;pauschale&quot;" target="abrechnung" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_28</bpmn:incoming>
      <bpmn:outgoing>Flow_04_29</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Join_04" name="">
      <bpmn:incoming>Flow_04_31</bpmn:incoming>
      <bpmn:incoming>Flow_04_29</bpmn:incoming>
      <bpmn:outgoing>Flow_04_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_04" name="KVA-Entscheidung verarbeitet">
      <bpmn:incoming>Flow_04_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04_8" sourceRef="Start_04" targetRef="T04_Positionen" />
    <bpmn:sequenceFlow id="Flow_04_9" sourceRef="T04_Positionen" targetRef="T04_Preise" />
    <bpmn:sequenceFlow id="Flow_04_10" sourceRef="T04_Preise" targetRef="T04_Berechnen" />
    <bpmn:sequenceFlow id="Flow_04_11" sourceRef="T04_Berechnen" targetRef="T04_Pruefen" />
    <bpmn:sequenceFlow id="Flow_04_12" sourceRef="T04_Pruefen" targetRef="T04_Status" />
    <bpmn:sequenceFlow id="Flow_04_13" sourceRef="T04_Status" targetRef="T04_Senden" />
    <bpmn:sequenceFlow id="Flow_04_15" sourceRef="T04_Senden" targetRef="Merge_04w" />
    <bpmn:sequenceFlow id="Flow_04_14" sourceRef="Merge_04w" targetRef="GW04_Warten" />
    <bpmn:sequenceFlow id="Flow_04_16" sourceRef="GW04_Warten" targetRef="E04_Freigabe" />
    <bpmn:sequenceFlow id="Flow_04_17" sourceRef="GW04_Warten" targetRef="E04_Ablehnung" />
    <bpmn:sequenceFlow id="Flow_04_18" sourceRef="GW04_Warten" targetRef="E04_Timer" />
    <bpmn:sequenceFlow id="Flow_04_19" sourceRef="E04_Timer" targetRef="GW04_Dritte" />
    <bpmn:sequenceFlow id="Flow_04_21" name="nein" sourceRef="GW04_Dritte" targetRef="T04_Erinnerung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=erinnerungen &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04_20" sourceRef="T04_Erinnerung" targetRef="Merge_04w" />
    <bpmn:sequenceFlow id="Flow_04_22" name="ja" sourceRef="GW04_Dritte" targetRef="Merge_04b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=erinnerungen &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04_23" sourceRef="E04_Freigabe" targetRef="T04_Freigegeben" />
    <bpmn:sequenceFlow id="Flow_04_24" sourceRef="T04_Freigegeben" targetRef="T04_Dispo" />
    <bpmn:sequenceFlow id="Flow_04_25" sourceRef="T04_Dispo" targetRef="GW04_Teile" />
    <bpmn:sequenceFlow id="Flow_04_31" name="ja" sourceRef="GW04_Teile" targetRef="Join_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=teileVollstaendig</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04_32" name="nein" sourceRef="GW04_Teile" targetRef="Merge_04b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(teileVollstaendig)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04_33" sourceRef="Merge_04b" targetRef="T04_Absage" />
    <bpmn:sequenceFlow id="Flow_04_34" sourceRef="T04_Absage" targetRef="Merge_04a" />
    <bpmn:sequenceFlow id="Flow_04_26" sourceRef="E04_Ablehnung" targetRef="Merge_04a" />
    <bpmn:sequenceFlow id="Flow_04_27" sourceRef="Merge_04a" targetRef="T04_Abgelehnt" />
    <bpmn:sequenceFlow id="Flow_04_28" sourceRef="T04_Abgelehnt" targetRef="T04_Abholung" />
    <bpmn:sequenceFlow id="Flow_04_29" sourceRef="T04_Abholung" targetRef="Join_04" />
    <bpmn:sequenceFlow id="Flow_04_30" sourceRef="Join_04" targetRef="End_04" />
    <bpmn:dataObjectReference id="DataObjRef_04_9" name="Fehlerbefund" dataObjectRef="DataObj_04_9" />
    <bpmn:dataObject id="DataObj_04_9" />
    <bpmn:dataObjectReference id="DataObjRef_04_1" name="KvaPosition" dataObjectRef="DataObj_04_1" />
    <bpmn:dataObject id="DataObj_04_1" />
    <bpmn:dataStoreReference id="DataStore_04_1" name="RepairFlow-Datenbank" dataStoreRef="Store_04_1" />
    <bpmn:dataObjectReference id="DataObjRef_04_2" name="Kosten&#173;voranschlag [Entwurf]" dataObjectRef="DataObj_04_2" />
    <bpmn:dataObject id="DataObj_04_2" />
    <bpmn:dataObjectReference id="DataObjRef_04_3" name="Reparaturauftrag [KVA offen]" dataObjectRef="DataObj_04_3" />
    <bpmn:dataObject id="DataObj_04_3" />
    <bpmn:dataObjectReference id="DataObjRef_04_4" name="Kosten&#173;voranschlag [versendet]" dataObjectRef="DataObj_04_4" />
    <bpmn:dataObject id="DataObj_04_4" />
    <bpmn:dataObjectReference id="DataObjRef_04_7" name="Kosten&#173;voranschlag [freigegeben]" dataObjectRef="DataObj_04_7" />
    <bpmn:dataObject id="DataObj_04_7" />
    <bpmn:dataObjectReference id="DataObjRef_04_5" name="Reparaturauftrag [freigegeben]" dataObjectRef="DataObj_04_5" />
    <bpmn:dataObject id="DataObj_04_5" />
    <bpmn:dataObjectReference id="DataObjRef_04_6" name="Reparaturauftrag [abgelehnt]" dataObjectRef="DataObj_04_6" />
    <bpmn:dataObject id="DataObj_04_6" />
    <bpmn:dataObjectReference id="DataObjRef_04_8" name="Kosten&#173;voranschlag [abgelehnt]" dataObjectRef="DataObj_04_8" />
    <bpmn:dataObject id="DataObj_04_8" />
  </bpmn:process>
  <bpmn:process id="Proc_04_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K04_Start" name="KVA erhalten">
      <bpmn:outgoing>Flow_04_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K04_Start_def" messageRef="Msg_04_3" />
    </bpmn:startEvent>
    <bpmn:userTask id="K04_Pruefen" name="KVA in der App prüfen">
      <bpmn:incoming>Flow_04_1</bpmn:incoming>
      <bpmn:outgoing>Flow_04_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="K04_GW" name="KVA freigeben?">
      <bpmn:incoming>Flow_04_2</bpmn:incoming>
