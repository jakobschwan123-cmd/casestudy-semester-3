      <bpmndi:BPMNShape id="Lane_04_2_di" bpmnElement="Lane_04_2" isHorizontal="true">
        <dc:Bounds x="150" y="1065" width="3245" height="305" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_04_Kunde_di" bpmnElement="Part_04_Kunde" isHorizontal="true">
