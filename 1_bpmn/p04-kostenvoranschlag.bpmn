      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T04_Preise_di" bpmnElement="T04_Preise">
        <dc:Bounds x="560" y="1162" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T04_Berechnen_di" bpmnElement="T04_Berechnen">
        <dc:Bounds x="750" y="1162" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T04_Pruefen_di" bpmnElement="T04_Pruefen">
        <dc:Bounds x="940" y="572" width="130" height="80" />
