        <dc:Bounds x="1367" y="464" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1330" y="506" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
