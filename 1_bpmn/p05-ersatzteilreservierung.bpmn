<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_05" targetNamespace="http://repairflow.example/bpmn" exporter="RepairFlow BPMN Generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_05">
    <bpmn:documentation>Nach der KVA-Freigabe wandelt RepairFlow die Vorreservierungen aus Prozess 01 in Reservierungen um und prueft fuer die uebrigen Ersatzteile den Bestand der eigenen und der anderen Filialen, reserviert Teile, fordert Umlagerungen an und markiert Fehlteile fuer die Bestellung. Unterschreitet ein Bestand den Meldebestand, entsteht ein Nachbestellvorschlag; er bleibt im Status Vorschlag und wird mit der naechsten Bestellung in Prozess 06 gebuendelt, ohne die Reparatur aufzuhalten. Der Kunde erhaelt den voraussichtlichen Reparaturbeginn; nur Fehlteile werden direkt ueber Prozess 06 bestellt.</bpmn:documentation>
    <bpmn:participant id="Part_05_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_05" />
    <bpmn:participant id="Part_05_Kunde" name="Kunde" processRef="Proc_05_Kunde" />
    <bpmn:messageFlow id="MsgFlow_05_1" name="Voraussichtlicher Reparaturbeginn" sourceRef="T05_Info" targetRef="K05_Start" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_05" name="05 Ersatzteil-Verfügbarkeit und Reservierung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_05">
      <bpmn:lane id="Lane_05_1" name="Service / Annahme">
        <bpmn:flowNodeRef>T05_Beginn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Info</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_05_2" name="Ersatzteil-Disposition">
        <bpmn:flowNodeRef>Start_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Teileliste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Vorreservierung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Bestaetigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Meldebestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW05_Meldebestand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Nachbestellung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_05m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW05_Fehlteile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Bestellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_05" name="KVA freigegeben">
      <bpmn:outgoing>Flow_05_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T05_Teileliste" name="Teileliste aus KVA übernehmen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t05_teileliste" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_3</bpmn:incoming>
      <bpmn:outgoing>Flow_05_4</bpmn:outgoing>
      <bpmn:property id="T05_Teileliste_prop_DataObjRef_05_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T05_Teileliste_in_DataObjRef_05_1">
        <bpmn:sourceRef>DataObjRef_05_1</bpmn:sourceRef>
        <bpmn:targetRef>T05_Teileliste_prop_DataObjRef_05_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="T05_Teileliste_prop_DataStore_05_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T05_Teileliste_in_DataStore_05_1">
        <bpmn:sourceRef>DataStore_05_1</bpmn:sourceRef>
        <bpmn:targetRef>T05_Teileliste_prop_DataStore_05_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T05_Vorreservierung" name="Vorreservierungen übernehmen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t05_vorreservierung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_4</bpmn:incoming>
      <bpmn:outgoing>Flow_05_30</bpmn:outgoing>
      <bpmn:property id="T05_Vorreservierung_prop_DataObjRef_05_5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T05_Vorreservierung_in_DataObjRef_05_5">
        <bpmn:sourceRef>DataObjRef_05_5</bpmn:sourceRef>
        <bpmn:targetRef>T05_Vorreservierung_prop_DataObjRef_05_5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Sub_05" name="Verfügbarkeit je Ersatzteil prüfen" triggeredByEvent="false">
      <bpmn:incoming>Flow_05_30</bpmn:incoming>
      <bpmn:outgoing>Flow_05_17</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=offeneErsatzteile" inputElement="ersatzteil" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="S05_Start" name="Ersatzteil ausgewählt">
        <bpmn:outgoing>Flow_05_5</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="S05_Eigen" name="Bestand eigene Filiale prüfen">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="repairflow.s05_eigen" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_05_5</bpmn:incoming>
        <bpmn:outgoing>Flow_05_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="GW05_Eigen" name="Eigener Bestand ausreichend?">
        <bpmn:incoming>Flow_05_6</bpmn:incoming>
        <bpmn:outgoing>Flow_05_7</bpmn:outgoing>
        <bpmn:outgoing>Flow_05_8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="S05_Reservieren" name="Teil in eigener Filiale reservieren">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="repairflow.s05_reservieren" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_05_7</bpmn:incoming>
        <bpmn:outgoing>Flow_05_13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S05_Andere" name="Bestand anderer Filialen prüfen">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="repairflow.s05_andere" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_05_8</bpmn:incoming>
        <bpmn:outgoing>Flow_05_9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="GW05_Andere" name="In anderer Filiale verfügbar?">
        <bpmn:incoming>Flow_05_9</bpmn:incoming>
        <bpmn:outgoing>Flow_05_10</bpmn:outgoing>
        <bpmn:outgoing>Flow_05_11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="S05_ResAndere" name="Teil in anderer Filiale reservieren">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="repairflow.s05_resandere" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_05_10</bpmn:incoming>
        <bpmn:outgoing>Flow_05_12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="S05_Umlagerung" name="Umlagerung anfordern">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="form-s05_umlagerung" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_05_12</bpmn:incoming>
        <bpmn:outgoing>Flow_05_14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="S05_Fehlteil" name="Teil als Fehlteil markieren">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="repairflow.s05_fehlteil" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_05_11</bpmn:incoming>
        <bpmn:outgoing>Flow_05_15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="S05_Join" name="">
        <bpmn:incoming>Flow_05_13</bpmn:incoming>
        <bpmn:incoming>Flow_05_14</bpmn:incoming>
        <bpmn:incoming>Flow_05_15</bpmn:incoming>
        <bpmn:outgoing>Flow_05_16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="S05_End" name="Teil disponiert">
        <bpmn:incoming>Flow_05_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_05_5" sourceRef="S05_Start" targetRef="S05_Eigen" />
      <bpmn:sequenceFlow id="Flow_05_6" sourceRef="S05_Eigen" targetRef="GW05_Eigen" />
      <bpmn:sequenceFlow id="Flow_05_7" sourceRef="GW05_Eigen" targetRef="S05_Reservieren" name="ja">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bestandAusreichend</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_05_8" sourceRef="GW05_Eigen" targetRef="S05_Andere" name="nein">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(bestandAusreichend)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_05_9" sourceRef="S05_Andere" targetRef="GW05_Andere" />
      <bpmn:sequenceFlow id="Flow_05_10" sourceRef="GW05_Andere" targetRef="S05_ResAndere" name="ja">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=andereFilialeVerfuegbar</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_05_11" sourceRef="GW05_Andere" targetRef="S05_Fehlteil" name="nein">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(andereFilialeVerfuegbar)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_05_12" sourceRef="S05_ResAndere" targetRef="S05_Umlagerung" />
      <bpmn:sequenceFlow id="Flow_05_13" sourceRef="S05_Reservieren" targetRef="S05_Join" />
      <bpmn:sequenceFlow id="Flow_05_14" sourceRef="S05_Umlagerung" targetRef="S05_Join" />
      <bpmn:sequenceFlow id="Flow_05_15" sourceRef="S05_Fehlteil" targetRef="S05_Join" />
      <bpmn:sequenceFlow id="Flow_05_16" sourceRef="S05_Join" targetRef="S05_End" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="T05_Bestaetigen" name="Reservierungen bestätigen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t05_bestaetigen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_17</bpmn:incoming>
      <bpmn:outgoing>Flow_05_18</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T05_Bestaetigen_out_DataObjRef_05_2">
        <bpmn:targetRef>DataObjRef_05_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T05_Meldebestand" name="Meldebestand prüfen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.meldebestand" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_18</bpmn:incoming>
      <bpmn:outgoing>Flow_05_19</bpmn:outgoing>
      <bpmn:property id="T05_Meldebestand_prop_DataObjRef_05_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T05_Meldebestand_in_DataObjRef_05_3">
        <bpmn:sourceRef>DataObjRef_05_3</bpmn:sourceRef>
        <bpmn:targetRef>T05_Meldebestand_prop_DataObjRef_05_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW05_Meldebestand" name="Meldebestand unterschritten?">
      <bpmn:incoming>Flow_05_19</bpmn:incoming>
      <bpmn:outgoing>Flow_05_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_05_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T05_Nachbestellung" name="Nachbestellvorschlag erzeugen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t05_nachbestellung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_20</bpmn:incoming>
      <bpmn:outgoing>Flow_05_22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T05_Nachbestellung_out_DataObjRef_05_4">
        <bpmn:targetRef>DataObjRef_05_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_05m" name="">
      <bpmn:incoming>Flow_05_21</bpmn:incoming>
      <bpmn:incoming>Flow_05_22</bpmn:incoming>
      <bpmn:outgoing>Flow_05_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T05_Beginn" name="Voraussichtlichen Reparaturbeginn ermitteln">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t05_beginn" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_23</bpmn:incoming>
      <bpmn:outgoing>Flow_05_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T05_Info" name="Kunde über Reparaturbeginn informieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t05_info" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_24</bpmn:incoming>
      <bpmn:outgoing>Flow_05_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW05_Fehlteile" name="Fehlteile vorhanden?">
      <bpmn:incoming>Flow_05_25</bpmn:incoming>
      <bpmn:outgoing>Flow_05_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_05_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="T05_Bestellen" name="06 Ersatzteile bestellen">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_06" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:output source="=teileVollstaendig" target="teileVollstaendig" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05_26</bpmn:incoming>
      <bpmn:outgoing>Flow_05_28</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Join_05" name="">
      <bpmn:incoming>Flow_05_27</bpmn:incoming>
      <bpmn:incoming>Flow_05_28</bpmn:incoming>
      <bpmn:outgoing>Flow_05_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_05" name="Ersatzteile disponiert">
      <bpmn:incoming>Flow_05_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_05_3" sourceRef="Start_05" targetRef="T05_Teileliste" />
    <bpmn:sequenceFlow id="Flow_05_4" sourceRef="T05_Teileliste" targetRef="T05_Vorreservierung" />
    <bpmn:sequenceFlow id="Flow_05_30" sourceRef="T05_Vorreservierung" targetRef="Sub_05" />
    <bpmn:sequenceFlow id="Flow_05_17" sourceRef="Sub_05" targetRef="T05_Bestaetigen" />
    <bpmn:sequenceFlow id="Flow_05_18" sourceRef="T05_Bestaetigen" targetRef="T05_Meldebestand" />
    <bpmn:sequenceFlow id="Flow_05_19" sourceRef="T05_Meldebestand" targetRef="GW05_Meldebestand" />
    <bpmn:sequenceFlow id="Flow_05_20" sourceRef="GW05_Meldebestand" targetRef="T05_Nachbestellung" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=meldebestandUnterschritten</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05_21" sourceRef="GW05_Meldebestand" targetRef="Join_05m" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(meldebestandUnterschritten)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05_22" sourceRef="T05_Nachbestellung" targetRef="Join_05m" />
    <bpmn:sequenceFlow id="Flow_05_23" sourceRef="Join_05m" targetRef="T05_Beginn" />
    <bpmn:sequenceFlow id="Flow_05_24" sourceRef="T05_Beginn" targetRef="T05_Info" />
    <bpmn:sequenceFlow id="Flow_05_25" sourceRef="T05_Info" targetRef="GW05_Fehlteile" />
    <bpmn:sequenceFlow id="Flow_05_26" sourceRef="GW05_Fehlteile" targetRef="T05_Bestellen" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fehlteileVorhanden</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05_27" sourceRef="GW05_Fehlteile" targetRef="Join_05" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(fehlteileVorhanden)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05_28" sourceRef="T05_Bestellen" targetRef="Join_05" />
    <bpmn:sequenceFlow id="Flow_05_29" sourceRef="Join_05" targetRef="End_05" />
    <bpmn:dataObjectReference id="DataObjRef_05_1" name="Kosten-voranschlag [freigegeben]" dataObjectRef="DataObj_05_1" />
    <bpmn:dataObject id="DataObj_05_1" />
    <bpmn:dataObjectReference id="DataObjRef_05_2" name="Ersatzteil-Reservierung [reserviert]" dataObjectRef="DataObj_05_2" />
    <bpmn:dataObject id="DataObj_05_2" />
    <bpmn:dataObjectReference id="DataObjRef_05_3" name="Lagerbestand" dataObjectRef="DataObj_05_3" />
    <bpmn:dataObject id="DataObj_05_3" />
    <bpmn:dataObjectReference id="DataObjRef_05_4" name="Lieferanten-bestellung [Vorschlag]" dataObjectRef="DataObj_05_4" />
    <bpmn:dataObject id="DataObj_05_4" />
    <bpmn:dataObjectReference id="DataObjRef_05_5" name="Ersatzteil-Reservierung [vorreserviert]" dataObjectRef="DataObj_05_5" />
    <bpmn:dataObject id="DataObj_05_5" />
    <bpmn:dataStoreReference id="DataStore_05_1" name="RepairFlow-Datenbank" dataStoreRef="Store_05_1" />
  </bpmn:process>
  <bpmn:process id="Proc_05_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K05_Start" name="Reparaturbeginn erhalten">
      <bpmn:outgoing>Flow_05_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K05_Start_def" messageRef="Msg_05_1" />
    </bpmn:startEvent>
    <bpmn:manualTask id="K05_Vormerken" name="Reparaturbeginn vormerken">
      <bpmn:incoming>Flow_05_1</bpmn:incoming>
      <bpmn:outgoing>Flow_05_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="K05_End" name="Termin bekannt">
      <bpmn:incoming>Flow_05_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_05_1" sourceRef="K05_Start" targetRef="K05_Vormerken" />
    <bpmn:sequenceFlow id="Flow_05_2" sourceRef="K05_Vormerken" targetRef="K05_End" />
  </bpmn:process>
  <bpmn:dataStore id="Store_05_1" name="RepairFlow-Datenbank" />
  <bpmn:message id="Msg_05_1" name="Voraussichtlicher Reparaturbeginn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_05">
    <bpmndi:BPMNPlane id="Plane_05" bpmnElement="Collab_05">
      <bpmndi:BPMNShape id="Part_05_Werkstatt_di" bpmnElement="Part_05_Werkstatt" isHorizontal="true">
        <dc:Bounds x="120" y="360" width="4415" height="705" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_05_1_di" bpmnElement="Lane_05_1" isHorizontal="true">
        <dc:Bounds x="150" y="360" width="4385" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_05_2_di" bpmnElement="Lane_05_2" isHorizontal="true">
        <dc:Bounds x="150" y="530" width="4385" height="535" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_05_Kunde_di" bpmnElement="Part_05_Kunde" isHorizontal="true">
        <dc:Bounds x="120" y="55" width="4415" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_05_di" bpmnElement="Sub_05" isExpanded="true">
        <dc:Bounds x="767" y="582" width="1616" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_05_di" bpmnElement="Start_05">
        <dc:Bounds x="227" y="650" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="692" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T05_Teileliste_di" bpmnElement="T05_Teileliste">
        <dc:Bounds x="370" y="628" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S05_Start_di" bpmnElement="S05_Start">
        <dc:Bounds x="797" y="650" width="36" height="36" />
