    <bpmn:sequenceFlow id="Flow_01_40" sourceRef="E01_Bestaetigt" targetRef="T01_Markieren"/>
    <bpmn:sequenceFlow id="Flow_01_35" sourceRef="GW01_Warten" targetRef="E01_Timer"/>
    <bpmn:sequenceFlow id="Flow_01_34" sourceRef="GW01_Warten" targetRef="E01_Abgelehnt"/>
    <bpmn:sequenceFlow id="Flow_01_33" sourceRef="GW01_Warten" targetRef="E01_Bestaetigt"/>
    <bpmn:sequenceFlow id="Flow_01_32" sourceRef="T01_Senden" targetRef="GW01_Warten"/>
    <bpmn:sequenceFlow id="Flow_01_31" sourceRef="T01_Termin" targetRef="T01_Senden"/>
    <bpmn:sequenceFlow id="Flow_01_30" sourceRef="T01_Verfuegbarkeit" targetRef="T01_Termin"/>
    <bpmn:sequenceFlow id="Flow_01_29" sourceRef="T01_VorabKVA" targetRef="T01_Verfuegbarkeit"/>
    <bpmn:sequenceFlow id="Flow_01_28" sourceRef="T01_KI" targetRef="T01_VorabKVA"/>
    <bpmn:sequenceFlow id="Flow_01_27" sourceRef="E01_Timer1" targetRef="Merge_01t"/>
    <bpmn:sequenceFlow id="Flow_01_25" sourceRef="GW01_Antwort" targetRef="E01_Timer1"/>
    <bpmn:sequenceFlow id="Flow_01_24" sourceRef="GW01_Antwort" targetRef="E01_Neu"/>
    <bpmn:sequenceFlow id="Flow_01_23" sourceRef="T01_Rueckfrage" targetRef="GW01_Antwort"/>
    <bpmn:sequenceFlow id="Flow_01_22" name="nein" sourceRef="GW01_Auswertbar" targetRef="T01_Rueckfrage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(medienAuswertbar)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_01_21" name="ja" sourceRef="GW01_Auswertbar" targetRef="T01_KI">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=medienAuswertbar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_01_20" sourceRef="T01_Medien" targetRef="GW01_Auswertbar"/>
    <bpmn:sequenceFlow id="Flow_01_19" sourceRef="Merge_01" targetRef="T01_Medien"/>
    <bpmn:sequenceFlow id="Flow_01_26" sourceRef="E01_Neu" targetRef="Merge_01"/>
    <bpmn:sequenceFlow id="Flow_01_18" sourceRef="T01_Voranmeldung" targetRef="Merge_01"/>
    <bpmn:sequenceFlow id="Flow_01_17" sourceRef="Start_01" targetRef="T01_Voranmeldung"/>
    <bpmn:dataStoreReference id="DataStore_01_1" name="RepairFlow-Datenbank" dataStoreRef="Store_01_1"/>
    <bpmn:dataObjectReference id="DataObjRef_01_5" name="Ersatzteil-Reservierung [vorreserviert]" dataObjectRef="DataObj_01_5"/>
    <bpmn:dataObject id="DataObj_01_5"/>
    <bpmn:dataObjectReference id="DataObjRef_01_4" name="Kosten-voranschlag [vorläufig]" dataObjectRef="DataObj_01_4"/>
    <bpmn:dataObject id="DataObj_01_4"/>
    <bpmn:dataObjectReference id="DataObjRef_01_3" name="KI-Diagnose-vorschlag" dataObjectRef="DataObj_01_3"/>
    <bpmn:dataObject id="DataObj_01_3"/>
    <bpmn:dataObjectReference id="DataObjRef_01_2" name="Medienanhang" dataObjectRef="DataObj_01_2"/>
    <bpmn:dataObject id="DataObj_01_2"/>
    <bpmn:dataObjectReference id="DataObjRef_01_2b" name="Medienanhang" dataObjectRef="DataObj_01_2"/><bpmn:dataObjectReference id="DataObjRef_01_4b" name="Kosten-voranschlag [vorläufig]" dataObjectRef="DataObj_01_4"/><bpmn:dataObjectReference id="DataObjRef_01_1" name="Voranmeldung" dataObjectRef="DataObj_01_1"/>
    <bpmn:dataObject id="DataObj_01_1"/>
    <bpmn:endEvent id="End_01" name="Sofortdiagnose abgeschlossen">
      <bpmn:incoming>Flow_01_44</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Join_01" name="">
      <bpmn:incoming>Flow_01_43</bpmn:incoming><bpmn:incoming>Flow_01_39</bpmn:incoming><bpmn:outgoing>Flow_01_44</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="T01_Bestaetigung" name="Bestätigung an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_bestaetigung"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_51</bpmn:incoming><bpmn:outgoing>Flow_01_43</bpmn:outgoing></bpmn:sendTask>
    <bpmn:serviceTask id="T01_Reservieren" name="Ersatzteile vorreservieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_reservieren"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_41</bpmn:incoming><bpmn:outgoing>Flow_01_42</bpmn:outgoing><bpmn:dataOutputAssociation id="T01_Reservieren_out_DataObjRef_01_5">
        <bpmn:targetRef>DataObjRef_01_5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T01_Markieren" name="Voranmeldung als bestätigt markieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_markieren"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_40</bpmn:incoming><bpmn:outgoing>Flow_01_41</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T01_Verwerfen" name="Voranmeldung verwerfen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_verwerfen"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_38</bpmn:incoming><bpmn:outgoing>Flow_01_39</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_01v" name="">
      <bpmn:incoming>Flow_01_36</bpmn:incoming><bpmn:incoming>Flow_01_47</bpmn:incoming><bpmn:outgoing>Flow_01_38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="E01_Timer" name="7 Tage ohne Antwort verstrichen">
      <bpmn:incoming>Flow_01_35</bpmn:incoming><bpmn:outgoing>Flow_01_37</bpmn:outgoing><bpmn:timerEventDefinition id="E01_Timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E01_Abgelehnt" name="Voranmeldung abgelehnt">
      <bpmn:incoming>Flow_01_34</bpmn:incoming><bpmn:outgoing>Flow_01_36</bpmn:outgoing><bpmn:messageEventDefinition id="E01_Abgelehnt_def" messageRef="Msg_01_4"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E01_Bestaetigt" name="Voranmeldung bestätigt">
      <bpmn:incoming>Flow_01_33</bpmn:incoming><bpmn:outgoing>Flow_01_40</bpmn:outgoing><bpmn:messageEventDefinition id="E01_Bestaetigt_def" messageRef="Msg_01_3"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="GW01_Warten" name="">
      <bpmn:incoming>Flow_01_32</bpmn:incoming><bpmn:outgoing>Flow_01_35</bpmn:outgoing><bpmn:outgoing>Flow_01_34</bpmn:outgoing><bpmn:outgoing>Flow_01_33</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:sendTask id="T01_Senden" name="Sofortdiagnose an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_senden"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_31</bpmn:incoming><bpmn:outgoing>Flow_01_32</bpmn:outgoing><bpmn:property id="T01_Senden_prop_DataObjRef_01_4b" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="T01_Senden_in_DataObjRef_01_4b"><bpmn:sourceRef>DataObjRef_01_4b</bpmn:sourceRef><bpmn:targetRef>T01_Senden_prop_DataObjRef_01_4b</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:sendTask>
    <bpmn:serviceTask id="T01_Termin" name="Filiale und Terminvorschlag ermitteln">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_termin"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_30</bpmn:incoming><bpmn:outgoing>Flow_01_31</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T01_Verfuegbarkeit" name="Verfügbarkeit in allen Filialen prüfen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_verfuegbarkeit"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_29</bpmn:incoming><bpmn:outgoing>Flow_01_30</bpmn:outgoing><bpmn:property id="T01_Verfuegbarkeit_prop_DataStore_01_1" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="T01_Verfuegbarkeit_in_DataStore_01_1">
        <bpmn:sourceRef>DataStore_01_1</bpmn:sourceRef>
        <bpmn:targetRef>T01_Verfuegbarkeit_prop_DataStore_01_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T01_VorabKVA" name="Vorab-Kostenvoranschlag berechnen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_vorabkva"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_28</bpmn:incoming><bpmn:outgoing>Flow_01_29</bpmn:outgoing><bpmn:property id="T01_VorabKVA_prop_DataObjRef_01_3" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="T01_VorabKVA_in_DataObjRef_01_3"><bpmn:sourceRef>DataObjRef_01_3</bpmn:sourceRef><bpmn:targetRef>T01_VorabKVA_prop_DataObjRef_01_3</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="T01_VorabKVA_out_DataObjRef_01_4">
        <bpmn:targetRef>DataObjRef_01_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T01_KI" name="KI-Diagnosevorschlag erstellen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.ki-diagnose"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_21</bpmn:incoming><bpmn:outgoing>Flow_01_28</bpmn:outgoing><bpmn:property id="T01_KI_prop_DataObjRef_01_2b" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="T01_KI_in_DataObjRef_01_2b"><bpmn:sourceRef>DataObjRef_01_2b</bpmn:sourceRef><bpmn:targetRef>T01_KI_prop_DataObjRef_01_2b</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="T01_KI_out_DataObjRef_01_3">
        <bpmn:targetRef>DataObjRef_01_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="E01_Timer1" name="7 Tage ohne neue Aufnahme verstrichen">
      <bpmn:incoming>Flow_01_25</bpmn:incoming><bpmn:outgoing>Flow_01_27</bpmn:outgoing><bpmn:timerEventDefinition id="E01_Timer1_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E01_Neu" name="Neue Aufnahme erhalten">
      <bpmn:incoming>Flow_01_24</bpmn:incoming><bpmn:outgoing>Flow_01_26</bpmn:outgoing><bpmn:messageEventDefinition id="E01_Neu_def" messageRef="Msg_01_2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="GW01_Antwort" name="">
      <bpmn:incoming>Flow_01_23</bpmn:incoming><bpmn:outgoing>Flow_01_25</bpmn:outgoing><bpmn:outgoing>Flow_01_24</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:sendTask id="T01_Rueckfrage" name="Bessere Aufnahme anfordern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_rueckfrage"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_22</bpmn:incoming><bpmn:outgoing>Flow_01_23</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW01_Auswertbar" name="Medien auswertbar?">
      <bpmn:incoming>Flow_01_20</bpmn:incoming><bpmn:outgoing>Flow_01_22</bpmn:outgoing><bpmn:outgoing>Flow_01_21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T01_Medien" name="Medienanhang prüfen und speichern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_medien"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_19</bpmn:incoming><bpmn:outgoing>Flow_01_20</bpmn:outgoing><bpmn:dataOutputAssociation id="T01_Medien_out_DataObjRef_01_2">
        <bpmn:targetRef>DataObjRef_01_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_01" name="">
      <bpmn:incoming>Flow_01_26</bpmn:incoming><bpmn:incoming>Flow_01_18</bpmn:incoming><bpmn:outgoing>Flow_01_19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T01_Voranmeldung" name="Voranmeldung anlegen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t01_voranmeldung"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01_17</bpmn:incoming><bpmn:outgoing>Flow_01_18</bpmn:outgoing><bpmn:dataOutputAssociation id="T01_Voranmeldung_out_DataObjRef_01_1">
        <bpmn:targetRef>DataObjRef_01_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_01" name="Anfrage eingegangen">
      <bpmn:outgoing>Flow_01_17</bpmn:outgoing><bpmn:messageEventDefinition id="Start_01_def" messageRef="Msg_01_1"/>
