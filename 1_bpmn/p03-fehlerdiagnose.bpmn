      <bpmn:incoming>Flow_03_18</bpmn:incoming>
      <bpmn:incoming>Flow_03_20</bpmn:incoming>
      <bpmn:outgoing>Flow_03_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_03" name="Diagnose abgeschlossen">
      <bpmn:incoming>Flow_03_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03_3" sourceRef="Start_03" targetRef="T03_Status" />
    <bpmn:sequenceFlow id="Flow_03_4" sourceRef="T03_Status" targetRef="GW03_KI" />
    <bpmn:sequenceFlow id="Flow_03_22" sourceRef="GW03_KI" targetRef="T03_KI" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kiVorschlagVorhanden</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_23" sourceRef="GW03_KI" targetRef="Join_03k" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(kiVorschlagVorhanden)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_5" sourceRef="T03_KI" targetRef="Join_03k" />
    <bpmn:sequenceFlow id="Flow_03_24" sourceRef="Join_03k" targetRef="T03_Test" />
    <bpmn:sequenceFlow id="Flow_03_6" sourceRef="T03_Test" targetRef="GW03_Repro" />
