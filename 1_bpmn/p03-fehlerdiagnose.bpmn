    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_8" name="nein" sourceRef="GW03_Repro" targetRef="T03_Erweitert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(fehlerReproduzierbar)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
