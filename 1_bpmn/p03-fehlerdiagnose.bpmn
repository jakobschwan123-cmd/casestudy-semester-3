    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_8" sourceRef="GW03_Repro" targetRef="T03_Erweitert" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(fehlerReproduzierbar)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_9" sourceRef="T03_Erweitert" targetRef="GW03_Gefunden" />
    <bpmn:sequenceFlow id="Flow_03_25" sourceRef="GW03_Gefunden" targetRef="Join_03r" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fehlerGefunden</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_26" sourceRef="GW03_Gefunden" targetRef="Join_03a" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(fehlerGefunden)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_10" sourceRef="Join_03r" targetRef="T03_Befund" />
    <bpmn:sequenceFlow id="Flow_03_11" sourceRef="T03_Befund" targetRef="T03_Teile" />
    <bpmn:sequenceFlow id="Flow_03_12" sourceRef="T03_Teile" targetRef="T03_Wirtschaft" />
    <bpmn:sequenceFlow id="Flow_03_13" sourceRef="T03_Wirtschaft" targetRef="GW03_Wirtschaft" />
    <bpmn:sequenceFlow id="Flow_03_14" sourceRef="GW03_Wirtschaft" targetRef="T03_Aufwand" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reparaturWirtschaftlich</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_15" sourceRef="GW03_Wirtschaft" targetRef="Join_03a" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(reparaturWirtschaftlich)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_27" sourceRef="Join_03a" targetRef="T03_Absage" />
    <bpmn:sequenceFlow id="Flow_03_16" sourceRef="T03_Absage" targetRef="T03_Schliessen" />
    <bpmn:sequenceFlow id="Flow_03_17" sourceRef="T03_Schliessen" targetRef="T03_Abholung" />
    <bpmn:sequenceFlow id="Flow_03_18" sourceRef="T03_Abholung" targetRef="Join_03" />
    <bpmn:sequenceFlow id="Flow_03_19" sourceRef="T03_Aufwand" targetRef="T03_Abschluss" />
    <bpmn:sequenceFlow id="Flow_03_20" sourceRef="T03_Abschluss" targetRef="Join_03" />
    <bpmn:sequenceFlow id="Flow_03_21" sourceRef="Join_03" targetRef="End_03" />
