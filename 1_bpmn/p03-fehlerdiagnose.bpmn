  <bpmn:message id="Msg_03_0" name="Auftrag eingeplant" />
  <bpmn:message id="Msg_03_1" name="Reparaturabsage">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_03">
