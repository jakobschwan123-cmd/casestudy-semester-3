        <bpmn:flowNodeRef>Join_03k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW03_Repro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Erweitert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW03_Gefunden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_03r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Befund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Teile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Aufwand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Wirtschaft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW03_Wirtschaft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Abschluss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev03_KVA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
