@startuml
' BPMN: p05-ersatzteilreservierung.bpmn. Kernablauf: je Teil eigener Bestand, andere Filiale oder Fehlteil; Vorreservierung aus UC01 (E-26).
' Darstellung wie in Visual Paradigm: Objekterzeugung als gestrichelter Pfeil auf den Kopfkasten (Kasten sitzt auf Nachrichtenhöhe, VL 6 Folie 5-70), kein <<create>>-Text.
mainframe sd [sqd: UC09 Ersatzteile disponieren und reservieren]
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor #9FD6F2
  ParticipantBorderColor #2E6E99
  ParticipantFontSize 12
  ActorBackgroundColor white
  ActorBorderColor black
  LifeLineBorderColor #444444
  LifeLineBackgroundColor #9FD6F2
  GroupBorderColor #333333
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  ArrowColor black
}
hide footbox
autonumber "0:"

actor Teiledisponent as D
participant ": Kostenvoranschlag" as KVA
participant ": Reparaturauftrag" as RA
participant "eigen : Lagerbestand" as LB
participant "andere : Lagerbestand" as AL
participant ": ErsatzteilReservierung" as RES
actor Kunde

D -> KVA : getPositionen()
KVA --> D : List<KvaPosition>
opt Vorreservierung aus der Sofortdiagnose vorhanden
    D -> RES : reserviere()
end
loop je noch offenem Ersatzteil
    D -> LB : pruefeVerfuegbarkeit(anzahl)
    LB --> D : verfuegbar
    alt eigener Bestand ausreichend
        D -> RES : reserviere()
        RES -> LB : reserviere(anzahl)
    else andere Filiale hat Bestand (Umlagerung)
        D -> AL : pruefeVerfuegbarkeit(anzahl)
        D -> RES : reserviere()
        RES -> AL : reserviere(anzahl)
    else nirgends verfügbar
        D -> RA : markiereFehlteil(teil, menge)
    end
end
D -> RA : bestaetigeReservierungen()
opt Meldebestand unterschritten (UC12)
    D -> LB : erzeugeNachbestellvorschlag()
end
D -> RA : benachrichtigeKunde("voraussichtlicher Reparaturbeginn")
RA -> Kunde : voraussichtlicher Reparaturbeginn
opt Fehlteile vorhanden
    ref over D, RA : UC10 Lieferantenbestellung auslösen (BPMN 06)
end
@enduml
