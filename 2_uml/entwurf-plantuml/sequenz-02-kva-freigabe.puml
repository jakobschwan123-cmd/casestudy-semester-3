@startuml
' BPMN: p04-kostenvoranschlag.bpmn. Kernablauf: KVA erstellen (UC06), versenden, erinnern, Freigabe oder Ablehnung.
title sqd : UC07 KVA freigeben / ablehnen (BPMN 04)
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
hide footbox

actor Kalkulator
actor Serviceannahme as SM
participant ": Reparaturauftrag" as RA
participant ": Kostenvoranschlag" as KVA
actor Kunde

Kalkulator -> KVA : <<create>> (status = ENTWURF)
loop je Arbeits- oder Ersatzteilposition
    Kalkulator -> KVA : addPosition(p)
end
Kalkulator -> KVA : berechneSumme()
KVA --> Kalkulator : summe
SM -> RA : wechsleStatus(KVA_OFFEN)
SM -> KVA : versendeAnKunde()
KVA -> Kunde : Kostenvoranschlag
loop höchstens zweimal: 3 Tage ohne Antwort
    SM -> KVA : protokolliereErinnerung()
    KVA -> Kunde : Erinnerung
end
alt Freigabe erhalten
    Kunde -> KVA : freigeben()
    KVA -> RA : wechsleStatus(FREIGEGEBEN)
    ref over SM, RA : UC09 Ersatzteile disponieren (BPMN 05)
else Ablehnung erhalten oder dritter Fristablauf
    Kunde -> KVA : ablehnen(grund)
    KVA -> RA : wechsleStatus(ABGELEHNT)
    ref over SM, RA, Kunde : UC15 Abholung mit Diagnosepauschale (BPMN 08)
end
@enduml
