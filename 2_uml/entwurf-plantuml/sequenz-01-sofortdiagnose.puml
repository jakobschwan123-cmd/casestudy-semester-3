@startuml
' BPMN: p01-sofortdiagnose.bpmn. Kernablauf; Rückfragen, Timer und Terminsuche nur als Fragment bzw. in UC17.
' Darstellung wie in Visual Paradigm: Objekterzeugung als gestrichelter Pfeil auf den Kopfkasten (Kasten sitzt auf Nachrichtenhöhe, VL 6 Folie 5-70), kein <<create>>-Text.
mainframe sd [sqd: UC01 Sofortdiagnose anfordern]
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor #9FD6F2
  ParticipantBorderColor #2E6E99
  ParticipantFontSize 12
  ActorBackgroundColor white
  ActorBorderColor black
  LifeLineBorderColor #444444
  LifeLineBackgroundColor #9FD6F2
  GroupBorderColor #333333
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  ArrowColor black
}
hide footbox
autonumber "0:"

actor Kunde
participant ": Voranmeldung" as VA
participant ": Medienanhang" as MA
participant ": KIDiagnosevorschlag" as KI
participant ": Kostenvoranschlag" as KVA
participant ": Lagerbestand" as LB
actor "KI-Diagnosedienst" as KIDienst

create VA
Kunde -->> VA : erstellen(medien, symptome)
loop je Medienanhang
    VA -> MA : analysieren()
    MA --> VA : auswertbar
end
opt Medien nicht auswertbar
    VA -> Kunde : Rückfrage: bessere Aufnahme senden
    Kunde -> VA : speichereMedien(medien)
    break 7 Tage ohne neue Aufnahme
        VA -> VA : verwerfen()
    end
end
create KI
VA -->> KI : auswerten(medien)
KI -> KIDienst : Medien und Symptome
KIDienst --> KI : Diagnosevorschlag
VA -> KI : erzeugeVorabKva()
create KVA
KI -->> KVA : berechneSumme()
loop je benötigtem Ersatzteil und Filiale
    VA -> LB : pruefeVerfuegbarkeit(anzahl)
end
VA -> Kunde : Diagnosevorschlag, Vorab-KVA, Termin
alt Kunde bestätigt innerhalb 7 Tagen (UC02)
    Kunde -> VA : bestaetigen()
    VA -> LB : reserviere(anzahl)
else Ablehnung oder 7 Tage ohne Antwort
    VA -> VA : verwerfen()
end
@enduml
