@startuml
' BPMN: p06-ersatzteilbestellung.bpmn. Kernablauf: bündeln, freigeben, bestellen, bestätigen oder stornieren, höchstens zwei Mahnungen (E-22, E-27).
' Lieferant ist Black Box ohne Systemzugang (E-24): kein Akteur, Nachrichten an ihn gehen über Gates am Rahmen.
' Darstellung wie in Visual Paradigm: Objekterzeugung als gestrichelter Pfeil auf den Kopfkasten (Kasten sitzt auf Nachrichtenhöhe, VL 6 Folie 5-70), kein <<create>>-Text.
mainframe sd [sqd: UC10 Lieferantenbestellung auslösen]
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor #9FD6F2
  ParticipantBorderColor #2E6E99
  ParticipantFontSize 12
  ActorBackgroundColor white
  ActorBorderColor black
  LifeLineBorderColor #444444
  LifeLineBackgroundColor #9FD6F2
  GroupBorderColor #333333
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  ArrowColor black
}
hide footbox
autonumber "0:"

actor "Einkäufer" as E
participant ": Ersatzteil" as ET
participant ": Lieferantenbestellung" as BEST
participant ": Reparaturauftrag" as RA
participant ": Werkstattleiter" as WL

E -> ET : getVorzugslieferant()
ET --> E : Lieferant
create BEST
E -->> BEST : new(status = OFFEN)
loop je Fehlteil und Nachbestellvorschlag
    E -> BEST : addPosition(teil, menge)
end
E -> BEST : berechneBestellwert()
opt Bestellwert über Freigabegrenze
    E -> WL : gibBestellungFrei(b)
    WL -> BEST : freigeben()
end
E -> BEST : uebermittle()
BEST ->] : Bestellung (an Lieferant)
BEST <--] : Auftragsbestätigung (vom Lieferanten)
alt bestätigt und lieferbar
    E -> BEST : bestaetige(liefertermin)
    E -> RA : wechsleStatus(TEILE_BESTELLT)
    loop bis Lieferung, höchstens zwei Mahnungen je 14 Tage
        E -> BEST : mahne()
        BEST ->] : Mahnung (an Lieferant)
    end
    ref over E, BEST : UC11 Wareneingang buchen; bei Mangel UC19 Retoure abwickeln (BPMN 10)
else nicht lieferbar, keine Bestätigung oder zweite Mahnung ohne Lieferung
    E -> BEST : storniere()
    BEST ->] : Stornierung (an Lieferant)
    note over E, BEST : alternativer Lieferant oder Abschluss ohne Lieferung
end
@enduml
