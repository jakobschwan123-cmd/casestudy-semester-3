@startuml
' BPMN: p06-ersatzteilbestellung.bpmn. Kernablauf: bündeln, freigeben, bestellen, bestätigen oder stornieren, höchstens zwei Mahnungen (E-22, E-27).
title sqd : UC10 Lieferantenbestellung auslösen (BPMN 06)
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
hide footbox

actor "Einkäufer" as E
participant ": Ersatzteil" as ET
participant ": Lieferantenbestellung" as BEST
participant ": Reparaturauftrag" as RA
actor Werkstattleiter as WL
actor Lieferant

E -> ET : getVorzugslieferant()
ET --> E : Lieferant
E -> BEST : <<create>> (status = OFFEN)
loop je Fehlteil und Nachbestellvorschlag
    E -> BEST : addPosition(teil, menge)
end
E -> BEST : berechneBestellwert()
opt Bestellwert über Freigabegrenze
    E -> WL : Bestellfreigabe anfordern
    WL -> BEST : freigeben()
end
E -> BEST : uebermittle()
BEST -> Lieferant : Bestellung
Lieferant --> BEST : Auftragsbestätigung
alt bestätigt und lieferbar
    E -> BEST : bestaetige(liefertermin)
    E -> RA : wechsleStatus(TEILE_BESTELLT)
    loop bis Lieferung, höchstens zwei Mahnungen je 14 Tage
        BEST -> Lieferant : Mahnung
    end
    ref over E, BEST, Lieferant : UC11 Wareneingang buchen; bei Mangel UC19 Retoure abwickeln (BPMN 10)
else nicht lieferbar, keine Bestätigung oder zweite Mahnung ohne Lieferung
    E -> BEST : storniere()
    BEST -> Lieferant : Stornierung
    note over E, BEST : alternativer Lieferant oder Abschluss ohne Lieferung
end
@enduml
