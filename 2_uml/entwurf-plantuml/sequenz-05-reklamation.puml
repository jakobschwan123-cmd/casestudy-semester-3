@startuml
' BPMN: p09-reklamation.bpmn. Kernablauf: Mangel prüfen, Gewährleistung oder Angebot, Nacharbeitsauftrag, Abschluss.
' Darstellung wie in Visual Paradigm: Objekterzeugung als gestrichelter Pfeil auf den Kopfkasten (Kasten sitzt auf Nachrichtenhöhe, VL 6 Folie 5-70), kein <<create>>-Text.
mainframe sd [sqd: UC16 Reklamation bearbeiten]
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 170
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor #9FD6F2
  ParticipantBorderColor #2E6E99
  ParticipantFontSize 12
  ActorBackgroundColor white
  ActorBorderColor black
  LifeLineBorderColor #444444
  LifeLineBackgroundColor #9FD6F2
  GroupBorderColor #333333
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  ArrowColor black
}
hide footbox
autonumber "0:"

actor Reklamationsbearbeiter as SM
actor Kunde
participant ": Reklamation" as REK
actor Diagnostiker
participant ": Werkstattleiter" as WL
participant "nacharbeit : Reparaturauftrag" as NA

Kunde -> SM : Mangelmeldung (Auftrag, Beschreibung)
create REK
SM -->> REK : new(auftrag, grund)
note right of REK : erfasseReklamation() des\nServicemitarbeiters erzeugt das Objekt
Diagnostiker -> REK : pruefeGewaehrleistung()
REK --> Diagnostiker : istGewaehrleistung
alt Gewährleistungsfall
    Diagnostiker -> WL : entscheideReklamation(r)
    WL --> Diagnostiker : Nacharbeit freigegeben
else kein Gewährleistungsfall
    SM -> Kunde : kostenpflichtiges Angebot
    Kunde --> SM : Annahme oder Ablehnung
end
alt Nacharbeit freigegeben oder Angebot angenommen
    Diagnostiker -> REK : legeNacharbeitAn(kostenfrei)
    create NA
    REK -->> NA : new()
    ref over Diagnostiker, NA : UC13 / UC14 Nacharbeit durchführen (BPMN 07)
else Angebot abgelehnt
    SM -> REK : ablehnen()
end
SM -> REK : schliesseAb()
note over Kunde, NA : Abholung und Abrechnung über UC15 (BPMN 08)
@enduml
