@startuml
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam usecaseFontSize 11
skinparam actorStyle awesome
skinparam actorFontSize 10
skinparam nodesep 10
skinparam ranksep 50
title ud : RepairFlow – Use-Case-Diagramm (je Use Case eine Rolle)

' Lieferant ist kein Akteur (Black Box ohne Systemzugang, Dozentenhinweis 15.10.2026); Kommunikation nur per Nachricht in BPMN.
' Rollen der Mitarbeiter; Zuordnung zu Servicemitarbeiter, Techniker, Disponent und Werkstattleiter in Doku 5.3
actor "Kunde" as K1
actor "Kunde" as K2
actor "Kunde" as K3
actor "Serviceannahme" as R03
actor "Diagnoseprüfer" as R04
actor "Diagnostiker" as R05
actor "Kalkulator" as R06
actor "Reparateur" as R13
actor "Endkontrolleur" as R14
actor "Geräteausgabe" as R15
actor "Reklamationsbearbeiter" as R16
actor "Werkstattplaner" as R17
actor "Teiledisponent" as R09
actor "Einkäufer" as R10
actor "Wareneingang" as R11
actor "Bestandsplaner" as R12
actor "Retourenbearbeiter" as R19
actor "Betriebsadministrator" as R18

rectangle "RepairFlow" {
  rectangle "Kundenportal (App)" {
    usecase "UC01\nSofortdiagnose anfordern" as UC01
    usecase "UC02\nVoranmeldung bestätigen" as UC02
    usecase "UC07\nKVA freigeben / ablehnen" as UC07
  }
  rectangle "Auftrag und Werkstatt" {
    usecase "UC03\nReparaturauftrag anlegen" as UC03
    usecase "UC04\nDiagnosevorschlag prüfen" as UC04
    usecase "UC05\nDiagnosebefund erfassen" as UC05
    usecase "UC06\nKVA erstellen" as UC06
    usecase "UC13\nReparaturschritt und Arbeitszeit erfassen" as UC13
    usecase "UC14\nAuftrag fertigmelden" as UC14
    usecase "UC15\nAbholung und Abrechnung abwickeln" as UC15
    usecase "UC16\nReklamation bearbeiten" as UC16
    usecase "UC17\nWerkstatttermin planen und Techniker zuweisen" as UC17
  }
  rectangle "Ersatzteil-Disposition" {
    usecase "UC08\nErsatzteil-Verfügbarkeit prüfen" as UC08
    usecase "UC09\nErsatzteile disponieren und reservieren" as UC09
    usecase "UC10\nLieferantenbestellung auslösen" as UC10
    usecase "UC11\nWareneingang buchen" as UC11
    usecase "UC12\nNachbestellvorschlag erzeugen" as UC12
    usecase "UC19\nRetoure abwickeln" as UC19
  }
  rectangle "Administration" {
    usecase "UC18\nWerkstattbetrieb und Filialen verwalten" as UC18
  }
}

actor "KI-Diagnosedienst" as KIDienst <<extern>>

K1 -right- UC01
K2 -right- UC02
K3 -right- UC07
R03 -right- UC03
R04 -right- UC04
R05 -right- UC05
R06 -right- UC06
R13 -right- UC13
R14 -right- UC14
R15 -right- UC15
R16 -right- UC16
R17 -right- UC17
R09 -right- UC09
R10 -right- UC10
R11 -right- UC11
R12 -right- UC12
R19 -right- UC19
R18 -right- UC18
UC01 -right- KIDienst

K1 -[hidden]down- K2
K2 -[hidden]down- K3
K3 -[hidden]down- R03
R03 -[hidden]down- R04
R04 -[hidden]down- R05
R05 -[hidden]down- R06
R06 -[hidden]down- R13
R13 -[hidden]down- R14
R14 -[hidden]down- R15
R15 -[hidden]down- R16
R16 -[hidden]down- R17
R17 -[hidden]down- R09
R09 -[hidden]down- R10
R10 -[hidden]down- R11
R11 -[hidden]down- R12
R12 -[hidden]down- R19
R19 -[hidden]down- R18

UC01 ..> UC08 : <<include>>
UC09 ..> UC08 : <<include>>
UC02 ..> UC01 : <<extend>>\n[Kunde bestätigt Voranmeldung]
UC10 ..> UC09 : <<extend>>\n[Fehlteile vorhanden]
UC12 ..> UC09 : <<extend>>\n[Meldebestand unterschritten]
UC03 ..> UC16 : <<extend>>\n[Nacharbeit freigegeben oder Angebot angenommen]
UC19 ..> UC11 : <<extend>>\n[Lieferung mangelhaft]
UC19 ..> UC16 : <<extend>>\n[Lieferantenteil defekt]
@enduml
