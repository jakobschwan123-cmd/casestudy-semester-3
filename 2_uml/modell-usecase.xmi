  <uml:Model xmi:id="model_RepairFlow" name="RepairFlow">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_usecases" name="Anwendungsfallmodell">
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_Kunde" name="Kunde">
