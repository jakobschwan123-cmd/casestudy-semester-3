      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_Reparateur" name="Reparateur">
        <ownedComment xmi:type="uml:Comment" xmi:id="cmt_831" body="Mitarbeiterrolle (Techniker): führt Reparaturschritte aus und bucht Arbeitszeit"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_Endkontrolleur" name="Endkontrolleur">
