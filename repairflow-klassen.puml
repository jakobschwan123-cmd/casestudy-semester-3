@startuml RepairFlow-Klassen
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide circle
title RepairFlow — Klassendiagramm (FixWerk GmbH)

' ============================================================
' ENUMS
' ============================================================

enum AuftragStatus {
  ANGENOMMEN
  IN_DIAGNOSE
  KVA_OFFEN
  FREIGEGEBEN
  ABGELEHNT
  TEILE_BESTELLT
  IN_REPARATUR
  FERTIG
  ABGEHOLT
}

enum KvaStatus {
  ENTWURF
  VERSENDET
  FREIGEGEBEN
  ABGELEHNT
}

enum ReservierungStatus {
  RESERVIERT
  ENTNOMMEN
  STORNIERT
}

enum BestellStatus {
  OFFEN
  BESTAETIGT
  WARENEINGANG
  STORNIERT
}

enum ZahlungStatus {
  OFFEN
  BEZAHLT
  MAHNUNG
}

enum GeraeteTyp {
  FAHRRAD
  EBIKE
  ELEKTRONIK
}

' ============================================================
' STAMMDATEN / PARTEIEN
' ============================================================

abstract class Person {
  # id : Long
  # name : String
  # telefon : String
  # email : String
  + getKontakt() : String
}

class Kunde {
  - kundennummer : String
  - adresse : String
  + legeAuftragAn(g : Geraet) : Reparaturauftrag
  + gibKvaFrei(kva : Kostenvoranschlag) : void
  + lehneKvaAb(kva : Kostenvoranschlag) : void
}

class Techniker {
  - personalnummer : String
  - qualifikation : String
  + erfasseBefund(a : Reparaturauftrag) : Fehlerbefund
  + bucheArbeitszeit(s : Reparaturschritt, dauer : int) : Arbeitszeitbuchung
}

class Filiale {
  - filialnummer : String
  - name : String
  - adresse : String
  + getAuslastung(von : Date, bis : Date) : double
}

class Lieferant {
  - lieferantennummer : String
  - name : String
  - lieferzeitTage : int
  + erstelleBestellung(pos : List<Bestellposition>) : Lieferantenbestellung
}

' ============================================================
' AUFTRAG / DIAGNOSE / KVA
' ============================================================

class Reparaturauftrag {
  - auftragsnummer : String
  - eingangsdatum : Date
  - status : AuftragStatus
  + wechsleStatus(neu : AuftragStatus) : void
  + fertigmelden() : void
  + benachrichtigeKunde() : void
}

class Geraet {
  - seriennummer : String
  - hersteller : String
  - modell : String
  - typ : GeraeteTyp
}

class Fehlerbefund {
  - befundnummer : String
  - datum : Date
  - beschreibung : String
  - schweregrad : int
  + istReparaturLohnend() : boolean
}

class Kostenvoranschlag {
  - kvaNummer : String
  - erstelldatum : Date
  - gueltigBis : Date
  - status : KvaStatus
  + berechneSumme() : double
  + versendeAnKunde() : void
  + setzeStatus(s : KvaStatus) : void
}

class KvaPosition {
  - bezeichnung : String
  - menge : int
  - einzelpreis : double
  + zwischensumme() : double
}

' ============================================================
' REPARATUR-DURCHFUEHRUNG
' ============================================================

class Reparaturschritt {
  - schrittnummer : int
  - beschreibung : String
  - abgeschlossen : boolean
  + markiereErledigt() : void
}

class Arbeitszeitbuchung {
  - datum : Date
  - dauerMinuten : int
  - stundensatz : double
  + berechneKosten() : double
}

' ============================================================
' ERSATZTEIL / LAGER / RESERVIERUNG
' ============================================================

class Ersatzteil {
  - artikelnummer : String
  - bezeichnung : String
  - einkaufspreis : double
  - verkaufspreis : double
}

class Lagerbestand {
  - menge : int
  - meldebestand : int
  + pruefeVerfuegbarkeit(anzahl : int) : boolean
  + bucheZugang(anzahl : int) : void
  + bucheAbgang(anzahl : int) : void
  + istMeldebestandUnterschritten() : boolean
}

class ErsatzteilReservierung {
  - reservierungsnummer : String
  - menge : int
  - datum : Date
  - status : ReservierungStatus
  + reserviere() : void
  + storniere() : void
  + entnehmen() : void
}

class Lieferantenbestellung {
  - bestellnummer : String
  - bestelldatum : Date
  - status : BestellStatus
  + bucheWareneingang() : void
  + berechneBestellwert() : double
}

class Bestellposition {
  - menge : int
  - einzelpreis : double
  + positionswert() : double
}

' ============================================================
' RECHNUNG / REKLAMATION
' ============================================================

class Rechnung {
  - rechnungsnummer : String
  - rechnungsdatum : Date
  - bruttobetrag : double
  - zahlungStatus : ZahlungStatus
  + berechneBetrag() : double
  + erfasseZahlung() : void
}

class Reklamation {
  - reklamationsnummer : String
  - datum : Date
  - grund : String
  - istGewaehrleistung : boolean
  + pruefeGewaehrleistung() : boolean
  + schliesseAb() : void
}

' ============================================================
' VERERBUNG
' ============================================================

Person <|-- Kunde
Person <|-- Techniker

' ============================================================
' BEZIEHUNGEN
' ============================================================

