      <bpmn:outgoing>Flow_06_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="T06_Retoure" name="10 Retoure abwickeln">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_10" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_23</bpmn:incoming>
      <bpmn:outgoing>Flow_06_24</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="T06_Zuordnen" name="Teile dem Reparaturauftrag zuordnen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t06_zuordnen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_22</bpmn:incoming>
      <bpmn:outgoing>Flow_06_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_06c" name="">
      <bpmn:incoming>Flow_06_24</bpmn:incoming>
      <bpmn:incoming>Flow_06_25</bpmn:incoming>
      <bpmn:outgoing>Flow_06_26</bpmn:outgoing>
