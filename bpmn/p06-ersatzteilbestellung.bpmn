    <bpmn:sequenceFlow id="Flow_06_3" sourceRef="Start_06" targetRef="T06_Buendeln" />
    <bpmn:sequenceFlow id="Flow_06_4" sourceRef="T06_Buendeln" targetRef="Merge_06" />
    <bpmn:sequenceFlow id="Flow_06_5" sourceRef="Merge_06" targetRef="T06_Lieferant" />
    <bpmn:sequenceFlow id="Flow_06_6" sourceRef="T06_Lieferant" targetRef="T06_Bestellung" />
    <bpmn:sequenceFlow id="Flow_06_7" sourceRef="T06_Bestellung" targetRef="GW06_Grenze" />
    <bpmn:sequenceFlow id="Flow_06_8" sourceRef="GW06_Grenze" targetRef="T06_Freigabe" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bestellwert &gt; freigabegrenze</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_9" sourceRef="GW06_Grenze" targetRef="Join_06a" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bestellwert &lt;= freigabegrenze</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_10" sourceRef="T06_Freigabe" targetRef="Join_06a" />
    <bpmn:sequenceFlow id="Flow_06_11" sourceRef="Join_06a" targetRef="T06_Senden" />
    <bpmn:sequenceFlow id="Flow_06_12" sourceRef="T06_Senden" targetRef="GW06_AB" />
    <bpmn:sequenceFlow id="Flow_06_13" sourceRef="GW06_AB" targetRef="E06_AB" />
    <bpmn:sequenceFlow id="Flow_06_14" sourceRef="GW06_AB" targetRef="E06_ABTimer" />
    <bpmn:sequenceFlow id="Flow_06_15" sourceRef="E06_AB" targetRef="GW06_Lieferbar" />
    <bpmn:sequenceFlow id="Flow_06_16" sourceRef="E06_ABTimer" targetRef="Merge_06s" />
    <bpmn:sequenceFlow id="Flow_06_17" sourceRef="GW06_Lieferbar" targetRef="T06_Termin" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bestaetigt and lieferbar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_18" sourceRef="GW06_Lieferbar" targetRef="Merge_06s" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(bestaetigt and lieferbar)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_19" sourceRef="Merge_06s" targetRef="T06_Storno" />
    <bpmn:sequenceFlow id="Flow_06_20" sourceRef="T06_Storno" targetRef="T06_Alternative" />
    <bpmn:sequenceFlow id="Flow_06_21" sourceRef="T06_Alternative" targetRef="GW06_Alt" />
    <bpmn:sequenceFlow id="Flow_06_22" sourceRef="GW06_Alt" targetRef="Merge_06" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=alternativeVerfuegbar</bpmn:conditionExpression>
