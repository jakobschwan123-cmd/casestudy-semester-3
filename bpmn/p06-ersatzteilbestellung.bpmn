        <bpmn:targetRef>DataObjRef_06_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW06_Grenze" name="Über Freigabegrenze?">
      <bpmn:incoming>Flow_06_5</bpmn:incoming>
      <bpmn:outgoing>Flow_06_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_06_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T06_Freigabe" name="Bestellung freigeben">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t06_freigabe" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_6</bpmn:incoming>
      <bpmn:outgoing>Flow_06_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join_06a" name="">
      <bpmn:incoming>Flow_06_7</bpmn:incoming>
      <bpmn:incoming>Flow_06_8</bpmn:incoming>
      <bpmn:outgoing>Flow_06_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T06_Senden" name="Bestellung an Lieferanten senden">
