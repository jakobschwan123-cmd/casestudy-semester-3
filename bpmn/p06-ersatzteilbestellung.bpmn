        <bpmn:flowNodeRef>GW06_Verzoegert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_06b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Lieferung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Wareneingang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW06_Mangelfrei</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Retoure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Zuordnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_06c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_06_3" name="Service / Annahme">
        <bpmn:flowNodeRef>T06_KundeInfo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_06" name="Fehlteile gemeldet">
      <bpmn:outgoing>Flow_06_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T06_Buendeln" name="Fehlteile zu Bestellbedarf bündeln">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t06_buendeln" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_1</bpmn:incoming>
      <bpmn:outgoing>Flow_06_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_06" name="">
      <bpmn:incoming>Flow_06_2</bpmn:incoming>
      <bpmn:incoming>Flow_06_14</bpmn:incoming>
      <bpmn:outgoing>Flow_06_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T06_Lieferant" name="Lieferanten auswählen">
