        <bpmn:sourceRef>DataObjRef_06_1</bpmn:sourceRef>
        <bpmn:targetRef>T06_Lieferant_prop_DataObjRef_06_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="T06_Bestellung" name="Bestellung beim Lieferanten anlegen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t06_bestellung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_4</bpmn:incoming>
      <bpmn:outgoing>Flow_06_5</bpmn:outgoing>
