        <zeebe:formDefinition formId="form-t06_alternative" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_13</bpmn:incoming>
      <bpmn:outgoing>Flow_06_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T06_Termin" name="Liefertermin am Auftrag hinterlegen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t06_termin" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_12</bpmn:incoming>
      <bpmn:outgoing>Flow_06_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T06_Termin_out_DataObjRef_06_3">
        <bpmn:targetRef>DataObjRef_06_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW06_Verzoegert" name="Reparatur verzögert?">
      <bpmn:incoming>Flow_06_15</bpmn:incoming>
      <bpmn:outgoing>Flow_06_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_06_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T06_KundeInfo" name="Kunde über Verzögerung informieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t06_kundeinfo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06_16</bpmn:incoming>
      <bpmn:outgoing>Flow_06_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Join_06b" name="">
      <bpmn:incoming>Flow_06_17</bpmn:incoming>
      <bpmn:incoming>Flow_06_18</bpmn:incoming>
      <bpmn:outgoing>Flow_06_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="T06_Lieferung" name="Lieferung empfangen" messageRef="Msg_06_2">
      <bpmn:incoming>Flow_06_19</bpmn:incoming>
