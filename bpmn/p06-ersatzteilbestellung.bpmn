      <bpmn:incoming>Flow_06_9</bpmn:incoming>
      <bpmn:outgoing>Flow_06_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T06_AB" name="Auftragsbestätigung empfangen" messageRef="Msg_06_1">
      <bpmn:incoming>Flow_06_10</bpmn:incoming>
      <bpmn:outgoing>Flow_06_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="GW06_Lieferbar" name="Bestätigt und lieferbar?">
      <bpmn:incoming>Flow_06_11</bpmn:incoming>
      <bpmn:outgoing>Flow_06_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_06_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T06_Alternative" name="Alternativen Lieferanten suchen">
