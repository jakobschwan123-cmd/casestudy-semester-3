        <bpmn:flowNodeRef>T06_Buendeln</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Lieferant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Bestellung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW06_Grenze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_06a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Senden</bpmn:flowNodeRef>
