    <bpmn:sequenceFlow id="Flow_06_1" sourceRef="Start_06" targetRef="T06_Buendeln" />
    <bpmn:sequenceFlow id="Flow_06_2" sourceRef="T06_Buendeln" targetRef="Merge_06" />
    <bpmn:sequenceFlow id="Flow_06_3" sourceRef="Merge_06" targetRef="T06_Lieferant" />
    <bpmn:sequenceFlow id="Flow_06_4" sourceRef="T06_Lieferant" targetRef="T06_Bestellung" />
    <bpmn:sequenceFlow id="Flow_06_5" sourceRef="T06_Bestellung" targetRef="GW06_Grenze" />
    <bpmn:sequenceFlow id="Flow_06_6" sourceRef="GW06_Grenze" targetRef="T06_Freigabe" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bestellwert &gt; freigabegrenze</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_7" sourceRef="GW06_Grenze" targetRef="Join_06a" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bestellwert &lt;= freigabegrenze</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_8" sourceRef="T06_Freigabe" targetRef="Join_06a" />
    <bpmn:sequenceFlow id="Flow_06_9" sourceRef="Join_06a" targetRef="T06_Senden" />
    <bpmn:sequenceFlow id="Flow_06_10" sourceRef="T06_Senden" targetRef="T06_AB" />
    <bpmn:sequenceFlow id="Flow_06_11" sourceRef="T06_AB" targetRef="GW06_Lieferbar" />
    <bpmn:sequenceFlow id="Flow_06_12" sourceRef="GW06_Lieferbar" targetRef="T06_Termin" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bestaetigt and lieferbar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_13" sourceRef="GW06_Lieferbar" targetRef="T06_Alternative" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(bestaetigt and lieferbar)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_14" sourceRef="T06_Alternative" targetRef="Merge_06" />
    <bpmn:sequenceFlow id="Flow_06_15" sourceRef="T06_Termin" targetRef="GW06_Verzoegert" />
    <bpmn:sequenceFlow id="Flow_06_16" sourceRef="GW06_Verzoegert" targetRef="T06_KundeInfo" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reparaturVerzoegert</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_17" sourceRef="GW06_Verzoegert" targetRef="Join_06b" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(reparaturVerzoegert)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_18" sourceRef="T06_KundeInfo" targetRef="Join_06b" />
    <bpmn:sequenceFlow id="Flow_06_19" sourceRef="Join_06b" targetRef="T06_Lieferung" />
    <bpmn:sequenceFlow id="Flow_06_20" sourceRef="T06_Lieferung" targetRef="T06_Wareneingang" />
    <bpmn:sequenceFlow id="Flow_06_21" sourceRef="T06_Wareneingang" targetRef="GW06_Mangelfrei" />
    <bpmn:sequenceFlow id="Flow_06_22" sourceRef="GW06_Mangelfrei" targetRef="T06_Zuordnen" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lieferungMangelfrei</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_23" sourceRef="GW06_Mangelfrei" targetRef="T06_Retoure" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(lieferungMangelfrei)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06_24" sourceRef="T06_Retoure" targetRef="Join_06c" />
    <bpmn:sequenceFlow id="Flow_06_25" sourceRef="T06_Zuordnen" targetRef="Join_06c" />
    <bpmn:sequenceFlow id="Flow_06_26" sourceRef="Join_06c" targetRef="End_06" />
    <bpmn:dataObjectReference id="DataObjRef_06_1" name="Lieferant" dataObjectRef="DataObj_06_1" />
    <bpmn:dataObject id="DataObj_06_1" />
    <bpmn:dataObjectReference id="DataObjRef_06_2" name="Lieferanten-bestellung [offen]" dataObjectRef="DataObj_06_2" />
    <bpmn:dataObject id="DataObj_06_2" />
    <bpmn:dataObjectReference id="DataObjRef_06_3" name="Reparatur-auftrag [Teile bestellt]" dataObjectRef="DataObj_06_3" />
    <bpmn:dataObject id="DataObj_06_3" />
    <bpmn:dataObjectReference id="DataObjRef_06_4" name="Lagerbestand" dataObjectRef="DataObj_06_4" />
    <bpmn:dataObject id="DataObj_06_4" />
    <bpmn:dataStoreReference id="DataStore_06_1" name="RepairFlow-Datenbank" />
  </bpmn:process>
