<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_03" targetNamespace="http://repairflow.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_03">
    <bpmn:documentation>Der Techniker prueft den KI-Diagnosevorschlag, fuehrt Funktionstest und Messung durch (bei Bedarf eine erweiterte Pruefung), dokumentiert den Fehlerbefund und legt den Ersatzteilbedarf fest. RepairFlow bewertet die Wirtschaftlichkeit der Reparatur; ist sie nicht gegeben (Totalschaden, Fehler nicht reproduzierbar), wird der Auftrag abgelehnt und ueber Prozess 08 mit Diagnosepauschale zur Abholung gebracht.</bpmn:documentation>
    <bpmn:participant id="Part_03_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_03" />
    <bpmn:participant id="Part_03_Kunde" name="Kunde" processRef="Proc_03_Kunde" />
    <bpmn:messageFlow id="MsgFlow_03_1" name="Reparaturabsage (Totalschaden / kein Befund)" sourceRef="T03_Absage" targetRef="K03_Start" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_03" name="03 Fehlerdiagnose" isExecutable="true">
    <bpmn:laneSet id="LaneSet_03">
      <bpmn:lane id="Lane_03_1" name="Service / Annahme">
        <bpmn:flowNodeRef>T03_Absage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Schliessen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Abholung</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_03_2" name="Techniker">
        <bpmn:flowNodeRef>Start_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_KI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW03_Repro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Erweitert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_03r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Befund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Teile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Wirtschaft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW03_Wirtschaft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Aufwand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03_Abschluss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_03" name="Auftrag eingeplant">
      <bpmn:outgoing>Flow_03_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T03_Status" name="Auftragsstatus auf &#39;in Diagnose&#39; setzen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t03_status" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_3</bpmn:incoming>
      <bpmn:outgoing>Flow_03_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T03_Status_out_DataObjRef_03_1">
        <bpmn:targetRef>DataObjRef_03_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T03_Status_out_DataStore_03_1">
        <bpmn:targetRef>DataStore_03_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="T03_KI" name="KI-Diagnosevorschlag sichten">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t03_ki" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_4</bpmn:incoming>
      <bpmn:outgoing>Flow_03_5</bpmn:outgoing>
      <bpmn:property id="T03_KI_prop_DataObjRef_03_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T03_KI_in_DataObjRef_03_2">
        <bpmn:sourceRef>DataObjRef_03_2</bpmn:sourceRef>
        <bpmn:targetRef>T03_KI_prop_DataObjRef_03_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="T03_Test" name="Funktionstest durchführen und Messwerte erfassen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t03_test" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_5</bpmn:incoming>
      <bpmn:outgoing>Flow_03_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW03_Repro" name="Fehler reproduzierbar?">
      <bpmn:incoming>Flow_03_6</bpmn:incoming>
      <bpmn:outgoing>Flow_03_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_03_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T03_Erweitert" name="Erweiterte Prüfung durchführen">
      <bpmn:incoming>Flow_03_8</bpmn:incoming>
      <bpmn:outgoing>Flow_03_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Join_03r" name="">
      <bpmn:incoming>Flow_03_7</bpmn:incoming>
      <bpmn:incoming>Flow_03_9</bpmn:incoming>
      <bpmn:outgoing>Flow_03_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T03_Befund" name="Fehlerbefund dokumentieren">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t03_befund" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_10</bpmn:incoming>
      <bpmn:outgoing>Flow_03_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T03_Befund_out_DataObjRef_03_3">
        <bpmn:targetRef>DataObjRef_03_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="T03_Teile" name="Ersatzteilbedarf festlegen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t03_teile" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_11</bpmn:incoming>
      <bpmn:outgoing>Flow_03_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="T03_Wirtschaft" name="Wirtschaftlichkeit der Reparatur prüfen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.wirtschaftlichkeit" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_12</bpmn:incoming>
      <bpmn:outgoing>Flow_03_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW03_Wirtschaft" name="Reparatur wirtschaftlich?">
      <bpmn:incoming>Flow_03_13</bpmn:incoming>
      <bpmn:outgoing>Flow_03_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_03_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T03_Absage" name="Kunde über Reparaturabsage informieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t03_absage" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_15</bpmn:incoming>
      <bpmn:outgoing>Flow_03_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T03_Schliessen" name="Auftragsstatus auf &#39;abgelehnt&#39; setzen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t03_schliessen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_16</bpmn:incoming>
      <bpmn:outgoing>Flow_03_17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T03_Schliessen_out_DataObjRef_03_4">
        <bpmn:targetRef>DataObjRef_03_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="T03_Abholung" name="08 Abholung abwickeln">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proc_08" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_17</bpmn:incoming>
      <bpmn:outgoing>Flow_03_18</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="T03_Aufwand" name="Reparaturaufwand schätzen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t03_aufwand" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_14</bpmn:incoming>
      <bpmn:outgoing>Flow_03_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T03_Abschluss" name="Diagnose abschließen und KVA anstoßen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t03_abschluss" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03_19</bpmn:incoming>
      <bpmn:outgoing>Flow_03_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_03" name="">
      <bpmn:incoming>Flow_03_18</bpmn:incoming>
      <bpmn:incoming>Flow_03_20</bpmn:incoming>
      <bpmn:outgoing>Flow_03_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_03" name="Diagnose abgeschlossen">
      <bpmn:incoming>Flow_03_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03_3" sourceRef="Start_03" targetRef="T03_Status" />
    <bpmn:sequenceFlow id="Flow_03_4" sourceRef="T03_Status" targetRef="T03_KI" />
    <bpmn:sequenceFlow id="Flow_03_5" sourceRef="T03_KI" targetRef="T03_Test" />
    <bpmn:sequenceFlow id="Flow_03_6" sourceRef="T03_Test" targetRef="GW03_Repro" />
    <bpmn:sequenceFlow id="Flow_03_7" name="ja" sourceRef="GW03_Repro" targetRef="Join_03r">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fehlerReproduzierbar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_8" name="nein" sourceRef="GW03_Repro" targetRef="T03_Erweitert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(fehlerReproduzierbar)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_9" sourceRef="T03_Erweitert" targetRef="Join_03r" />
    <bpmn:sequenceFlow id="Flow_03_10" sourceRef="Join_03r" targetRef="T03_Befund" />
    <bpmn:sequenceFlow id="Flow_03_11" sourceRef="T03_Befund" targetRef="T03_Teile" />
    <bpmn:sequenceFlow id="Flow_03_12" sourceRef="T03_Teile" targetRef="T03_Wirtschaft" />
    <bpmn:sequenceFlow id="Flow_03_13" sourceRef="T03_Wirtschaft" targetRef="GW03_Wirtschaft" />
    <bpmn:sequenceFlow id="Flow_03_14" name="ja" sourceRef="GW03_Wirtschaft" targetRef="T03_Aufwand">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reparaturWirtschaftlich</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_15" name="nein" sourceRef="GW03_Wirtschaft" targetRef="T03_Absage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(reparaturWirtschaftlich)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03_16" sourceRef="T03_Absage" targetRef="T03_Schliessen" />
    <bpmn:sequenceFlow id="Flow_03_17" sourceRef="T03_Schliessen" targetRef="T03_Abholung" />
    <bpmn:sequenceFlow id="Flow_03_18" sourceRef="T03_Abholung" targetRef="Join_03" />
    <bpmn:sequenceFlow id="Flow_03_19" sourceRef="T03_Aufwand" targetRef="T03_Abschluss" />
    <bpmn:sequenceFlow id="Flow_03_20" sourceRef="T03_Abschluss" targetRef="Join_03" />
    <bpmn:sequenceFlow id="Flow_03_21" sourceRef="Join_03" targetRef="End_03" />
    <bpmn:dataObjectReference id="DataObjRef_03_1" name="Reparaturauftrag [in Diagnose]" dataObjectRef="DataObj_03_1" />
    <bpmn:dataObject id="DataObj_03_1" />
    <bpmn:dataObjectReference id="DataObjRef_03_2" name="KI-Diagnosevorschlag" dataObjectRef="DataObj_03_2" />
    <bpmn:dataObject id="DataObj_03_2" />
    <bpmn:dataObjectReference id="DataObjRef_03_3" name="Fehlerbefund" dataObjectRef="DataObj_03_3" />
    <bpmn:dataObject id="DataObj_03_3" />
    <bpmn:dataObjectReference id="DataObjRef_03_4" name="Reparaturauftrag [abgelehnt]" dataObjectRef="DataObj_03_4" />
    <bpmn:dataObject id="DataObj_03_4" />
    <bpmn:dataStoreReference id="DataStore_03_1" name="RepairFlow-Datenbank" dataStoreRef="Store_03_1" />
  </bpmn:process>
  <bpmn:process id="Proc_03_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K03_Start" name="Reparaturabsage erhalten">
      <bpmn:outgoing>Flow_03_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K03_Start_def" messageRef="Msg_03_1" />
    </bpmn:startEvent>
    <bpmn:manualTask id="K03_Planen" name="Abholung des Geräts planen">
      <bpmn:incoming>Flow_03_1</bpmn:incoming>
      <bpmn:outgoing>Flow_03_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="K03_End" name="Absage verarbeitet">
      <bpmn:incoming>Flow_03_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03_1" sourceRef="K03_Start" targetRef="K03_Planen" />
    <bpmn:sequenceFlow id="Flow_03_2" sourceRef="K03_Planen" targetRef="K03_End" />
  </bpmn:process>
  <bpmn:dataStore id="Store_03_1" name="RepairFlow-Datenbank" />
  <bpmn:message id="Msg_03_1" name="Reparaturabsage (Totalschaden / kein Befund)">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
