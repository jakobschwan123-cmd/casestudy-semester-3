    <bpmn:exclusiveGateway id="K09_Join" name="">
      <bpmn:incoming>Flow_09_10</bpmn:incoming>
      <bpmn:incoming>Flow_09_11</bpmn:incoming>
      <bpmn:outgoing>Flow_09_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="K09_End" name="Reklamation erledigt">
      <bpmn:incoming>Flow_09_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_09_1" sourceRef="K09_Start" targetRef="K09_Melden" />
    <bpmn:sequenceFlow id="Flow_09_2" sourceRef="K09_Melden" targetRef="K09_Bringen" />
    <bpmn:sequenceFlow id="Flow_09_3" sourceRef="K09_Bringen" targetRef="K09_Merge" />
    <bpmn:sequenceFlow id="Flow_09_4" sourceRef="K09_Merge" targetRef="K09_Warten" />
    <bpmn:sequenceFlow id="Flow_09_5" sourceRef="K09_Warten" targetRef="K09_Angebot" />
    <bpmn:sequenceFlow id="Flow_09_6" sourceRef="K09_Warten" targetRef="K09_Ergebnis" />
    <bpmn:sequenceFlow id="Flow_09_7" sourceRef="K09_Angebot" targetRef="K09_Entscheiden" />
    <bpmn:sequenceFlow id="Flow_09_8" sourceRef="K09_Entscheiden" targetRef="K09_GW" />
    <bpmn:sequenceFlow id="Flow_09_9" sourceRef="K09_GW" targetRef="K09_Merge" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=angebotAngenommen</bpmn:conditionExpression>
