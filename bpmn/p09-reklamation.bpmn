    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_30" sourceRef="GW09_Teil" targetRef="Join_09b" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(lieferantenteilDefekt)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_31" sourceRef="T09_Retoure" targetRef="Join_09b" />
