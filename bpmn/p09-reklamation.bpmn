    <bpmn:sequenceFlow id="Flow_09_18" sourceRef="T09_Bewerten" targetRef="GW09_Gewaehr" />
    <bpmn:sequenceFlow id="Flow_09_19" sourceRef="GW09_Gewaehr" targetRef="T09_Freigeben" name="ja">
