    <bpmn:dataObjectReference id="DataObjRef_09_3" name="Fehlerbefund" dataObjectRef="DataObj_09_3" />
    <bpmn:dataObject id="DataObj_09_3" />
    <bpmn:dataObjectReference id="DataObjRef_09_4" name="Reparatur-auftrag [angenommen]" dataObjectRef="DataObj_09_4" />
    <bpmn:dataObject id="DataObj_09_4" />
    <bpmn:dataStoreReference id="DataStore_09_1" name="RepairFlow-Datenbank" />
  </bpmn:process>
  <bpmn:process id="Proc_09_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K09_Start" name="Mangel festgestellt">
      <bpmn:outgoing>Flow_09_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="K09_Melden" name="Mangel in der App melden">
      <bpmn:incoming>Flow_09_1</bpmn:incoming>
      <bpmn:outgoing>Flow_09_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="K09_Bringen" name="Gerät in die Filiale bringen">
      <bpmn:incoming>Flow_09_2</bpmn:incoming>
      <bpmn:outgoing>Flow_09_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="K09_Merge" name="">
      <bpmn:incoming>Flow_09_3</bpmn:incoming>
      <bpmn:incoming>Flow_09_9</bpmn:incoming>
      <bpmn:outgoing>Flow_09_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="K09_Warten" name="">
