    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_8" sourceRef="GW09_Gewaehr" targetRef="T09_Angebot" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(gewaehrleistung)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_9" sourceRef="T09_Angebot" targetRef="T09_Entscheidung" />
