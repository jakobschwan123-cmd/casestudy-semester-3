    <bpmn:sequenceFlow id="Flow_09_11" sourceRef="GW09_Angebot" targetRef="Join_09a" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=angebotAngenommen</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_12" sourceRef="GW09_Angebot" targetRef="T09_OhneReparatur" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(angebotAngenommen)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_13" sourceRef="T09_Freigeben" targetRef="Join_09a" />
    <bpmn:sequenceFlow id="Flow_09_14" sourceRef="Join_09a" targetRef="T09_Nacharbeit" />
    <bpmn:sequenceFlow id="Flow_09_15" sourceRef="T09_Nacharbeit" targetRef="GW09_Teil" />
    <bpmn:sequenceFlow id="Flow_09_16" sourceRef="GW09_Teil" targetRef="T09_Retoure" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lieferantenteilDefekt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_17" sourceRef="GW09_Teil" targetRef="Join_09b" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(lieferantenteilDefekt)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_18" sourceRef="T09_Retoure" targetRef="Join_09b" />
    <bpmn:sequenceFlow id="Flow_09_19" sourceRef="Join_09b" targetRef="T09_Info" />
    <bpmn:sequenceFlow id="Flow_09_20" sourceRef="T09_Info" targetRef="T09_Abschluss" />
    <bpmn:sequenceFlow id="Flow_09_21" sourceRef="T09_Abschluss" targetRef="Join_09c" />
    <bpmn:sequenceFlow id="Flow_09_22" sourceRef="T09_OhneReparatur" targetRef="Join_09c" />
    <bpmn:sequenceFlow id="Flow_09_23" sourceRef="Join_09c" targetRef="End_09" />
