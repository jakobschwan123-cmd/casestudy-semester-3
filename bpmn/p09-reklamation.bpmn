      <bpmn:incoming>Flow_09_11</bpmn:incoming>
      <bpmn:incoming>Flow_09_13</bpmn:incoming>
      <bpmn:outgoing>Flow_09_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T09_Nacharbeit" name="Nacharbeit durchführen">
