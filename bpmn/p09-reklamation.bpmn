    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_09_13" sourceRef="Start_09" targetRef="T09_Erfassen" />
    <bpmn:sequenceFlow id="Flow_09_14" sourceRef="T09_Erfassen" targetRef="T09_Zuordnen" />
    <bpmn:sequenceFlow id="Flow_09_15" sourceRef="T09_Zuordnen" targetRef="T09_Annehmen" />
    <bpmn:sequenceFlow id="Flow_09_16" sourceRef="T09_Annehmen" targetRef="T09_Pruefen" />
