    <bpmn:sequenceFlow id="Flow_09_10" sourceRef="K09_GW" targetRef="K09_Join" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(angebotAngenommen)</bpmn:conditionExpression>
