      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW09_Gewaehr" name="Gewährleistung?">
      <bpmn:incoming>Flow_09_6</bpmn:incoming>
      <bpmn:outgoing>Flow_09_7</bpmn:outgoing>
