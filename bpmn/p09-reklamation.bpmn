      <bpmn:incoming>Flow_09_7</bpmn:incoming>
      <bpmn:outgoing>Flow_09_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="K09_GW" name="Angebot angenommen?">
      <bpmn:incoming>Flow_09_8</bpmn:incoming>
      <bpmn:outgoing>Flow_09_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="K09_Ergebnis" name="Ergebnis erhalten">
