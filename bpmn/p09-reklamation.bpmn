<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_09" targetNamespace="http://repairflow.example/bpmn" exporter="RepairFlow BPMN Generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_09">
    <bpmn:documentation>Meldet der Kunde nach der Abholung einen Mangel, wird die Reklamation dem Ursprungsauftrag zugeordnet, der Mangel geprueft und der Gewaehrleistungsfall bewertet. Je nach Ergebnis folgt kostenfreie Nacharbeit oder ein kostenpflichtiges Angebot; in beiden Faellen wird die Nacharbeit als neuer Reparaturauftrag angelegt.</bpmn:documentation>
    <bpmn:participant id="Part_09_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_09" />
    <bpmn:participant id="Part_09_Kunde" name="Kunde" processRef="Proc_09_Kunde" />
    <bpmn:messageFlow id="MsgFlow_09_1" name="Mangelmeldung" sourceRef="K09_Melden" targetRef="Start_09" />
    <bpmn:messageFlow id="MsgFlow_09_2" name="Angebot" sourceRef="T09_Angebot" targetRef="K09_Angebot" />
    <bpmn:messageFlow id="MsgFlow_09_3" name="Annahme / Ablehnung" sourceRef="K09_Entscheiden" targetRef="T09_Entscheidung" />
    <bpmn:messageFlow id="MsgFlow_09_4" name="Ergebnis" sourceRef="T09_Info" targetRef="K09_Ergebnis" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_09" name="09 Reklamation und Gewährleistung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_09">
      <bpmn:lane id="Lane_09_1" name="Techniker">
        <bpmn:flowNodeRef>T09_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Bewerten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Gewaehr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_09a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Auftrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Nacharbeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Teil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Retoure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_09b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_09_2" name="Service / Annahme">
        <bpmn:flowNodeRef>Start_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Zuordnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Annehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Angebot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Entscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW09_Angebot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_OhneReparatur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09_Abschluss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_09c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_09_3" name="Werkstattleitung">
        <bpmn:flowNodeRef>T09_Freigeben</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_09" name="Mangel gemeldet">
