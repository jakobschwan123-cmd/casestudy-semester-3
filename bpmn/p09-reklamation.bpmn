    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_24" sourceRef="GW09_Angebot" targetRef="T09_OhneReparatur" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(angebotAngenommen)</bpmn:conditionExpression>
