    <bpmn:sequenceFlow id="Flow_09_11" sourceRef="K09_Ergebnis" targetRef="K09_Join" />
    <bpmn:sequenceFlow id="Flow_09_12" sourceRef="K09_Join" targetRef="K09_End" />
  </bpmn:process>
  <bpmn:message id="Msg_09_1" name="Reklamation">
    <bpmn:extensionElements>
