    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_09_2" name="Angebotsentscheidung">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_09_3" name="Angebot">
    <bpmn:extensionElements>
