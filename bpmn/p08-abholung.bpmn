      <bpmn:messageEventDefinition id="K08_Geraet_def" messageRef="Msg_08_5" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="K08_GW2" name="Rechnung offen?">
      <bpmn:incoming>Flow_08_12</bpmn:incoming>
      <bpmn:outgoing>Flow_08_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="K08_Ueberweisen" name="Rechnungsbetrag überweisen">
      <bpmn:incoming>Flow_08_13</bpmn:incoming>
      <bpmn:outgoing>Flow_08_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="K08_Join2" name="">
      <bpmn:incoming>Flow_08_14</bpmn:incoming>
      <bpmn:incoming>Flow_08_15</bpmn:incoming>
      <bpmn:outgoing>Flow_08_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="K08_Bewertung" name="Bewertungsanfrage erhalten">
      <bpmn:incoming>Flow_08_16</bpmn:incoming>
      <bpmn:outgoing>Flow_08_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K08_Bewertung_def" messageRef="Msg_08_6" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="K08_End" name="Gerät abgeholt">
      <bpmn:incoming>Flow_08_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_08_1" sourceRef="K08_Start" targetRef="K08_Weg" />
    <bpmn:sequenceFlow id="Flow_08_2" sourceRef="K08_Weg" targetRef="K08_Abholen" />
    <bpmn:sequenceFlow id="Flow_08_3" sourceRef="K08_Abholen" targetRef="K08_GW1" />
    <bpmn:sequenceFlow id="Flow_08_4" sourceRef="K08_GW1" targetRef="K08_Art" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungFaellig</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_5" sourceRef="K08_GW1" targetRef="K08_Join1" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(zahlungFaellig)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_6" sourceRef="K08_Art" targetRef="K08_GW" />
    <bpmn:sequenceFlow id="Flow_08_7" sourceRef="K08_GW" targetRef="K08_Bar" name="bar / Karte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart in ["bar", "karte"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_8" sourceRef="K08_GW" targetRef="K08_Rechnung" name="auf Rechnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart = "rechnung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_9" sourceRef="K08_Bar" targetRef="K08_Join1" />
    <bpmn:sequenceFlow id="Flow_08_10" sourceRef="K08_Rechnung" targetRef="K08_Join1" />
    <bpmn:sequenceFlow id="Flow_08_11" sourceRef="K08_Join1" targetRef="K08_Geraet" />
    <bpmn:sequenceFlow id="Flow_08_12" sourceRef="K08_Geraet" targetRef="K08_GW2" />
    <bpmn:sequenceFlow id="Flow_08_13" sourceRef="K08_GW2" targetRef="K08_Ueberweisen" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rechnungOffen</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_14" sourceRef="K08_GW2" targetRef="K08_Join2" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(rechnungOffen)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_15" sourceRef="K08_Ueberweisen" targetRef="K08_Join2" />
    <bpmn:sequenceFlow id="Flow_08_16" sourceRef="K08_Join2" targetRef="K08_Bewertung" />
    <bpmn:sequenceFlow id="Flow_08_17" sourceRef="K08_Bewertung" targetRef="K08_End" />
  </bpmn:process>
