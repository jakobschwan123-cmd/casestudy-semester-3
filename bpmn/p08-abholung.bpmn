      <bpmn:outgoing>Flow_08_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="K08_Abholen" name="Abholung in der Filiale anmelden">
      <bpmn:incoming>Flow_08_2</bpmn:incoming>
      <bpmn:outgoing>Flow_08_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="K08_GW1" name="Zahlung fällig?">
      <bpmn:incoming>Flow_08_3</bpmn:incoming>
      <bpmn:outgoing>Flow_08_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="K08_Art" name="Zahlungsart mitteilen">
      <bpmn:incoming>Flow_08_4</bpmn:incoming>
      <bpmn:outgoing>Flow_08_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="K08_GW" name="Zahlungsart?">
      <bpmn:incoming>Flow_08_6</bpmn:incoming>
      <bpmn:outgoing>Flow_08_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="K08_Bar" name="Bar oder mit Karte bezahlen">
