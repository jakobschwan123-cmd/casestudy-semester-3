<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_08" targetNamespace="http://repairflow.example/bpmn" exporter="RepairFlow BPMN Generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_08">
    <bpmn:documentation>RepairFlow erstellt die Rechnung aus KVA und Arbeitszeiten und benachrichtigt den Kunden. Bei der Abholung werden Geraet und Rechnung uebergeben und die Zahlung erfasst (bar/Karte sofort, auf Rechnung nach Zahlungseingang); danach wird der Auftrag geschlossen.</bpmn:documentation>
    <bpmn:participant id="Part_08_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_08" />
    <bpmn:participant id="Part_08_Kunde" name="Kunde" processRef="Proc_08_Kunde" />
    <bpmn:messageFlow id="MsgFlow_08_1" name="Abhol-Benachrichtigung (ggf. Erinnerung)" sourceRef="T08_Benachrichtigung" targetRef="K08_Start" />
    <bpmn:messageFlow id="MsgFlow_08_2" name="Abholung" sourceRef="K08_Abholen" targetRef="E08_Kunde" />
    <bpmn:messageFlow id="MsgFlow_08_3" name="Rechnung" sourceRef="T08_Versand" targetRef="K08_Rechnung" />
    <bpmn:messageFlow id="MsgFlow_08_4" name="Zahlung" sourceRef="K08_Ueberweisen" targetRef="T08_Zahlung" />
    <bpmn:messageFlow id="MsgFlow_08_5" name="Bitte um Bewertung" sourceRef="T08_Bewertung" targetRef="K08_Bewertung" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_08" name="08 Abholung, Rechnung und Zahlung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_08">
      <bpmn:lane id="Lane_08_1" name="Service / Annahme">
        <bpmn:flowNodeRef>Start_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Rechnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Benachrichtigung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Warten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Erinnerung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E08_Kunde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Zahlungsart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW08_Zahlungsart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Kassieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Versand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Zahlung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Verbuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Schliessen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Bestaende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Bewertung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_08_2" name="Techniker">
        <bpmn:flowNodeRef>T08_Holen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08_Uebergabe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_08" name="Reparatur abgeschlossen">
      <bpmn:outgoing>Flow_08_12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T08_Rechnung" name="Rechnung aus KVA und Arbeitszeiten erstellen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_rechnung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_12</bpmn:incoming>
      <bpmn:outgoing>Flow_08_13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Rechnung_out_DataObjRef_08_1">
        <bpmn:targetRef>DataObjRef_08_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_08" name="">
      <bpmn:incoming>Flow_08_13</bpmn:incoming>
      <bpmn:incoming>Flow_08_19</bpmn:incoming>
      <bpmn:outgoing>Flow_08_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T08_Benachrichtigung" name="Abhol-Benachrichtigung an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_benachrichtigung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_14</bpmn:incoming>
      <bpmn:outgoing>Flow_08_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="GW08_Warten" name="">
      <bpmn:incoming>Flow_08_15</bpmn:incoming>
      <bpmn:outgoing>Flow_08_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_17</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E08_Timer" name="14 Tage nicht abgeholt">
      <bpmn:incoming>Flow_08_17</bpmn:incoming>
      <bpmn:outgoing>Flow_08_18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E08_Timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T08_Erinnerung" name="Erinnerung protokollieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_erinnerung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_18</bpmn:incoming>
      <bpmn:outgoing>Flow_08_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="E08_Kunde" name="Kunde zur Abholung erschienen">
      <bpmn:incoming>Flow_08_16</bpmn:incoming>
      <bpmn:outgoing>Flow_08_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E08_Kunde_def" messageRef="Msg_08_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="T08_Holen" name="Gerät aus dem Lager holen">
      <bpmn:incoming>Flow_08_20</bpmn:incoming>
      <bpmn:outgoing>Flow_08_21</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T08_Uebergabe" name="Reparatur erläutern und Gerät übergeben">
      <bpmn:incoming>Flow_08_21</bpmn:incoming>
      <bpmn:outgoing>Flow_08_22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T08_Zahlungsart" name="Zahlungsart erfassen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t08_zahlungsart" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_22</bpmn:incoming>
      <bpmn:outgoing>Flow_08_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW08_Zahlungsart" name="Zahlungsart?">
      <bpmn:incoming>Flow_08_23</bpmn:incoming>
      <bpmn:outgoing>Flow_08_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T08_Kassieren" name="Zahlung kassieren">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t08_kassieren" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_24</bpmn:incoming>
      <bpmn:outgoing>Flow_08_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T08_Versand" name="Rechnung mit Zahlungsziel versenden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_versand" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_25</bpmn:incoming>
      <bpmn:outgoing>Flow_08_27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T08_Zahlung" name="Zahlungseingang empfangen" messageRef="Msg_08_2">
      <bpmn:incoming>Flow_08_27</bpmn:incoming>
      <bpmn:outgoing>Flow_08_28</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Join_08" name="">
      <bpmn:incoming>Flow_08_26</bpmn:incoming>
      <bpmn:incoming>Flow_08_28</bpmn:incoming>
      <bpmn:outgoing>Flow_08_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T08_Verbuchen" name="Zahlung verbuchen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_verbuchen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_29</bpmn:incoming>
      <bpmn:outgoing>Flow_08_30</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Verbuchen_out_DataObjRef_08_2">
        <bpmn:targetRef>DataObjRef_08_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T08_Verbuchen_out_DataStore_08_1">
        <bpmn:targetRef>DataStore_08_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T08_Schliessen" name="Auftrag auf 'abgeholt' setzen und schließen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_schliessen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_30</bpmn:incoming>
      <bpmn:outgoing>Flow_08_31</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T08_Schliessen_out_DataObjRef_08_3">
        <bpmn:targetRef>DataObjRef_08_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T08_Schliessen_out_DataStore_08_2">
        <bpmn:targetRef>DataStore_08_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T08_Bestaende" name="Reservierungen und Bestände abschließen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_bestaende" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_31</bpmn:incoming>
      <bpmn:outgoing>Flow_08_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T08_Bewertung" name="Bewertungsanfrage an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t08_bewertung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08_32</bpmn:incoming>
      <bpmn:outgoing>Flow_08_33</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_08" name="Auftrag abgeschlossen">
      <bpmn:incoming>Flow_08_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_08_12" sourceRef="Start_08" targetRef="T08_Rechnung" />
    <bpmn:sequenceFlow id="Flow_08_13" sourceRef="T08_Rechnung" targetRef="Merge_08" />
    <bpmn:sequenceFlow id="Flow_08_14" sourceRef="Merge_08" targetRef="T08_Benachrichtigung" />
    <bpmn:sequenceFlow id="Flow_08_15" sourceRef="T08_Benachrichtigung" targetRef="GW08_Warten" />
    <bpmn:sequenceFlow id="Flow_08_16" sourceRef="GW08_Warten" targetRef="E08_Kunde" />
    <bpmn:sequenceFlow id="Flow_08_17" sourceRef="GW08_Warten" targetRef="E08_Timer" />
    <bpmn:sequenceFlow id="Flow_08_18" sourceRef="E08_Timer" targetRef="T08_Erinnerung" />
    <bpmn:sequenceFlow id="Flow_08_19" sourceRef="T08_Erinnerung" targetRef="Merge_08" />
    <bpmn:sequenceFlow id="Flow_08_20" sourceRef="E08_Kunde" targetRef="T08_Holen" />
    <bpmn:sequenceFlow id="Flow_08_21" sourceRef="T08_Holen" targetRef="T08_Uebergabe" />
    <bpmn:sequenceFlow id="Flow_08_22" sourceRef="T08_Uebergabe" targetRef="T08_Zahlungsart" />
    <bpmn:sequenceFlow id="Flow_08_23" sourceRef="T08_Zahlungsart" targetRef="GW08_Zahlungsart" />
    <bpmn:sequenceFlow id="Flow_08_24" sourceRef="GW08_Zahlungsart" targetRef="T08_Kassieren" name="bar / Karte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart in ["bar", "karte"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_25" sourceRef="GW08_Zahlungsart" targetRef="T08_Versand" name="auf Rechnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart = "rechnung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_26" sourceRef="T08_Kassieren" targetRef="Join_08" />
    <bpmn:sequenceFlow id="Flow_08_27" sourceRef="T08_Versand" targetRef="T08_Zahlung" />
    <bpmn:sequenceFlow id="Flow_08_28" sourceRef="T08_Zahlung" targetRef="Join_08" />
    <bpmn:sequenceFlow id="Flow_08_29" sourceRef="Join_08" targetRef="T08_Verbuchen" />
    <bpmn:sequenceFlow id="Flow_08_30" sourceRef="T08_Verbuchen" targetRef="T08_Schliessen" />
    <bpmn:sequenceFlow id="Flow_08_31" sourceRef="T08_Schliessen" targetRef="T08_Bestaende" />
    <bpmn:sequenceFlow id="Flow_08_32" sourceRef="T08_Bestaende" targetRef="T08_Bewertung" />
    <bpmn:sequenceFlow id="Flow_08_33" sourceRef="T08_Bewertung" targetRef="End_08" />
    <bpmn:dataObjectReference id="DataObjRef_08_1" name="Rechnung [offen]" dataObjectRef="DataObj_08_1" />
    <bpmn:dataObject id="DataObj_08_1" />
    <bpmn:dataObjectReference id="DataObjRef_08_2" name="Rechnung [bezahlt]" dataObjectRef="DataObj_08_2" />
    <bpmn:dataObject id="DataObj_08_2" />
    <bpmn:dataObjectReference id="DataObjRef_08_3" name="Reparatur-auftrag [abgeholt]" dataObjectRef="DataObj_08_3" />
    <bpmn:dataObject id="DataObj_08_3" />
    <bpmn:dataStoreReference id="DataStore_08_1" name="Buchhaltung (DATEV-Export)" />
    <bpmn:dataStoreReference id="DataStore_08_2" name="RepairFlow-Datenbank" />
  </bpmn:process>
  <bpmn:process id="Proc_08_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K08_Start" name="Abholbenachrichtigung erhalten">
      <bpmn:outgoing>Flow_08_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K08_Start_def" messageRef="Msg_08_3" />
    </bpmn:startEvent>
    <bpmn:manualTask id="K08_Weg" name="Zur Filiale kommen">
      <bpmn:incoming>Flow_08_1</bpmn:incoming>
      <bpmn:outgoing>Flow_08_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="K08_Abholen" name="Gerät abholen">
      <bpmn:incoming>Flow_08_2</bpmn:incoming>
      <bpmn:outgoing>Flow_08_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="K08_Art" name="Zahlungsart wählen">
      <bpmn:incoming>Flow_08_3</bpmn:incoming>
      <bpmn:outgoing>Flow_08_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="K08_GW" name="Zahlungsart?">
      <bpmn:incoming>Flow_08_4</bpmn:incoming>
      <bpmn:outgoing>Flow_08_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="K08_Bar" name="Bar oder mit Karte bezahlen">
      <bpmn:incoming>Flow_08_6</bpmn:incoming>
      <bpmn:outgoing>Flow_08_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="K08_Rechnung" name="Rechnung erhalten">
      <bpmn:incoming>Flow_08_5</bpmn:incoming>
      <bpmn:outgoing>Flow_08_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K08_Rechnung_def" messageRef="Msg_08_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="K08_Ueberweisen" name="Rechnungsbetrag überweisen">
      <bpmn:incoming>Flow_08_7</bpmn:incoming>
      <bpmn:outgoing>Flow_08_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="K08_Join" name="">
      <bpmn:incoming>Flow_08_8</bpmn:incoming>
      <bpmn:incoming>Flow_08_9</bpmn:incoming>
      <bpmn:outgoing>Flow_08_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="K08_Bewertung" name="Bewertungsanfrage erhalten">
      <bpmn:incoming>Flow_08_10</bpmn:incoming>
      <bpmn:outgoing>Flow_08_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K08_Bewertung_def" messageRef="Msg_08_5" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="K08_End" name="Gerät abgeholt">
      <bpmn:incoming>Flow_08_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_08_1" sourceRef="K08_Start" targetRef="K08_Weg" />
    <bpmn:sequenceFlow id="Flow_08_2" sourceRef="K08_Weg" targetRef="K08_Abholen" />
    <bpmn:sequenceFlow id="Flow_08_3" sourceRef="K08_Abholen" targetRef="K08_Art" />
    <bpmn:sequenceFlow id="Flow_08_4" sourceRef="K08_Art" targetRef="K08_GW" />
    <bpmn:sequenceFlow id="Flow_08_5" sourceRef="K08_GW" targetRef="K08_Rechnung" name="auf Rechnung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart = "rechnung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_6" sourceRef="K08_GW" targetRef="K08_Bar" name="bar / Karte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zahlungsart in ["bar", "karte"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_7" sourceRef="K08_Rechnung" targetRef="K08_Ueberweisen" />
    <bpmn:sequenceFlow id="Flow_08_8" sourceRef="K08_Ueberweisen" targetRef="K08_Join" />
    <bpmn:sequenceFlow id="Flow_08_9" sourceRef="K08_Bar" targetRef="K08_Join" />
    <bpmn:sequenceFlow id="Flow_08_10" sourceRef="K08_Join" targetRef="K08_Bewertung" />
    <bpmn:sequenceFlow id="Flow_08_11" sourceRef="K08_Bewertung" targetRef="K08_End" />
  </bpmn:process>
  <bpmn:message id="Msg_08_1" name="Kunde erschienen">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_08_2" name="Zahlungseingang">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_08_3" name="Abhol-Benachrichtigung (ggf. Erinnerung)">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_08_4" name="Rechnung">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_08_5" name="Bitte um Bewertung">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=vorgangId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_08">
    <bpmndi:BPMNPlane id="Plane_08" bpmnElement="Collab_08">
      <bpmndi:BPMNShape id="Part_08_Werkstatt_di" bpmnElement="Part_08_Werkstatt" isHorizontal="true">
        <dc:Bounds x="120" y="475" width="3655" height="590" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_08_1_di" bpmnElement="Lane_08_1" isHorizontal="true">
        <dc:Bounds x="150" y="475" width="3625" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_08_2_di" bpmnElement="Lane_08_2" isHorizontal="true">
        <dc:Bounds x="150" y="895" width="3625" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_08_Kunde_di" bpmnElement="Part_08_Kunde" isHorizontal="true">
        <dc:Bounds x="120" y="55" width="3655" height="285" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_08_di" bpmnElement="Start_08">
        <dc:Bounds x="227" y="594" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="636" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T08_Rechnung_di" bpmnElement="T08_Rechnung">
        <dc:Bounds x="370" y="572" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_08_di" bpmnElement="Merge_08">
