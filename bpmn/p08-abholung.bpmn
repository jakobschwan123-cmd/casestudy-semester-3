    <bpmn:exclusiveGateway id="K08_Join1" name="">
      <bpmn:incoming>Flow_08_5</bpmn:incoming>
      <bpmn:incoming>Flow_08_9</bpmn:incoming>
      <bpmn:incoming>Flow_08_10</bpmn:incoming>
      <bpmn:outgoing>Flow_08_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="K08_Geraet" name="Gerät erhalten">
