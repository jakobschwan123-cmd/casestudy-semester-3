      <bpmn:outgoing>Flow_07_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T07_Abbruch" name="Auftragsstatus auf 'abgelehnt' setzen">
      <bpmn:extensionElements>
