        <bpmn:flowNodeRef>E07_Entscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E07_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW07_Nachtrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Teile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_07n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Abgelehnt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_07_2" name="Techniker">
        <bpmn:flowNodeRef>Start_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_07e</bpmn:flowNodeRef>
