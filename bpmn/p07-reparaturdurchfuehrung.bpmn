      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07_32</bpmn:incoming>
      <bpmn:outgoing>Flow_07_35</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T07_Abbruch_out_DataObjRef_07_7">
        <bpmn:targetRef>DataObjRef_07_7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:manualTask id="T07_Nacharbeit" name="Nacharbeit durchführen">
