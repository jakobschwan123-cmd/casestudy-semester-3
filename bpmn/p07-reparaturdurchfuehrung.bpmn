      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07_22</bpmn:incoming>
      <bpmn:outgoing>Flow_07_24</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Merge_07n" name="">
      <bpmn:incoming>Flow_07_21</bpmn:incoming>
      <bpmn:incoming>Flow_07_23</bpmn:incoming>
      <bpmn:outgoing>Flow_07_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T07_Abgelehnt" name="Nachtrag auf 'abgelehnt' setzen">
      <bpmn:extensionElements>
