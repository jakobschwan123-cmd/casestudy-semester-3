      <bpmn:outgoing>Flow_07_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="K07_Senden" name="Freigabe oder Ablehnung senden">
      <bpmn:incoming>Flow_07_2</bpmn:incoming>
      <bpmn:outgoing>Flow_07_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="K07_End" name="Nachtrag entschieden">
      <bpmn:incoming>Flow_07_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07_1" sourceRef="K07_Start" targetRef="K07_Pruefen" />
    <bpmn:sequenceFlow id="Flow_07_2" sourceRef="K07_Pruefen" targetRef="K07_Senden" />
    <bpmn:sequenceFlow id="Flow_07_3" sourceRef="K07_Senden" targetRef="K07_End" />
  </bpmn:process>
