    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_07z" name="">
      <bpmn:incoming>Flow_07_34</bpmn:incoming>
      <bpmn:incoming>Flow_07_35</bpmn:incoming>
      <bpmn:outgoing>Flow_07_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_07" name="Reparatur abgeschlossen">
      <bpmn:incoming>Flow_07_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07_4" sourceRef="Start_07" targetRef="T07_Status" />
    <bpmn:sequenceFlow id="Flow_07_5" sourceRef="T07_Status" targetRef="Merge_07e" />
    <bpmn:sequenceFlow id="Flow_07_6" sourceRef="Merge_07e" targetRef="T07_Entnahme" />
    <bpmn:sequenceFlow id="Flow_07_7" sourceRef="T07_Entnahme" targetRef="Merge_07" />
    <bpmn:sequenceFlow id="Flow_07_8" sourceRef="Merge_07" targetRef="T07_Start" />
    <bpmn:sequenceFlow id="Flow_07_9" sourceRef="T07_Start" targetRef="T07_Ausfuehren" />
    <bpmn:sequenceFlow id="Flow_07_10" sourceRef="T07_Ausfuehren" targetRef="T07_Doku" />
    <bpmn:sequenceFlow id="Flow_07_11" sourceRef="T07_Doku" targetRef="GW07_Weitere" />
    <bpmn:sequenceFlow id="Flow_07_12" sourceRef="GW07_Weitere" targetRef="Merge_07" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=weitereSchritte</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_13" sourceRef="GW07_Weitere" targetRef="GW07_Zusatz" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(weitereSchritte)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_14" sourceRef="GW07_Zusatz" targetRef="Join_07" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(zusatzbefund)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_15" sourceRef="GW07_Zusatz" targetRef="T07_Nachtrag" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=zusatzbefund</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_16" sourceRef="T07_Nachtrag" targetRef="T07_NachtragSenden" />
    <bpmn:sequenceFlow id="Flow_07_17" sourceRef="T07_NachtragSenden" targetRef="GW07_Warten" />
    <bpmn:sequenceFlow id="Flow_07_18" sourceRef="GW07_Warten" targetRef="E07_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_07_19" sourceRef="GW07_Warten" targetRef="E07_Timer" />
    <bpmn:sequenceFlow id="Flow_07_20" sourceRef="E07_Entscheidung" targetRef="GW07_Nachtrag" />
    <bpmn:sequenceFlow id="Flow_07_21" sourceRef="E07_Timer" targetRef="Merge_07n" />
    <bpmn:sequenceFlow id="Flow_07_22" sourceRef="GW07_Nachtrag" targetRef="T07_Teile" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nachtragFreigegeben</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_23" sourceRef="GW07_Nachtrag" targetRef="Merge_07n" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(nachtragFreigegeben)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_24" sourceRef="T07_Teile" targetRef="Merge_07e" />
    <bpmn:sequenceFlow id="Flow_07_25" sourceRef="Merge_07n" targetRef="T07_Abgelehnt" />
    <bpmn:sequenceFlow id="Flow_07_26" sourceRef="T07_Abgelehnt" targetRef="Join_07" />
    <bpmn:sequenceFlow id="Flow_07_27" sourceRef="Join_07" targetRef="T07_Endkontrolle" />
    <bpmn:sequenceFlow id="Flow_07_28" sourceRef="T07_Endkontrolle" targetRef="GW07_Qualitaet" />
    <bpmn:sequenceFlow id="Flow_07_29" sourceRef="GW07_Qualitaet" targetRef="T07_Fertig" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=qualitaetOk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_30" sourceRef="GW07_Qualitaet" targetRef="GW07_Grenze" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(qualitaetOk)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_31" sourceRef="GW07_Grenze" targetRef="T07_Nacharbeit" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nacharbeiten &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_32" sourceRef="GW07_Grenze" targetRef="T07_Abbruch" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nacharbeiten &gt;= 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_33" sourceRef="T07_Nacharbeit" targetRef="Join_07" />
    <bpmn:sequenceFlow id="Flow_07_34" sourceRef="T07_Fertig" targetRef="Merge_07z" />
    <bpmn:sequenceFlow id="Flow_07_35" sourceRef="T07_Abbruch" targetRef="Merge_07z" />
    <bpmn:sequenceFlow id="Flow_07_36" sourceRef="Merge_07z" targetRef="End_07" />
    <bpmn:dataObjectReference id="DataObjRef_07_1" name="Reparatur-auftrag [in Reparatur]" dataObjectRef="DataObj_07_1" />
    <bpmn:dataObject id="DataObj_07_1" />
    <bpmn:dataObjectReference id="DataObjRef_07_2" name="Ersatzteil-Reservierung [entnommen]" dataObjectRef="DataObj_07_2" />
    <bpmn:dataObject id="DataObj_07_2" />
    <bpmn:dataObjectReference id="DataObjRef_07_3" name="Arbeitszeit-buchung" dataObjectRef="DataObj_07_3" />
    <bpmn:dataObject id="DataObj_07_3" />
    <bpmn:dataObjectReference id="DataObjRef_07_4" name="Kosten-voranschlag [Entwurf]" dataObjectRef="DataObj_07_4" />
    <bpmn:dataObject id="DataObj_07_4" />
    <bpmn:dataObjectReference id="DataObjRef_07_5" name="Kosten-voranschlag [abgelehnt]" dataObjectRef="DataObj_07_5" />
    <bpmn:dataObject id="DataObj_07_5" />
    <bpmn:dataObjectReference id="DataObjRef_07_6" name="Reparatur-auftrag [fertig]" dataObjectRef="DataObj_07_6" />
    <bpmn:dataObject id="DataObj_07_6" />
    <bpmn:dataObjectReference id="DataObjRef_07_7" name="Reparatur-auftrag [abgelehnt]" dataObjectRef="DataObj_07_7" />
    <bpmn:dataObject id="DataObj_07_7" />
    <bpmn:dataStoreReference id="DataStore_07_1" name="RepairFlow-Datenbank" dataStoreRef="Store_07_1" />
  </bpmn:process>
  <bpmn:process id="Proc_07_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K07_Start" name="Nachtrags-KVA erhalten">
      <bpmn:outgoing>Flow_07_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K07_Start_def" messageRef="Msg_07_2" />
    </bpmn:startEvent>
    <bpmn:userTask id="K07_Pruefen" name="Nachtrag in der App prüfen">
      <bpmn:incoming>Flow_07_1</bpmn:incoming>
      <bpmn:outgoing>Flow_07_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="K07_Senden" name="Freigabe oder Ablehnung senden">
      <bpmn:incoming>Flow_07_2</bpmn:incoming>
      <bpmn:outgoing>Flow_07_3</bpmn:outgoing>
