        <bpmn:flowNodeRef>Merge_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Ausfuehren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Doku</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW07_Weitere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW07_Zusatz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Nachtrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Endkontrolle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW07_Qualitaet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW07_Grenze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Abbruch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Nacharbeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Fertig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_07z</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_07</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
