      <bpmn:outgoing>Flow_07_33</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T07_Fertig" name="Auftragsstatus auf 'fertig' setzen">
      <bpmn:extensionElements>
