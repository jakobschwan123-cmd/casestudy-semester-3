        <zeebe:taskDefinition type="repairflow.t04_abholung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04_27</bpmn:incoming>
      <bpmn:outgoing>Flow_04_28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Join_04" name="">
      <bpmn:incoming>Flow_04_24</bpmn:incoming>
      <bpmn:incoming>Flow_04_28</bpmn:incoming>
      <bpmn:outgoing>Flow_04_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_04" name="KVA-Entscheidung verarbeitet">
      <bpmn:incoming>Flow_04_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04_9" sourceRef="Start_04" targetRef="T04_Positionen" />
    <bpmn:sequenceFlow id="Flow_04_10" sourceRef="T04_Positionen" targetRef="T04_Preise" />
    <bpmn:sequenceFlow id="Flow_04_11" sourceRef="T04_Preise" targetRef="T04_Berechnen" />
    <bpmn:sequenceFlow id="Flow_04_12" sourceRef="T04_Berechnen" targetRef="T04_Pruefen" />
    <bpmn:sequenceFlow id="Flow_04_13" sourceRef="T04_Pruefen" targetRef="T04_Status" />
    <bpmn:sequenceFlow id="Flow_04_14" sourceRef="T04_Status" targetRef="Merge_04" />
    <bpmn:sequenceFlow id="Flow_04_15" sourceRef="Merge_04" targetRef="T04_Senden" />
    <bpmn:sequenceFlow id="Flow_04_16" sourceRef="T04_Senden" targetRef="GW04_Warten" />
    <bpmn:sequenceFlow id="Flow_04_17" sourceRef="GW04_Warten" targetRef="E04_Freigabe" />
    <bpmn:sequenceFlow id="Flow_04_18" sourceRef="GW04_Warten" targetRef="E04_Ablehnung" />
    <bpmn:sequenceFlow id="Flow_04_19" sourceRef="GW04_Warten" targetRef="E04_Timer" />
    <bpmn:sequenceFlow id="Flow_04_20" sourceRef="E04_Timer" targetRef="T04_Erinnerung" />
    <bpmn:sequenceFlow id="Flow_04_21" sourceRef="T04_Erinnerung" targetRef="Merge_04" />
    <bpmn:sequenceFlow id="Flow_04_22" sourceRef="E04_Freigabe" targetRef="T04_Freigegeben" />
    <bpmn:sequenceFlow id="Flow_04_23" sourceRef="T04_Freigegeben" targetRef="T04_Dispo" />
    <bpmn:sequenceFlow id="Flow_04_24" sourceRef="T04_Dispo" targetRef="Join_04" />
    <bpmn:sequenceFlow id="Flow_04_25" sourceRef="E04_Ablehnung" targetRef="T04_Abgelehnt" />
    <bpmn:sequenceFlow id="Flow_04_26" sourceRef="T04_Abgelehnt" targetRef="T04_Pauschale" />
