    <bpmn:sequenceFlow id="Flow_04_28" sourceRef="T04_Abholung" targetRef="Join_04" />
    <bpmn:sequenceFlow id="Flow_04_29" sourceRef="Join_04" targetRef="End_04" />
    <bpmn:dataObjectReference id="DataObjRef_04_1" name="Kva-Position" dataObjectRef="DataObj_04_1" />
    <bpmn:dataObject id="DataObj_04_1" />
