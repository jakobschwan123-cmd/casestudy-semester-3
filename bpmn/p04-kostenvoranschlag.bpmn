    <bpmn:dataObject id="DataObj_04_2" />
    <bpmn:dataObjectReference id="DataObjRef_04_3" name="Reparatur-auftrag [freigegeben]" dataObjectRef="DataObj_04_3" />
    <bpmn:dataObject id="DataObj_04_3" />
    <bpmn:dataStoreReference id="DataStore_04_1" name="RepairFlow-Datenbank" />
  </bpmn:process>
  <bpmn:process id="Proc_04_Kunde" name="Kunde" isExecutable="false">
    <bpmn:startEvent id="K04_Start" name="KVA erhalten">
