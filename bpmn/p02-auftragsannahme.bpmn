<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_02" targetNamespace="http://repairflow.example/bpmn" exporter="RepairFlow BPMN Generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collab_02">
    <bpmn:documentation>Der Kunde bringt das Geraet in die Filiale. Daten aus einer Voranmeldung werden uebernommen, das Geraet registriert, der Reparaturauftrag angelegt und von der Werkstattleitung eingeplant (Kapazitaet, Techniker, Termin).</bpmn:documentation>
    <bpmn:participant id="Part_02_Werkstatt" name="Werkstattbetrieb (Pilotkunde FixWerk GmbH)" processRef="Proc_02" />
    <bpmn:participant id="Part_02_Kunde" name="Kunde" />
    <bpmn:messageFlow id="MsgFlow_02_1" name="Gerät + Auftragswunsch" sourceRef="Part_02_Kunde" targetRef="Start_02" />
    <bpmn:messageFlow id="MsgFlow_02_2" name="Annahmebeleg, Termin" sourceRef="T02_Beleg" targetRef="Part_02_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_02" name="02 Auftragsannahme, Geräteregistrierung und Terminplanung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_02">
      <bpmn:lane id="Lane_02_1" name="Service / Annahme">
        <bpmn:flowNodeRef>Start_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW02_Voranmeldung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Uebernehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Kundendaten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_02a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Geraet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Symptome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Sicht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Auftrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Beleg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Einlagern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_02_2" name="Werkstattleitung">
        <bpmn:flowNodeRef>T02_Auslastung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW02_Kapazitaet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Umleiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Techniker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02_Termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_02b</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_02" name="Kunde erschienen">
      <bpmn:outgoing>Flow_02_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_02_def" messageRef="Msg_02_1" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW02_Voranmeldung" name="Voranmeldung vorhanden?">
      <bpmn:incoming>Flow_02_1</bpmn:incoming>
      <bpmn:outgoing>Flow_02_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T02_Uebernehmen" name="Voranmeldungsdaten übernehmen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_uebernehmen" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_2</bpmn:incoming>
      <bpmn:outgoing>Flow_02_4</bpmn:outgoing>
      <bpmn:property id="T02_Uebernehmen_prop_DataObjRef_02_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T02_Uebernehmen_in_DataObjRef_02_1">
        <bpmn:sourceRef>DataObjRef_02_1</bpmn:sourceRef>
        <bpmn:targetRef>T02_Uebernehmen_prop_DataObjRef_02_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="T02_Kundendaten" name="Kundendaten erfassen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_kundendaten" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_3</bpmn:incoming>
      <bpmn:outgoing>Flow_02_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join_02a" name="">
      <bpmn:incoming>Flow_02_4</bpmn:incoming>
      <bpmn:incoming>Flow_02_5</bpmn:incoming>
      <bpmn:outgoing>Flow_02_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T02_Geraet" name="Gerät registrieren">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_geraet" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_6</bpmn:incoming>
      <bpmn:outgoing>Flow_02_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T02_Geraet_out_DataObjRef_02_2">
        <bpmn:targetRef>DataObjRef_02_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="T02_Symptome" name="Symptome und Zubehör dokumentieren">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_symptome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_7</bpmn:incoming>
      <bpmn:outgoing>Flow_02_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="T02_Sicht" name="Sichtprüfung durchführen">
      <bpmn:incoming>Flow_02_8</bpmn:incoming>
      <bpmn:outgoing>Flow_02_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T02_Auftrag" name="Reparaturauftrag anlegen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_auftrag" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_9</bpmn:incoming>
      <bpmn:outgoing>Flow_02_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T02_Auftrag_out_DataObjRef_02_3">
        <bpmn:targetRef>DataObjRef_02_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T02_Auftrag_out_DataStore_02_1">
        <bpmn:targetRef>DataStore_02_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T02_Auslastung" name="Werkstattauslastung prüfen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_auslastung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_10</bpmn:incoming>
      <bpmn:outgoing>Flow_02_11</bpmn:outgoing>
      <bpmn:property id="T02_Auslastung_prop_DataStore_02_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="T02_Auslastung_in_DataStore_02_2">
        <bpmn:sourceRef>DataStore_02_2</bpmn:sourceRef>
        <bpmn:targetRef>T02_Auslastung_prop_DataStore_02_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW02_Kapazitaet" name="Kapazität in Filiale frei?">
      <bpmn:incoming>Flow_02_11</bpmn:incoming>
      <bpmn:outgoing>Flow_02_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T02_Umleiten" name="Auftrag an andere Filiale umleiten">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_umleiten" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_13</bpmn:incoming>
      <bpmn:outgoing>Flow_02_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T02_Techniker" name="Techniker zuweisen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_techniker" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_12</bpmn:incoming>
      <bpmn:outgoing>Flow_02_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T02_Termin" name="Werkstatttermin festlegen">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-t02_termin" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_14</bpmn:incoming>
      <bpmn:outgoing>Flow_02_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="T02_Termin_out_DataObjRef_02_4">
        <bpmn:targetRef>DataObjRef_02_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="T02_Termin_out_DataStore_02_3">
        <bpmn:targetRef>DataStore_02_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join_02b" name="">
      <bpmn:incoming>Flow_02_15</bpmn:incoming>
      <bpmn:incoming>Flow_02_16</bpmn:incoming>
      <bpmn:outgoing>Flow_02_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T02_Beleg" name="Annahmebeleg und Termin an Kunde senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repairflow.t02_beleg" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02_17</bpmn:incoming>
      <bpmn:outgoing>Flow_02_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="T02_Einlagern" name="Gerät kennzeichnen und einlagern">
      <bpmn:incoming>Flow_02_18</bpmn:incoming>
      <bpmn:outgoing>Flow_02_19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_02" name="Auftrag angenommen">
      <bpmn:incoming>Flow_02_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_02_1" sourceRef="Start_02" targetRef="GW02_Voranmeldung" />
    <bpmn:sequenceFlow id="Flow_02_2" sourceRef="GW02_Voranmeldung" targetRef="T02_Uebernehmen" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=voranmeldungVorhanden</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_3" sourceRef="GW02_Voranmeldung" targetRef="T02_Kundendaten" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(voranmeldungVorhanden)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_4" sourceRef="T02_Uebernehmen" targetRef="Join_02a" />
    <bpmn:sequenceFlow id="Flow_02_5" sourceRef="T02_Kundendaten" targetRef="Join_02a" />
    <bpmn:sequenceFlow id="Flow_02_6" sourceRef="Join_02a" targetRef="T02_Geraet" />
    <bpmn:sequenceFlow id="Flow_02_7" sourceRef="T02_Geraet" targetRef="T02_Symptome" />
    <bpmn:sequenceFlow id="Flow_02_8" sourceRef="T02_Symptome" targetRef="T02_Sicht" />
    <bpmn:sequenceFlow id="Flow_02_9" sourceRef="T02_Sicht" targetRef="T02_Auftrag" />
    <bpmn:sequenceFlow id="Flow_02_10" sourceRef="T02_Auftrag" targetRef="T02_Auslastung" />
    <bpmn:sequenceFlow id="Flow_02_11" sourceRef="T02_Auslastung" targetRef="GW02_Kapazitaet" />
    <bpmn:sequenceFlow id="Flow_02_12" sourceRef="GW02_Kapazitaet" targetRef="T02_Techniker" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kapazitaetFrei</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_13" sourceRef="GW02_Kapazitaet" targetRef="T02_Umleiten" name="nein">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(kapazitaetFrei)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02_14" sourceRef="T02_Techniker" targetRef="T02_Termin" />
    <bpmn:sequenceFlow id="Flow_02_15" sourceRef="T02_Termin" targetRef="Join_02b" />
    <bpmn:sequenceFlow id="Flow_02_16" sourceRef="T02_Umleiten" targetRef="Join_02b" />
    <bpmn:sequenceFlow id="Flow_02_17" sourceRef="Join_02b" targetRef="T02_Beleg" />
    <bpmn:sequenceFlow id="Flow_02_18" sourceRef="T02_Beleg" targetRef="T02_Einlagern" />
    <bpmn:sequenceFlow id="Flow_02_19" sourceRef="T02_Einlagern" targetRef="End_02" />
    <bpmn:dataObjectReference id="DataObjRef_02_1" name="Voranmeldung" dataObjectRef="DataObj_02_1" />
    <bpmn:dataObject id="DataObj_02_1" />
    <bpmn:dataObjectReference id="DataObjRef_02_2" name="Gerät" dataObjectRef="DataObj_02_2" />
    <bpmn:dataObject id="DataObj_02_2" />
    <bpmn:dataObjectReference id="DataObjRef_02_3" name="Reparatur-auftrag [angenommen]" dataObjectRef="DataObj_02_3" />
    <bpmn:dataObject id="DataObj_02_3" />
    <bpmn:dataObjectReference id="DataObjRef_02_4" name="Reparatur-auftrag [eingeplant]" dataObjectRef="DataObj_02_4" />
    <bpmn:dataObject id="DataObj_02_4" />
    <bpmn:dataStoreReference id="DataStore_02_1" name="RepairFlow-Datenbank" />
    <bpmn:dataStoreReference id="DataStore_02_2" name="Technikerplan" />
    <bpmn:dataStoreReference id="DataStore_02_3" name="Technikerplan" />
  </bpmn:process>
